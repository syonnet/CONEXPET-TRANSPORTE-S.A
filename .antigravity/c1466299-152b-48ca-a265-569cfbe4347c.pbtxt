  file_change {
    absolute_path_uri: "file:///style.css"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "@import url(\'https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Inter+Tight:wght@600;700;800;900&display=swap\');\n\n/* ==========================================================================\n   CONEXPET TRANSPORTE - IDENTIDAD VISUAL & ESTILOS GLOBALES\n   Inspirado en Apple.com: Espacios amplios, minimalismo, tipograf\303\255a de impacto\n   ========================================================================== */\n\n:root {\n  --color-bg: #0A0A0A;\n  --color-surface: rgba(255, 255, 255, 0.02);\n  --color-surface-hover: rgba(255, 255, 255, 0.04);\n  --color-border: rgba(255, 255, 255, 0.07);\n  --color-border-hover: rgba(220, 38, 38, 0.4);\n  --color-red: #DC2626;\n  --color-red-light: #EF4444;\n  --color-red-glow: rgba(220, 38, 38, 0.35);\n  --color-gray: #71717A;\n  --color-gray-light: #A1A1AA;\n  --color-white: #FFFFFF;\n  --font-display: \'Inter Tight\', -apple-system, BlinkMacSystemFont, sans-serif;\n  --font-body: \'Inter\', -apple-system, BlinkMacSystemFont, sans-serif;\n  --ease-apple: cubic-bezier(0.16, 1, 0.3, 1);\n}\n\n/* Reset y base */\n*, *::before, *::after {\n  box-sizing: border-box;\n  margin: 0;\n  padding: 0;\n}\n\nhtml {\n  scroll-behavior: smooth;\n  background-color: var(--color-bg);\n  color: var(--color-white);\n  font-family: var(--font-body);\n  font-size: 16px;\n  line-height: 1.6;\n  text-rendering: optimizeLegibility;\n  -webkit-font-smoothing: antialiased;\n  -moz-osx-font-smoothing: grayscale;\n}\n\nbody {\n  background-color: var(--color-bg);\n  color: var(--color-white);\n  min-height: 100vh;\n  position: relative;\n  overflow-x: hidden;\n}\n\n/* Selecci\303\263n de texto */\n::selection {\n  background-color: var(--color-red);\n  color: #FFFFFF;\n}\n\n::-moz-selection {\n  background-color: var(--color-red);\n  color: #FFFFFF;\n}\n\n/* Scrollbar Personalizada */\n::-webkit-scrollbar {\n  width: 6px;\n}\n\n::-webkit-scrollbar-track {\n  background: #0A0A0A;\n}\n\n::-webkit-scrollbar-thumb {\n  background: #DC2626;\n  border-radius: 3px;\n}\n\n::-webkit-scrollbar-thumb:hover {\n  background: #EF4444;\n}\n\n/* Tipograf\303\255a de Encabezados */\nh1, h2, h3, h4, h5, h6, .font-display {\n  font-family: var(--font-display);\n  font-feature-settings: \"cv02\", \"cv03\", \"cv04\", \"cv11\";\n}\n\n/* Gradiente rojo din\303\241mico animado */\n.text-gradient-red {\n  background: linear-gradient(90deg, #DC2626 0%, #EF4444 25%, #F87171 50%, #EF4444 75%, #DC2626 100%);\n  background-size: 200% auto;\n  -webkit-background-clip: text;\n  background-clip: text;\n  -webkit-text-fill-color: transparent;\n  animation: redGradientShift 6s linear infinite;\n}\n\n@keyframes redGradientShift {\n  0% { background-position: 0% 50%; }\n  50% { background-position: 100% 50%; }\n  100% { background-position: 0% 50%; }\n}\n\n/* Filtro para logo en modo oscuro */\n.logo-filter {\n  filter: brightness(0) invert(1);\n}\n\n/* ==========================================================================\n   NOISE & GRAIN TEXTURE (Cinematogr\303\241fica 3-4%)\n   ========================================================================== */\n.noise-overlay {\n  position: fixed;\n  inset: 0;\n  width: 100%;\n  height: 100%;\n  pointer-events: none;\n  z-index: 1;\n  opacity: 0.035;\n  background-image: url(\"data:image/svg+xml,%3Csvg viewBox=\'0 0 200 200\' xmlns=\'http://www.w3.org/2000/svg\'%3E%3Cfilter id=\'noiseFilter\'%3E%3CfeTurbulence type=\'fractalNoise\' baseFrequency=\'0.8\' numOctaves=\'3\' stitchTiles=\'stitch\'/%3E%3C/filter%3E%3Crect width=\'100%25\' height=\'100%25\' filter=\'url(%23noiseFilter)\'/%3E%3C/svg%3E\");\n}\n\n/* ==========================================================================\n   FLASH ROJO AL CAMBIAR DE SECCI\303\223N\n   ========================================================================== */\n.section-flash {\n  position: fixed;\n  inset: 0;\n  background-color: #DC2626;\n  opacity: 0;\n  pointer-events: none;\n  z-index: 45;\n  transition: opacity 0.3s ease;\n}\n\n.section-flash.active {\n  opacity: 0.03;\n}\n\n/* ==========================================================================\n   L\303\215NEA DE PROGRESO DE SCROLL (Borde derecho)\n   ========================================================================== */\n.scroll-progress-container {\n  position: fixed;\n  top: 0;\n  right: 0;\n  bottom: 0;\n  width: 2px;\n  background: rgba(255, 255, 255, 0.05);\n  z-index: 60;\n  pointer-events: none;\n}\n\n.scroll-progress-bar {\n  width: 100%;\n  height: 0%;\n  background: #DC2626;\n  box-shadow: 0 0 10px rgba(220, 38, 38, 0.8);\n  transition: height 0.08s linear;\n}\n\n/* ==========================================================================\n   CUSTOM CURSOR (Desktop)\n   ========================================================================== */\n.cursor-dot {\n  position: fixed;\n  top: 0;\n  left: 0;\n  width: 8px;\n  height: 8px;\n  background-color: #DC2626;\n  border-radius: 50%;\n  pointer-events: none;\n  z-index: 9999;\n  transform: translate(-50%, -50%);\n  box-shadow: 0 0 8px rgba(220, 38, 38, 0.7);\n  opacity: 0;\n  transition: opacity 0.3s ease, transform 0.1s ease;\n}\n\n.cursor-ring {\n  position: fixed;\n  top: 0;\n  left: 0;\n  width: 32px;\n  height: 32px;\n  border: 1.5px solid rgba(220, 38, 38, 0.45);\n  border-radius: 50%;\n  pointer-events: none;\n  z-index: 9998;\n  transform: translate(-50%, -50%);\n  opacity: 0;\n  transition: opacity 0.3s ease, width 0.25s var(--ease-apple), height 0.25s var(--ease-apple), border-color 0.25s ease, background-color 0.25s ease;\n}\n\n.cursor-ring.cursor-hover {\n  width: 48px;\n  height: 48px;\n  border-color: rgba(220, 38, 38, 0.9);\n  background-color: rgba(220, 38, 38, 0.08);\n}\n\n@media (pointer: coarse) or (hover: none) {\n  .cursor-dot, .cursor-ring {\n    display: none !important;\n  }\n}\n\n/* ==========================================================================\n   PRELOADER\n   Fondo negro, logo con fade-in, barra de 1px roja, contador 0->100\n   ========================================================================== */\n.preloader {\n  position: fixed;\n  inset: 0;\n  background-color: #0A0A0A;\n  z-index: 99999;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  transition: opacity 0.8s var(--ease-apple), visibility 0.8s var(--ease-apple);\n}\n\n.preloader.fade-out {\n  opacity: 0;\n  visibility: hidden;\n  pointer-events: none;\n}\n\n.preloader-progress-track {\n  width: 240px;\n  height: 1px;\n  background: rgba(255, 255, 255, 0.1);\n  position: relative;\n  overflow: hidden;\n  margin-top: 36px;\n}\n\n.preloader-progress-bar {\n  position: absolute;\n  top: 0;\n  left: 0;\n  height: 100%;\n  width: 0%;\n  background: #DC2626;\n  box-shadow: 0 0 8px rgba(220, 38, 38, 0.8);\n  transition: width 0.05s linear;\n}\n\n.preloader-counter {\n  font-family: var(--font-display);\n  font-size: 0.875rem;\n  letter-spacing: 0.1em;\n  color: var(--color-gray-light);\n  margin-top: 14px;\n}\n\n/* ==========================================================================\n   FIGURAS GEOM\303\211TRICAS DE FONDO (CLAVE)\n   5 formas fixed que se morfean con clip-path al cambiar data-section\n   ========================================================================== */\n.bg-geometric-container {\n  position: fixed;\n  inset: 0;\n  width: 100%;\n  height: 100%;\n  pointer-events: none;\n  z-index: 0;\n  overflow: hidden;\n}\n\n.geo-shape {\n  position: absolute;\n  pointer-events: none;\n  transition: \n    clip-path 1.2s var(--ease-apple),\n    transform 1.2s var(--ease-apple),\n    opacity 1.2s var(--ease-apple),\n    top 1.2s var(--ease-apple),\n    left 1.2s var(--ease-apple),\n    right 1.2s var(--ease-apple),\n    bottom 1.2s var(--ease-apple);\n  will-change: transform, clip-path, opacity;\n}\n\n/* Forma 1: C\303\255rculo top-right */\n.shape-circle-1 {\n  top: -80px;\n  right: -80px;\n  width: 600px;\n  height: 600px;\n  background: radial-gradient(circle, rgba(220, 38, 38, 0.35) 0%, rgba(220, 38, 38, 0) 70%);\n  opacity: 0.08;\n  clip-path: circle(50% at 50% 50%);\n}\n\n/* Forma 2: C\303\255rculo bottom-left */\n.shape-circle-2 {\n  bottom: -100px;\n  left: -100px;\n  width: 500px;\n  height: 500px;\n  background: radial-gradient(circle, rgba(220, 38, 38, 0.35) 0%, rgba(220, 38, 38, 0) 70%);\n  opacity: 0.06;\n  clip-path: circle(50% at 50% 50%);\n}\n\n/* Forma 3: Diamante centro */\n.shape-diamond-1 {\n  top: 40%;\n  left: 45%;\n  width: 400px;\n  height: 400px;\n  background: #DC2626;\n  opacity: 0.04;\n  clip-path: polygon(50% 0%, 100% 50%, 50% 100%, 0% 50%);\n  transform: translate(-50%, -50%) rotate(45deg);\n}\n\n/* Forma 4: Hex\303\241gono top-right area */\n.shape-hex-1 {\n  top: 25%;\n  right: 18%;\n  width: 350px;\n  height: 350px;\n  background: #FFFFFF;\n  opacity: 0.02;\n  clip-path: polygon(25% 0%, 75% 0%, 100% 50%, 75% 100%, 25% 100%, 0% 50%);\n}\n\n/* Forma 5: Tri\303\241ngulo bottom-left area */\n.shape-tri-1 {\n  bottom: 22%;\n  left: 15%;\n  width: 300px;\n  height: 300px;\n  background: #DC2626;\n  opacity: 0.05;\n  clip-path: polygon(50% 0%, 0% 100%, 100% 100%);\n}\n\n/* --- ESTADOS SEG\303\232N DATA-SECTION --- */\n\n/* Secci\303\263n 0: Hero (por defecto) */\n[data-section=\"0\"] .shape-circle-1 {\n  transform: scale(1) rotate(0deg);\n  opacity: 0.08;\n  clip-path: circle(50% at 50% 50%);\n}\n[data-section=\"0\"] .shape-circle-2 {\n  transform: scale(1) rotate(0deg);\n  opacity: 0.06;\n  clip-path: circle(50% at 50% 50%);\n}\n[data-section=\"0\"] .shape-diamond-1 {\n  transform: translate(-50%, -50%) rotate(45deg) scale(1);\n  opacity: 0.04;\n  clip-path: polygon(50% 0%, 100% 50%, 50% 100%, 0% 50%);\n}\n[data-section=\"0\"] .shape-hex-1 {\n  transform: rotate(0deg) scale(1);\n  opacity: 0.02;\n  clip-path: polygon(25% 0%, 75% 0%, 100% 50%, 75% 100%, 25% 100%, 0% 50%);\n}\n[data-section=\"0\"] .shape-tri-1 {\n  transform: rotate(0deg) scale(1);\n  opacity: 0.05;\n  clip-path: polygon(50% 0%, 0% 100%, 100% 100%);\n}\n\n/* Secci\303\263n 1: Nosotros (c\303\255rculo->m\303\241s peque\303\261o, diamante->hex\303\241gono, hex\303\241gono->tri\303\241ngulo, tri\303\241ngulo->c\303\255rculo) */\n[data-section=\"1\"] .shape-circle-1 {\n  transform: scale(0.65) translate(-15%, 25%);\n  opacity: 0.07;\n  clip-path: circle(38% at 50% 50%);\n}\n[data-section=\"1\"] .shape-circle-2 {\n  transform: scale(1.15) rotate(45deg);\n  opacity: 0.05;\n  clip-path: polygon(25% 0%, 75% 0%, 100% 50%, 75% 100%, 25% 100%, 0% 50%);\n}\n[data-section=\"1\"] .shape-diamond-1 {\n  transform: translate(-50%, -50%) rotate(120deg) scale(0.9);\n  opacity: 0.05;\n  clip-path: polygon(25% 0%, 75% 0%, 100% 50%, 75% 100%, 25% 100%, 0% 50%);\n}\n[data-section=\"1\"] .shape-hex-1 {\n  transform: rotate(60deg) scale(1.1);\n  opacity: 0.03;\n  clip-path: polygon(50% 0%, 0% 100%, 100% 100%);\n}\n[data-section=\"1\"] .shape-tri-1 {\n  transform: scale(1.2) rotate(180deg);\n  opacity: 0.06;\n  clip-path: circle(50% at 50% 50%);\n}\n\n/* Secci\303\263n 2: Servicios (rotaciones + escalas, formas intercambiadas con diferentes tama\303\261os) */\n[data-section=\"2\"] .shape-circle-1 {\n  transform: rotate(90deg) scale(1.35) translate(-25%, 15%);\n  opacity: 0.08;\n  clip-path: polygon(50% 0%, 100% 50%, 50% 100%, 0% 50%);\n}\n[data-section=\"2\"] .shape-circle-2 {\n  transform: rotate(-60deg) scale(0.8);\n  opacity: 0.05;\n  clip-path: polygon(50% 0%, 0% 100%, 100% 100%);\n}\n[data-section=\"2\"] .shape-diamond-1 {\n  transform: translate(-40%, -60%) rotate(210deg) scale(1.25);\n  opacity: 0.05;\n  clip-path: circle(48% at 50% 50%);\n}\n[data-section=\"2\"] .shape-hex-1 {\n  transform: rotate(180deg) scale(1.05);\n  opacity: 0.025;\n  clip-path: polygon(25% 0%, 75% 0%, 100% 50%, 75% 100%, 25% 100%, 0% 50%);\n}\n[data-section=\"2\"] .shape-tri-1 {\n  transform: rotate(120deg) scale(1.15);\n  opacity: 0.06;\n  clip-path: polygon(50% 0%, 100% 50%, 50% 100%, 0% 50%);\n}\n\n/* Secci\303\263n 3: Cobertura (todas rotadas 180\302\260+, escalas grandes, opacidades reducidas) */\n[data-section=\"3\"] .shape-circle-1 {\n  transform: rotate(240deg) scale(1.6) translate(-35%, -15%);\n  opacity: 0.045;\n  clip-path: circle(50% at 50% 50%);\n}\n[data-section=\"3\"] .shape-circle-2 {\n  transform: rotate(210deg) scale(1.5) translate(25%, -25%);\n  opacity: 0.04;\n  clip-path: polygon(50% 0%, 100% 50%, 50% 100%, 0% 50%);\n}\n[data-section=\"3\"] .shape-diamond-1 {\n  transform: translate(-50%, -50%) rotate(270deg) scale(1.5);\n  opacity: 0.03;\n  clip-path: polygon(25% 0%, 75% 0%, 100% 50%, 75% 100%, 25% 100%, 0% 50%);\n}\n[data-section=\"3\"] .shape-hex-1 {\n  transform: rotate(200deg) scale(1.4);\n  opacity: 0.015;\n  clip-path: polygon(50% 0%, 0% 100%, 100% 100%);\n}\n[data-section=\"3\"] .shape-tri-1 {\n  transform: rotate(240deg) scale(1.5);\n  opacity: 0.035;\n  clip-path: circle(50% at 50% 50%);\n}\n\n/* Secci\303\263n 4: Flota (escalas peque\303\261as, opacidades muy bajas, casi invisibles) */\n[data-section=\"4\"] .shape-circle-1 {\n  transform: scale(0.35) translate(-60%, 40%);\n  opacity: 0.03;\n  clip-path: circle(40% at 50% 50%);\n}\n[data-section=\"4\"] .shape-circle-2 {\n  transform: scale(0.4) translate(40%, -50%);\n  opacity: 0.02;\n  clip-path: polygon(50% 0%, 100% 50%, 50% 100%, 0% 50%);\n}\n[data-section=\"4\"] .shape-diamond-1 {\n  transform: translate(-50%, -50%) scale(0.35) rotate(90deg);\n  opacity: 0.02;\n  clip-path: polygon(25% 0%, 75% 0%, 100% 50%, 75% 100%, 25% 100%, 0% 50%);\n}\n[data-section=\"4\"] .shape-hex-1 {\n  transform: scale(0.35) rotate(45deg);\n  opacity: 0.01;\n  clip-path: polygon(50% 0%, 0% 100%, 100% 100%);\n}\n[data-section=\"4\"] .shape-tri-1 {\n  transform: scale(0.35);\n  opacity: 0.02;\n  clip-path: circle(40% at 50% 50%);\n}\n\n/* Secci\303\263n 5+: Stats / Contacto / Footer (todas se desvanecen a opacidad ~0.02-0.05) */\n[data-section=\"5\"] .shape-circle-1,\n[data-section=\"6\"] .shape-circle-1 {\n  transform: scale(0.7) translate(-10%, 10%);\n  opacity: 0.03;\n}\n[data-section=\"5\"] .shape-circle-2,\n[data-section=\"6\"] .shape-circle-2 {\n  transform: scale(0.6) translate(10%, -10%);\n  opacity: 0.025;\n}\n[data-section=\"5\"] .shape-diamond-1,\n[data-section=\"6\"] .shape-diamond-1 {\n  transform: translate(-50%, -50%) scale(0.55) rotate(45deg);\n  opacity: 0.02;\n}\n[data-section=\"5\"] .shape-hex-1,\n[data-section=\"6\"] .shape-hex-1 {\n  transform: scale(0.55);\n  opacity: 0.015;\n}\n[data-section=\"5\"] .shape-tri-1,\n[data-section=\"6\"] .shape-tri-1 {\n  transform: scale(0.5);\n  opacity: 0.025;\n}\n\n/* ==========================================================================\n   SCROLL REVEAL & ANIMACIONES\n   ========================================================================== */\n.reveal {\n  opacity: 0;\n  transform: translateY(40px);\n  transition: opacity 0.8s var(--ease-apple), transform 0.8s var(--ease-apple);\n  will-change: opacity, transform;\n}\n\n.reveal.active {\n  opacity: 1;\n  transform: translateY(0);\n}\n\n/* Typewriter blinking cursor */\n.typewriter-cursor {\n  display: inline-block;\n  width: 2px;\n  height: 1.1em;\n  background-color: #DC2626;\n  margin-left: 4px;\n  vertical-align: -2px;\n  animation: blinkCursor 0.8s infinite;\n}\n\n@keyframes blinkCursor {\n  0%, 100% { opacity: 1; }\n  50% { opacity: 0; }\n}\n\n/* Indicador de scroll animado */\n.scroll-indicator-line {\n  width: 1px;\n  height: 48px;\n  background: rgba(255, 255, 255, 0.15);\n  position: relative;\n  overflow: hidden;\n}\n\n.scroll-indicator-pulse {\n  position: absolute;\n  top: -100%;\n  left: 0;\n  width: 100%;\n  height: 50%;\n  background: linear-gradient(180deg, transparent, #DC2626, transparent);\n  animation: scrollPulse 2s cubic-bezier(0.65, 0, 0.35, 1) infinite;\n}\n\n@keyframes scrollPulse {\n  0% { top: -100%; opacity: 0; }\n  50% { opacity: 1; }\n  100% { top: 200%; opacity: 0; }\n}\n\n/* ==========================================================================\n   TARJETAS DE SERVICIOS & MICRO-INTERACCIONES\n   L\303\255nea roja animada que recorre el borde al hover\n   ========================================================================== */\n.service-card {\n  position: relative;\n  background: rgba(255, 255, 255, 0.02);\n  border: 1px solid rgba(255, 255, 255, 0.06);\n  border-radius: 1.25rem;\n  overflow: hidden;\n  transition: transform 0.4s var(--ease-apple), border-color 0.4s ease, background-color 0.4s ease;\n}\n\n.service-card:hover {\n  transform: translateY(-4px);\n  border-color: rgba(220, 38, 38, 0.4);\n  background: rgba(255, 255, 255, 0.035);\n}\n\n/* L\303\255nea roja gradiente superior */\n.service-card::before {\n  content: \'\';\n  position: absolute;\n  top: 0;\n  left: 0;\n  right: 0;\n  height: 1px;\n  background: linear-gradient(90deg, transparent, rgba(220, 38, 38, 0.8), transparent);\n  opacity: 0;\n  transition: opacity 0.4s ease;\n}\n\n.service-card:hover::before {\n  opacity: 1;\n}\n\n/* Micro-interacci\303\263n: Borde l\303\241ser viajero al hover */\n.service-card .border-laser {\n  position: absolute;\n  inset: 0;\n  border-radius: 1.25rem;\n  pointer-events: none;\n  opacity: 0;\n  transition: opacity 0.3s ease;\n}\n\n.service-card:hover .border-laser {\n  opacity: 1;\n}\n\n.service-card .border-laser::before {\n  content: \'\';\n  position: absolute;\n  width: 60px;\n  height: 60px;\n  background: radial-gradient(circle, rgba(220, 38, 38, 0.7) 0%, transparent 70%);\n  top: -30px;\n  left: -30px;\n  animation: laserTravel 4s linear infinite;\n}\n\n@keyframes laserTravel {\n  0% { top: -30px; left: 0%; }\n  25% { top: -30px; left: calc(100% - 30px); }\n  50% { top: calc(100% - 30px); left: calc(100% - 30px); }\n  75% { top: calc(100% - 30px); left: -30px; }\n  100% { top: -30px; left: 0%; }\n}\n\n/* ==========================================================================\n   COBERTURA: ANILLOS CONC\303\211NTRICOS Y RADAR PULSE\n   ========================================================================== */\n.radar-ring {\n  position: absolute;\n  top: 50%;\n  left: 50%;\n  transform: translate(-50%, -50%);\n  border-radius: 50%;\n  pointer-events: none;\n}\n\n.radar-ring-1 {\n  width: 480px;\n  height: 480px;\n  border: 1px solid rgba(220, 38, 38, 0.32);\n}\n\n.radar-ring-2 {\n  width: 320px;\n  height: 320px;\n  border: 1px solid rgba(220, 38, 38, 0.20);\n}\n\n.radar-ring-3 {\n  width: 170px;\n  height: 170px;\n  border: 1px solid rgba(220, 38, 38, 0.10);\n}\n\n.radar-sweep {\n  position: absolute;\n  top: 50%;\n  left: 50%;\n  width: 240px;\n  height: 240px;\n  transform-origin: 0 0;\n  background: conic-gradient(from 0deg, transparent 0deg, rgba(220, 38, 38, 0.15) 60deg, transparent 90deg);\n  animation: sweepRadar 6s linear infinite;\n  pointer-events: none;\n}\n\n@keyframes sweepRadar {\n  0% { transform: rotate(0deg); }\n  100% { transform: rotate(360deg); }\n}\n\n.radar-point {\n  position: absolute;\n  width: 12px;\n  height: 12px;\n  border-radius: 50%;\n  background-color: #DC2626;\n  box-shadow: 0 0 12px #DC2626;\n  cursor: pointer;\n}\n\n.radar-point::after {\n  content: \'\';\n  position: absolute;\n  inset: -6px;\n  border-radius: 50%;\n  border: 1px solid #DC2626;\n  animation: ringPulse 2s cubic-bezier(0.16, 1, 0.3, 1) infinite;\n}\n\n@keyframes ringPulse {\n  0% {\n    transform: scale(0.6);\n    opacity: 1;\n  }\n  100% {\n    transform: scale(2.6);\n    opacity: 0;\n  }\n}\n\n/* ==========================================================================\n   FLOTA: FORMAS GEOM\303\211TRICAS QUE ROTAN 90\302\260 AL HOVER\n   ========================================================================== */\n.fleet-item {\n  position: relative;\n  background: rgba(255, 255, 255, 0.015);\n  border: 1px solid rgba(255, 255, 255, 0.05);\n  border-radius: 1.5rem;\n  padding: 2.5rem;\n  transition: all 0.4s var(--ease-apple);\n}\n\n.fleet-item:hover {\n  background: rgba(255, 255, 255, 0.03);\n  border-color: rgba(220, 38, 38, 0.3);\n  transform: translateY(-2px);\n}\n\n.fleet-shape {\n  width: 110px;\n  height: 110px;\n  transition: transform 0.6s var(--ease-apple), opacity 0.6s ease;\n}\n\n.fleet-item:hover .fleet-shape {\n  transform: rotate(90deg) scale(1.08);\n  opacity: 0.95;\n}\n\n.fleet-shape-circle {\n  border-radius: 50%;\n  background: radial-gradient(circle, rgba(220, 38, 38, 0.25) 0%, rgba(220, 38, 38, 0.05) 70%);\n  border: 1.5px solid rgba(220, 38, 38, 0.4);\n}\n\n.fleet-shape-diamond {\n  background: rgba(220, 38, 38, 0.15);\n  border: 1.5px solid rgba(220, 38, 38, 0.45);\n  transform: rotate(45deg);\n}\n\n.fleet-item:hover .fleet-shape-diamond {\n  transform: rotate(135deg) scale(1.08);\n}\n\n.fleet-shape-hexagon {\n  background: rgba(220, 38, 38, 0.18);\n  border: 1.5px solid rgba(220, 38, 38, 0.45);\n  clip-path: polygon(25% 0%, 75% 0%, 100% 50%, 75% 100%, 25% 100%, 0% 50%);\n}\n\n/* ==========================================================================\n   BOT\303\223N FLOTANTE DE WHATSAPP\n   Aparece tras 3 segundos con scale(0) -> scale(1)\n   ========================================================================== */\n.whatsapp-btn {\n  position: fixed;\n  bottom: 28px;\n  right: 28px;\n  width: 56px;\n  height: 56px;\n  background-color: #25D366;\n  border-radius: 50%;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  color: #FFFFFF;\n  box-shadow: 0 8px 24px rgba(37, 211, 102, 0.35);\n  z-index: 70;\n  transform: scale(0);\n  transition: transform 0.4s var(--ease-apple), box-shadow 0.3s ease;\n  text-decoration: none;\n}\n\n.whatsapp-btn.visible {\n  transform: scale(1);\n}\n\n.whatsapp-btn:hover {\n  transform: scale(1.1);\n  box-shadow: 0 12px 28px rgba(37, 211, 102, 0.5);\n}\n\n/* ==========================================================================\n   MAGNETIC EFFECT (Clase para JS)\n   ========================================================================== */\n.magnetic-btn {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  transition: transform 0.2s var(--ease-apple), background-color 0.25s ease, border-color 0.25s ease;\n  will-change: transform;\n}\n"
    }
