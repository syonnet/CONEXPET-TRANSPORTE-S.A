    instruction: "Replace index.html with the complete, single-page Apple-inspired landing page for CONEXPET TRANSPORTE"
    replacement_infos {
      original_chunk {
        target_content: "<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <title>My Google AI Studio App</title>\n    <meta name=\"description\" content=\"An application built with Google AI Studio.\" />\n    <meta property=\"og:title\" content=\"My Google AI Studio App\" />\n    <meta property=\"og:description\" content=\"An application built with Google AI Studio.\" />\n    <meta property=\"og:type\" content=\"website\" />\n    <meta name=\"twitter:card\" content=\"summary_large_image\" />\n  </head>\n  <body>\n    <div id=\"root\"></div>\n    <script type=\"module\" src=\"/src/main.tsx\"></script>\n  </body>\n</html>"
        replacement_content: "<!doctype html>\n<html lang=\"es\" class=\"scroll-smooth\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <title>CONEXPET | Transportamos el futuro</title>\n    <meta name=\"description\" content=\"CONEXPET TRANSPORTE - Empresa ecuatoriana de log\303\255stica y transporte de carga pesada con cobertura nacional en las 24 provincias del Ecuador. Monitoreo satelital GPS 24/7, transporte de fluidos vacuum hasta 200 bbl, gr\303\272as hasta 120t e infraestructura de talleres propios.\" />\n    <meta name=\"keywords\" content=\"CONEXPET, transporte carga pesada ecuador, logistica ecuador, transporte de fluidos vacuum, gruas izaje ecuador, transporte petrolero ecuador, lago agrio transporte, quito guayaquil carga\" />\n    \n    <!-- Open Graph / Redes Sociales -->\n    <meta property=\"og:title\" content=\"CONEXPET | Transportamos el futuro\" />\n    <meta property=\"og:description\" content=\"Empresa ecuatoriana de log\303\255stica y transporte de carga pesada con cobertura nacional en las 24 provincias del Ecuador.\" />\n    <meta property=\"og:type\" content=\"website\" />\n    <meta property=\"og:url\" content=\"https://conexpet.com\" />\n    <meta property=\"og:image\" content=\"img/logo.png\" />\n    <meta name=\"twitter:card\" content=\"summary_large_image\" />\n    <meta name=\"twitter:title\" content=\"CONEXPET | Transportamos el futuro\" />\n    <meta name=\"twitter:description\" content=\"Log\303\255stica y transporte de carga pesada con cobertura nacional en las 24 provincias del Ecuador.\" />\n    <meta name=\"twitter:image\" content=\"img/logo.png\" />\n\n    <!-- Favicon con el isotipo de la marca -->\n    <link rel=\"icon\" type=\"image/png\" href=\"img/isotipo.png\" />\n\n    <!-- Google Fonts: Inter Tight (Headlines) e Inter (Body) -->\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\" />\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin />\n    <link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Inter+Tight:wght@600;700;800;900&display=swap\" rel=\"stylesheet\" />\n\n    <!-- Tailwind CSS v\303\255a CDN -->\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <script>\n      tailwind.config = {\n        theme: {\n          extend: {\n            colors: {\n              brand: {\n                red: \'#DC2626\',\n                \'red-light\': \'#EF4444\',\n                \'red-dark\': \'#991B1B\',\n                \'red-glow\': \'rgba(220, 38, 38, 0.35)\',\n                bg: \'#0A0A0A\',\n                card: \'rgba(255, 255, 255, 0.02)\',\n                \'card-hover\': \'rgba(255, 255, 255, 0.04)\',\n                border: \'rgba(255, 255, 255, 0.07)\',\n                gray: \'#71717A\',\n                \'gray-light\': \'#A1A1AA\'\n              }\n            },\n            fontFamily: {\n              display: [\'\"Inter Tight\"\', \'-apple-system\', \'BlinkMacSystemFont\', \'sans-serif\'],\n              body: [\'Inter\', \'-apple-system\', \'BlinkMacSystemFont\', \'sans-serif\']\n            }\n          }\n        }\n      };\n    </script>\n\n    <!-- Estilos Personalizados del Sistema de Dise\303\261o -->\n    <link rel=\"stylesheet\" href=\"/style.css\" />\n\n    <!-- Script Principal con L\303\263gica e Interacciones Cinematogr\303\241ficas -->\n    <script defer src=\"/script.js\"></script>\n  </head>\n  <body class=\"bg-[#0A0A0A] text-white selection:bg-[#DC2626] selection:text-white relative font-body antialiased\">\n    \n    <!-- =====================================================================\n         PRELOADER CINEMATOGR\303\201FICO (~2.4s)\n         Fondo negro, logo con fade-in, barra de 1px roja, contador 0->100\n         ===================================================================== -->\n    <div id=\"preloader\" class=\"preloader\" aria-label=\"Cargando experiencia\">\n      <div class=\"flex flex-col items-center justify-center\">\n        <div class=\"h-14 w-auto flex items-center justify-center mb-2 animate-pulse\">\n          <img src=\"img/logo.png\" alt=\"CONEXPET\" class=\"h-10 w-auto object-contain logo-filter\" />\n        </div>\n        <div class=\"preloader-progress-track\">\n          <div id=\"preloader-progress-bar\" class=\"preloader-progress-bar\"></div>\n        </div>\n        <div class=\"preloader-counter\">\n          <span id=\"preloader-counter\">0</span><span class=\"text-red-500 font-bold ml-0.5\">%</span>\n        </div>\n      </div>\n    </div>\n\n    <!-- =====================================================================\n         OVERLAYS Y EFECTOS DE ATM\303\223SFERA\n         ===================================================================== -->\n    <!-- Textura de grano/noise cinematogr\303\241fica 3.5% -->\n    <div class=\"noise-overlay\" aria-hidden=\"true\"></div>\n\n    <!-- Flash rojo sutil al cambiar de secci\303\263n -->\n    <div id=\"section-flash\" class=\"section-flash\" aria-hidden=\"true\"></div>\n\n    <!-- Barra de progreso vertical en el borde derecho -->\n    <div class=\"scroll-progress-container\" aria-hidden=\"true\">\n      <div id=\"scroll-progress-bar\" class=\"scroll-progress-bar\"></div>\n    </div>\n\n    <!-- Custom Cursor en Desktop -->\n    <div class=\"cursor-dot\" aria-hidden=\"true\"></div>\n    <div class=\"cursor-ring\" aria-hidden=\"true\"></div>\n\n    <!-- =====================================================================\n         FIGURAS GEOM\303\211TRICAS DE FONDO (CLAVE)\n         5 formas fijas que se morfean con clip-path al navegar las secciones\n         ===================================================================== -->\n    <div id=\"bg-geometric-container\" class=\"bg-geometric-container\" data-section=\"0\" aria-hidden=\"true\">\n      <!-- 1. C\303\255rculo top-right -->\n      <div class=\"geo-shape shape-circle-1\"></div>\n      <!-- 2. C\303\255rculo bottom-left -->\n      <div class=\"geo-shape shape-circle-2\"></div>\n      <!-- 3. Diamante central -->\n      <div class=\"geo-shape shape-diamond-1\"></div>\n      <!-- 4. Hex\303\241gono top-right -->\n      <div class=\"geo-shape shape-hex-1\"></div>\n      <!-- 5. Tri\303\241ngulo bottom-left -->\n      <div class=\"geo-shape shape-tri-1\"></div>\n    </div>\n\n    <!-- =====================================================================\n         BARRA DE NAVEGACI\303\223N PRINCIPAL\n         Fixed top, transparente al inicio, blur + borde al scroll > 60px\n         ===================================================================== -->\n    <header id=\"main-nav\" class=\"fixed top-0 left-0 w-full z-50 transition-all duration-500 py-6 border-b border-transparent\">\n      <div class=\"max-w-7xl mx-auto px-6 md:px-12 flex items-center justify-between\">\n        \n        <!-- Logo a la izquierda -->\n        <a href=\"#hero\" id=\"nav-logo\" class=\"flex items-center gap-3 group focus:outline-none\" aria-label=\"CONEXPET Inicio\">\n          <img src=\"img/logo.png\" alt=\"CONEXPET TRANSPORTE\" class=\"h-9 md:h-10 w-auto object-contain logo-filter transition-transform duration-300 group-hover:scale-105\" />\n        </a>\n\n        <!-- Enlaces centrales en Desktop -->\n        <nav class=\"hidden md:flex items-center gap-8 text-sm font-medium tracking-wide text-zinc-300\">\n          <a href=\"#nosotros\" class=\"hover:text-white transition-colors duration-200 focus:outline-none\">Nosotros</a>\n          <a href=\"#servicios\" class=\"hover:text-white transition-colors duration-200 focus:outline-none\">Servicios</a>\n          <a href=\"#cobertura\" class=\"hover:text-white transition-colors duration-200 focus:outline-none\">Cobertura</a>\n          <a href=\"#flota\" class=\"hover:text-white transition-colors duration-200 focus:outline-none\">Flota</a>\n          <a href=\"#contacto\" class=\"hover:text-white transition-colors duration-200 focus:outline-none\">Contacto</a>\n        </nav>\n\n        <!-- Bot\303\263n Cotizar a la derecha & Toggle Mobile -->\n        <div class=\"flex items-center gap-4\">\n          <a href=\"#contacto\" id=\"nav-btn-cotizar\" class=\"magnetic-btn hidden sm:inline-flex items-center justify-center px-6 py-2.5 rounded-full bg-[#DC2626] hover:bg-[#EF4444] text-white text-xs md:text-sm font-semibold tracking-wider transition-all duration-300 shadow-lg shadow-red-600/20 hover:shadow-red-600/40\">\n            Cotizar\n          </a>\n\n          <!-- Bot\303\263n Hamburguesa Mobile -->\n          <button id=\"mobile-menu-toggle\" type=\"button\" class=\"md:hidden flex items-center justify-center w-10 h-10 rounded-full border border-white/10 bg-white/5 text-white focus:outline-none\" aria-label=\"Abrir men\303\272\">\n            <svg id=\"hamburger-icon\" class=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n              <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M4 6h16M4 12h16m-7 6h7\"></path>\n            </svg>\n            <svg id=\"close-icon\" class=\"w-5 h-5 hidden\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n              <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M6 18L18 6M6 6l12 12\"></path>\n            </svg>\n          </button>\n        </div>\n      </div>\n    </header>\n\n    <!-- Men\303\272 Mobile Fullscreen con enlaces gigantes -->\n    <div id=\"mobile-menu\" class=\"fixed inset-0 bg-[#0A0A0A] z-40 hidden flex flex-col justify-center px-10 md:hidden\" aria-label=\"Men\303\272 m\303\263vil\">\n      <nav class=\"flex flex-col gap-6 text-center\">\n        <a href=\"#nosotros\" class=\"mobile-nav-link font-display text-3xl font-bold text-zinc-300 hover:text-white hover:text-red-500 transition-colors\">Nosotros</a>\n        <a href=\"#servicios\" class=\"mobile-nav-link font-display text-3xl font-bold text-zinc-300 hover:text-white hover:text-red-500 transition-colors\">Servicios</a>\n        <a href=\"#cobertura\" class=\"mobile-nav-link font-display text-3xl font-bold text-zinc-300 hover:text-white hover:text-red-500 transition-colors\">Cobertura</a>\n        <a href=\"#flota\" class=\"mobile-nav-link font-display text-3xl font-bold text-zinc-300 hover:text-white hover:text-red-500 transition-colors\">Flota</a>\n        <a href=\"#contacto\" class=\"mobile-nav-link font-display text-3xl font-bold text-zinc-300 hover:text-white hover:text-red-500 transition-colors\">Contacto</a>\n        <div class=\"pt-6\">\n          <a href=\"#contacto\" class=\"mobile-nav-link inline-block px-8 py-3.5 rounded-full bg-[#DC2626] text-white text-base font-semibold\">\n            Solicitar Cotizaci\303\263n\n          </a>\n        </div>\n      </nav>\n    </div>\n\n    <main class=\"relative z-10\">\n      <!-- =====================================================================\n           1. HERO SECTION (100vh Centrado, Apple Keynote Style)\n           ===================================================================== -->\n      <section id=\"hero\" class=\"min-h-screen flex flex-col items-center justify-center relative px-6 text-center pt-24 pb-16\">\n        <div class=\"max-w-5xl mx-auto flex flex-col items-center\">\n          \n          <!-- Badge de operaciones 24/7 y Eyebrow Typewriter -->\n          <div class=\"reveal mb-6 flex flex-col sm:flex-row items-center gap-3\">\n            <div class=\"inline-flex items-center gap-2 px-4 py-1.5 rounded-full border border-white/10 bg-white/[0.03] text-xs text-zinc-300 tracking-wide font-medium\">\n              <span class=\"w-2 h-2 rounded-full bg-emerald-500 animate-ping\"></span>\n              <span>Operaciones 24/7 \342\200\224 Lunes a Domingo</span>\n            </div>\n            \n            <div class=\"text-xs sm:text-sm font-semibold text-red-500 uppercase tracking-[0.2em] font-display flex items-center\">\n              <span id=\"hero-typewriter-text\">Confiabilidad en cada kil\303\263metro</span><span class=\"typewriter-cursor\"></span>\n            </div>\n          </div>\n\n          <!-- Headline Gigante -->\n          <h1 class=\"reveal font-display font-extrabold text-[clamp(3.5rem,9.5vw,7.2rem)] leading-[0.95] tracking-[-0.04em] text-white mb-8\">\n            Transportamos<br />\n            <span class=\"text-gradient-red\">el futuro.</span>\n          </h1>\n\n          <!-- Subt\303\255tulo Gris Claro -->\n          <p class=\"reveal text-[#A1A1AA] text-base sm:text-lg md:text-xl font-light max-w-[560px] leading-relaxed mb-10\">\n            L\303\255deres ecuatorianos en log\303\255stica integral, transporte de carga pesada, fluidos vacuum e izaje industrial con cobertura en las 24 provincias.\n          </p>\n\n          <!-- Botones de Acci\303\263n con Efecto Magn\303\251tico -->\n          <div class=\"reveal flex flex-col sm:flex-row items-center gap-4 w-full sm:w-auto\">\n            <a href=\"#contacto\" id=\"hero-btn-primary\" class=\"magnetic-btn w-full sm:w-auto px-8 py-4 rounded-full bg-[#DC2626] hover:bg-[#EF4444] text-white font-semibold text-sm md:text-base tracking-wide transition-all duration-300 shadow-xl shadow-red-600/25\">\n              Solicitar cotizaci\303\263n\n            </a>\n            <a href=\"#servicios\" id=\"hero-btn-secondary\" class=\"magnetic-btn w-full sm:w-auto px-8 py-4 rounded-full border border-white/20 hover:border-white/40 bg-white/[0.02] hover:bg-white/[0.06] text-zinc-200 font-medium text-sm md:text-base transition-all duration-300\">\n              Explorar servicios &rarr;\n            </a>\n          </div>\n\n        </div>\n\n        <!-- Indicador de Scroll Animado -->\n        <div class=\"absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 pointer-events-none opacity-80\">\n          <div class=\"scroll-indicator-line\">\n            <div class=\"scroll-indicator-pulse\"></div>\n          </div>\n          <span class=\"text-[10px] uppercase tracking-[0.25em] text-zinc-400 font-mono\">Scroll</span>\n        </div>\n      </section>\n\n      <!-- =====================================================================\n           2. SECCI\303\223N NOSOTROS (Grid 50/50 + Stats Inline)\n           ===================================================================== -->\n      <section id=\"nosotros\" class=\"py-32 px-6 md:px-12 border-t border-white/[0.06] relative\">\n        <div class=\"max-w-7xl mx-auto\">\n          \n          <div class=\"grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-24 items-start\">\n            <!-- Columna Izquierda: Label & Heading -->\n            <div class=\"reveal\">\n              <span class=\"text-xs uppercase tracking-[0.25em] text-red-500 font-semibold font-display block mb-4\">\n                01 / QUI\303\211NES SOMOS\n              </span>\n              <h2 class=\"font-display font-extrabold text-3xl sm:text-4xl md:text-5xl lg:text-6xl text-white leading-[1.08] tracking-tight\">\n                M\303\241s que transporte, somos puente entre mercados.\n              </h2>\n            </div>\n\n            <!-- Columna Derecha: Historia y Geograf\303\255a Ecuatoriana -->\n            <div class=\"reveal flex flex-col gap-6 text-[#A1A1AA] text-base md:text-lg font-light leading-relaxed\">\n              <p>\n                Nacidos para desafiar la compleja geograf\303\255a ecuatoriana, en <strong class=\"text-white font-medium\">CONEXPET</strong> transformamos la log\303\255stica pesada en una obra de sincron\303\255a y precisi\303\263n. Desde los pasos cordilleranos de los Andes hasta los puertos del Pac\303\255fico y los campamentos energ\303\251ticos de la Amazon\303\255a, movilizamos la maquinaria que edifica el desarrollo nacional.\n              </p>\n              <p>\n                Respaldados por monitoreo satelital GPS en tiempo real, estrictas pol\303\255ticas de seguridad industrial (HSE) y una flota permanentemente calibrada en talleres propios, garantizamos que su carga arribe en los plazos convenidos con total integridad operativa.\n              </p>\n            </div>\n          </div>\n\n          <!-- Tres Stats Inline con Contadores Animados -->\n          <div class=\"mt-20 pt-16 border-t border-white/[0.06] grid grid-cols-1 md:grid-cols-3 gap-10 text-center md:text-left\">\n            \n            <div class=\"reveal flex flex-col gap-1\" data-delay=\"100\">\n              <span class=\"font-display font-extrabold text-4xl sm:text-5xl lg:text-6xl text-white tracking-tight\" data-target=\"15\" data-suffix=\"+\">\n                0\n              </span>\n              <span class=\"text-xs sm:text-sm uppercase tracking-[0.15em] text-zinc-400 font-medium\">\n                A\303\261os de experiencia continua\n              </span>\n            </div>\n\n            <div class=\"reveal flex flex-col gap-1\" data-delay=\"200\">\n              <span class=\"font-display font-extrabold text-4xl sm:text-5xl lg:text-6xl text-white tracking-tight\" data-target=\"500\" data-suffix=\"+\">\n                0\n              </span>\n              <span class=\"text-xs sm:text-sm uppercase tracking-[0.15em] text-zinc-400 font-medium\">\n                Clientes corporativos e industriales\n              </span>\n            </div>\n\n            <div class=\"reveal flex flex-col gap-1\" data-delay=\"300\">\n              <span class=\"font-display font-extrabold text-4xl sm:text-5xl lg:text-6xl text-white tracking-tight\" data-target=\"98\" data-suffix=\"%\">\n                0\n              </span>\n              <span class=\"text-xs sm:text-sm uppercase tracking-[0.15em] text-zinc-400 font-medium\">\n                Entregas efectivas en tiempo pactado\n              </span>\n            </div>\n\n          </div>\n\n        </div>\n      </section>\n\n      <!-- =====================================================================\n           3. SECCI\303\223N SERVICIOS (Grid 2x2, Micro-interacciones & L\303\255neas L\303\241ser)\n           ===================================================================== -->\n      <section id=\"servicios\" class=\"py-32 px-6 md:px-12 relative border-t border-white/[0.06]\">\n        <div class=\"max-w-7xl mx-auto\">\n          \n          <div class=\"text-center max-w-3xl mx-auto mb-20 reveal\">\n            <span class=\"text-xs uppercase tracking-[0.25em] text-red-500 font-semibold font-display block mb-3\">\n              02 / CAPACIDADES OPERATIVAS\n            </span>\n            <h2 class=\"font-display font-extrabold text-3xl sm:text-4xl md:text-5xl text-white tracking-tight mb-4\">\n              Ofrecemos una soluci\303\263n completa\n            </h2>\n            <p class=\"text-zinc-400 text-base md:text-lg font-light\">\n              Ingenier\303\255a de transporte adaptada a las cargas m\303\241s exigentes del sector petrolero, minero, energ\303\251tico y comercial.\n            </p>\n          </div>\n\n          <!-- Grid 2x2 de Tarjetas -->\n          <div class=\"grid grid-cols-1 md:grid-cols-2 gap-8\">\n            \n            <!-- Tarjeta 1: Carga Pesada -->\n            <div class=\"service-card p-8 md:p-10 reveal flex flex-col justify-between\" data-delay=\"100\">\n              <div class=\"border-laser\"></div>\n              <div>\n                <div class=\"flex items-center justify-between mb-8\">\n                  <div class=\"w-14 h-14 rounded-2xl bg-white/[0.03] border border-white/10 flex items-center justify-center text-red-500\">\n                    <!-- Icono SVG Cami\303\263n de Carga -->\n                    <svg class=\"w-7 h-7\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n                      <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.8\" d=\"M9 17a2 2 0 11-4 0 2 2 0 014 0zM19 17a2 2 0 11-4 0 2 2 0 014 0z\"></path>\n                      <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.8\" d=\"M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 01-1 1H9m4-1V8a1 1 0 011-1h2.586a1 1 0 01.707.293l3.414 3.414a1 1 0 01.293.707V16a1 1 0 01-1 1h-1m-6-1a1 1 0 001 1h1M5 17a2 2 0 104 0m-4 0a2 2 0 114 0m6 0a2 2 0 104 0m-4 0a2 2 0 114 0\"></path>\n                    </svg>\n                  </div>\n                  <span class=\"px-3.5 py-1 rounded-full text-xs font-semibold bg-red-600/10 text-red-400 border border-red-500/20 tracking-wider font-mono\">\n                    HASTA 60 TONELADAS\n                  </span>\n                </div>\n                <h3 class=\"font-display font-bold text-2xl text-white mb-3\">\n                  Transporte de Carga Pesada & Extrapesada\n                </h3>\n                <p class=\"text-zinc-400 text-sm md:text-base leading-relaxed mb-6 font-light\">\n                  Especialistas en la movilizaci\303\263n de taladros de perforaci\303\263n (RIGs Workover y Drilling), maquinaria pesada, transformadores, tuber\303\255as y herramientas industriales en cualquier condici\303\263n topogr\303\241fica.\n                </p>\n              </div>\n              <div class=\"pt-6 border-t border-white/[0.06] flex items-center justify-between text-xs text-zinc-400\">\n                <span>Plataformas cama baja y modulares</span>\n                <span class=\"text-red-400 font-medium\">Cobertura total &rarr;</span>\n              </div>\n            </div>\n\n            <!-- Tarjeta 2: Log\303\255stica Integral & Fluidos Vacuum -->\n            <div class=\"service-card p-8 md:p-10 reveal flex flex-col justify-between\" data-delay=\"200\">\n              <div class=\"border-laser\"></div>\n              <div>\n                <div class=\"flex items-center justify-between mb-8\">\n                  <div class=\"w-14 h-14 rounded-2xl bg-white/[0.03] border border-white/10 flex items-center justify-center text-red-500\">\n                    <!-- Icono SVG Paquete con Checkmark / Fluidos -->\n                    <svg class=\"w-7 h-7\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n                      <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.8\" d=\"M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4\"></path>\n                      <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M9 12l2 2 4-4\"></path>\n                    </svg>\n                  </div>\n                  <span class=\"px-3.5 py-1 rounded-full text-xs font-semibold bg-red-600/10 text-red-400 border border-red-500/20 tracking-wider font-mono\">\n                    HASTA 200 BARRILES\n                  </span>\n                </div>\n                <h3 class=\"font-display font-bold text-2xl text-white mb-3\">\n                  Transporte de Fluidos Vacuum & Log\303\255stica\n                </h3>\n                <p class=\"text-zinc-400 text-sm md:text-base leading-relaxed mb-6 font-light\">\n                  Movilizaci\303\263n segura de crudo, aguas residuales y agua dulce mediante unidades tipo vacuum de alta capacidad. Cumplimiento estricto de protocolos ambientales y monitoreo satelital 24/7.\n                </p>\n              </div>\n              <div class=\"pt-6 border-t border-white/[0.06] flex items-center justify-between text-xs text-zinc-400\">\n                <span>Almacenamiento y tanques certificados</span>\n                <span class=\"text-red-400 font-medium\">Norma ambiental &rarr;</span>\n              </div>\n            </div>\n\n            <!-- Tarjeta 3: Consultor\303\255a en Rutas & Izaje -->\n            <div class=\"service-card p-8 md:p-10 reveal flex flex-col justify-between\" data-delay=\"300\">\n              <div class=\"border-laser\"></div>\n              <div>\n                <div class=\"flex items-center justify-between mb-8\">\n                  <div class=\"w-14 h-14 rounded-2xl bg-white/[0.03] border border-white/10 flex items-center justify-center text-red-500\">\n                    <!-- Icono SVG Gr\303\241fico Ascendente & Izaje -->\n                    <svg class=\"w-7 h-7\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n                      <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.8\" d=\"M13 7h8m0 0v8m0-8l-8 8-4-4-6 6\"></path>\n                    </svg>\n                  </div>\n                  <span class=\"px-3.5 py-1 rounded-full text-xs font-semibold bg-red-600/10 text-red-400 border border-red-500/20 tracking-wider font-mono\">\n                    GR\303\232AS HASTA 120 T\n                  </span>\n                </div>\n                <h3 class=\"font-display font-bold text-2xl text-white mb-3\">\n                  Consultor\303\255a de Rutas & Izaje de Precisi\303\263n\n                </h3>\n                <p class=\"text-zinc-400 text-sm md:text-base leading-relaxed mb-6 font-light\">\n                  Gr\303\272as telesc\303\263picas para maniobras cr\303\255ticas de levantamiento de estructuras y montajes industriales. Planificaci\303\263n de corredores viales, permisos especiales y optimizaci\303\263n de costos operativos.\n                </p>\n              </div>\n              <div class=\"pt-6 border-t border-white/[0.06] flex items-center justify-between text-xs text-zinc-400\">\n                <span>Ingenier\303\255a de maniobras seguras</span>\n                <span class=\"text-red-400 font-medium\">Est\303\241ndar HSE &rarr;</span>\n              </div>\n            </div>\n\n            <!-- Tarjeta 4: Cobertura Nacional & Talleres Propios -->\n            <div class=\"service-card p-8 md:p-10 reveal flex flex-col justify-between\" data-delay=\"400\">\n              <div class=\"border-laser\"></div>\n              <div>\n                <div class=\"flex items-center justify-between mb-8\">\n                  <div class=\"w-14 h-14 rounded-2xl bg-white/[0.03] border border-white/10 flex items-center justify-center text-red-500\">\n                    <!-- Icono SVG Target / Rueda de Cobertura -->\n                    <svg class=\"w-7 h-7\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n                      <circle cx=\"12\" cy=\"12\" r=\"10\" stroke-width=\"1.8\"></circle>\n                      <circle cx=\"12\" cy=\"12\" r=\"6\" stroke-width=\"1.8\"></circle>\n                      <circle cx=\"12\" cy=\"12\" r=\"2\" stroke-width=\"1.8\"></circle>\n                    </svg>\n                  </div>\n                  <span class=\"px-3.5 py-1 rounded-full text-xs font-semibold bg-red-600/10 text-red-400 border border-red-500/20 tracking-wider font-mono\">\n                    TALLERES PROPIOS\n                  </span>\n                </div>\n                <h3 class=\"font-display font-bold text-2xl text-white mb-3\">\n                  Cobertura Nacional & Soporte T\303\251cnico Continuo\n                </h3>\n                <p class=\"text-zinc-400 text-sm md:text-base leading-relaxed mb-6 font-light\">\n                  Infraestructura t\303\251cnica de talleres propios para mantenimiento preventivo y correctivo con repuestos certificados. Cero tiempos muertos y m\303\241xima disponibilidad de flota en las 24 provincias.\n                </p>\n              </div>\n              <div class=\"pt-6 border-t border-white/[0.06] flex items-center justify-between text-xs text-zinc-400\">\n                <span>24 provincias conectadas</span>\n                <span class=\"text-red-400 font-medium\">Disponibilidad 24/7 &rarr;</span>\n              </div>\n            </div>\n\n          </div>\n\n        </div>\n      </section>\n\n      <!-- =====================================================================\n           4. SECCI\303\223N COBERTURA (Anillos Conc\303\251ntricos + Rutas Principales)\n           ===================================================================== -->\n      <section id=\"cobertura\" class=\"py-32 px-6 md:px-12 relative border-t border-white/[0.06] overflow-hidden\">\n        <div class=\"max-w-7xl mx-auto\">\n          \n          <div class=\"grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-24 items-center\">\n            \n            <!-- Columna Izquierda: Radar Visual con Anillos Conc\303\251ntricos y Nodos Pulsantes -->\n            <div class=\"reveal relative flex items-center justify-center min-h-[460px] sm:min-h-[520px] w-full\">\n              \n              <!-- Anillos conc\303\251ntricos -->\n              <div class=\"radar-ring radar-ring-1\"></div>\n              <div class=\"radar-ring radar-ring-2\"></div>\n              <div class=\"radar-ring radar-ring-3\"></div>\n\n              <!-- Sweep de radar giratorio -->\n              <div class=\"radar-sweep\"></div>\n\n              <!-- L\303\255neas gu\303\255a del radar -->\n              <div class=\"absolute inset-0 flex items-center justify-center pointer-events-none opacity-20\">\n                <div class=\"w-full h-[1px] bg-red-500\"></div>\n                <div class=\"absolute h-full w-[1px] bg-red-500\"></div>\n              </div>\n\n              <!-- Nodos de Ciudades Pulsantes con Coordenadas Relativas -->\n              <!-- 1. Quito (Sierra Centro-Norte) -->\n              <div class=\"radar-point top-[36%] left-[48%]\" data-city=\"Quito\" data-info=\"Centro de Gesti\303\263n y Comando Sierra Norte (Pichincha)\">\n                <span class=\"absolute left-4 -top-2 text-xs font-semibold text-white whitespace-nowrap drop-shadow\">Quito</span>\n              </div>\n\n              <!-- 2. Guayaquil (Costa / Puerto) -->\n              <div class=\"radar-point top-[62%] left-[34%]\" data-city=\"Guayaquil\" data-info=\"Hub Portuario Principal y Terminal de Contenedores (Guayas)\">\n                <span class=\"absolute left-4 -top-2 text-xs font-semibold text-white whitespace-nowrap drop-shadow\">Guayaquil</span>\n              </div>\n\n              <!-- 3. Cuenca (Sierra Sur) -->\n              <div class=\"radar-point top-[76%] left-[46%]\" data-city=\"Cuenca\" data-info=\"Conexi\303\263n Estrat\303\251gica Sierra Sur e Industria (Azuay)\">\n                <span class=\"absolute left-4 -top-2 text-xs font-semibold text-white whitespace-nowrap drop-shadow\">Cuenca</span>\n              </div>\n\n              <!-- 4. Manta (Costa Centro) -->\n              <div class=\"radar-point top-[48%] left-[24%]\" data-city=\"Manta\" data-info=\"Puerto Mar\303\255timo de Aguas Profundas (Manab\303\255)\">\n                <span class=\"absolute left-4 -top-2 text-xs font-semibold text-white whitespace-nowrap drop-shadow\">Manta</span>\n              </div>\n\n              <!-- 5. Lago Agrio (Amazon\303\255a / Base Operativa Principal) -->\n              <div class=\"radar-point top-[28%] left-[68%]\" data-city=\"Lago Agrio\" data-info=\"Base Operativa Principal & Corredor Petrolero (Sucumb\303\255os)\">\n                <span class=\"absolute left-4 -top-2 text-xs font-semibold text-red-400 font-mono whitespace-nowrap drop-shadow\">Lago Agrio (HQ)</span>\n              </div>\n\n              <!-- Tooltip Interactivo Flotante -->\n              <div id=\"radar-city-tooltip\" class=\"absolute bottom-4 left-1/2 -translate-x-1/2 px-4 py-2 rounded-xl bg-black/80 border border-white/10 text-xs backdrop-blur-md opacity-0 transition-opacity duration-300 pointer-events-none z-20 text-center max-w-[280px]\">\n                Pase el cursor sobre una ciudad\n              </div>\n\n            </div>\n\n            <!-- Columna Derecha: Informaci\303\263n de Rutas -->\n            <div class=\"reveal\">\n              <span class=\"text-xs uppercase tracking-[0.25em] text-red-500 font-semibold font-display block mb-3\">\n                03 / RED LOG\303\215STICA\n              </span>\n              <h2 class=\"font-display font-extrabold text-3xl sm:text-4xl md:text-5xl text-white tracking-tight mb-6\">\n                Cobertura en las 24 provincias del Ecuador\n              </h2>\n              <p class=\"text-zinc-400 text-base md:text-lg font-light leading-relaxed mb-10\">\n                Operamos con trazabilidad satelital en todos los corredores estrat\303\251gicos del pa\303\255s. Nuestra flota enlaza terminales portuarias, parques industriales y pozos de producci\303\263n con eficiencia ininterrumpida.\n              </p>\n\n              <!-- Lista de 4 Rutas Principales con L\303\255nea Roja Vertical -->\n              <div class=\"relative pl-6 border-l-2 border-red-600 flex flex-col gap-6\">\n                \n                <div class=\"group\">\n                  <span class=\"text-xs uppercase tracking-wider text-red-400 font-mono font-semibold block mb-1\">Eje Sierra</span>\n                  <p class=\"text-white font-medium text-base\">Quito &mdash; Ambato &mdash; Riobamba &mdash; Cuenca</p>\n                  <span class=\"text-zinc-400 text-xs font-light\">Movilizaci\303\263n de carga pesada sobre la Troncal de la Sierra.</span>\n                </div>\n\n                <div class=\"group\">\n                  <span class=\"text-xs uppercase tracking-wider text-red-400 font-mono font-semibold block mb-1\">Corredor Costa</span>\n                  <p class=\"text-white font-medium text-base\">Esmeraldas &mdash; Manta &mdash; Portoviejo &mdash; Guayaquil</p>\n                  <span class=\"text-zinc-400 text-xs font-light\">Interconexi\303\263n de terminales mar\303\255timas y zonas francas.</span>\n                </div>\n\n                <div class=\"group\">\n                  <span class=\"text-xs uppercase tracking-wider text-red-400 font-mono font-semibold block mb-1\">Troncal Amaz\303\263nica</span>\n                  <p class=\"text-white font-medium text-base\">Lago Agrio (HQ) &mdash; Baeza &mdash; Tena &mdash; Puyo &mdash; Macas</p>\n                  <span class=\"text-zinc-400 text-xs font-light\">Soporte continuo a plataformas petroleras y plantas de procesamiento.</span>\n                </div>\n\n                <div class=\"group\">\n                  <span class=\"text-xs uppercase tracking-wider text-red-400 font-mono font-semibold block mb-1\">Transversal Costa &mdash; Sierra</span>\n                  <p class=\"text-white font-medium text-base\">Quito &mdash; Santo Domingo &mdash; Esmeraldas</p>\n                  <span class=\"text-zinc-400 text-xs font-light\">Corredor log\303\255stico de alta frecuencia para abastecimiento industrial.</span>\n                </div>\n\n              </div>\n\n            </div>\n\n          </div>\n\n        </div>\n      </section>\n\n      <!-- =====================================================================\n           5. SECCI\303\223N FLOTA (3 Items Verticales, Formas Rotando 90\302\260 al Hover)\n           ===================================================================== -->\n      <section id=\"flota\" class=\"py-32 px-6 md:px-12 relative border-t border-white/[0.06]\">\n        <div class=\"max-w-7xl mx-auto\">\n          \n          <div class=\"text-center max-w-3xl mx-auto mb-20 reveal\">\n            <span class=\"text-xs uppercase tracking-[0.25em] text-red-500 font-semibold font-display block mb-3\">\n              04 / INFRAESTRUCTURA DE TRANSPORTE\n            </span>\n            <h2 class=\"font-display font-extrabold text-3xl sm:text-4xl md:text-5xl text-white tracking-tight mb-4\">\n              Nuestra Flota Especializada\n            </h2>\n            <p class=\"text-zinc-400 text-base md:text-lg font-light\">\n              Unidades de alto tonelaje dise\303\261adas para operar en las condiciones m\303\241s exigentes del territorio nacional.\n            </p>\n          </div>\n\n          <!-- 3 Items Verticales -->\n          <div class=\"flex flex-col gap-8\">\n            \n            <!-- Item 1: Plataformas (Forma Circular) -->\n            <div class=\"fleet-item reveal\" data-delay=\"100\">\n              <div class=\"grid grid-cols-1 md:grid-cols-12 gap-8 items-center\">\n                <!-- Visual: Forma Circular que rota 90\302\260 al hover -->\n                <div class=\"md:col-span-3 flex justify-center md:justify-start\">\n                  <div class=\"fleet-shape fleet-shape-circle flex items-center justify-center\">\n                    <!-- Icono o Glifo Estilizado -->\n                    <svg class=\"w-10 h-10 text-red-500 opacity-90\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n                      <rect x=\"2\" y=\"8\" width=\"20\" height=\"8\" rx=\"2\" stroke-width=\"1.8\"></rect>\n                      <circle cx=\"6\" cy=\"18\" r=\"2\" stroke-width=\"1.8\"></circle>\n                      <circle cx=\"18\" cy=\"18\" r=\"2\" stroke-width=\"1.8\"></circle>\n                      <path d=\"M4 8V6a2 2 0 012-2h4l2 4\" stroke-width=\"1.8\"></path>\n                    </svg>\n                  </div>\n                </div>\n\n                <!-- Info: H3, P\303\241rrafo y Specs en Pills -->\n                <div class=\"md:col-span-9 flex flex-col gap-4\">\n                  <div class=\"flex flex-wrap items-center justify-between gap-3\">\n                    <h3 class=\"font-display font-bold text-2xl md:text-3xl text-white\">\n                      Plataformas de Carga Pesada & Camabajas\n                    </h3>\n                    <div class=\"flex flex-wrap gap-2 font-mono text-xs\">\n                      <span class=\"px-3 py-1 rounded-full bg-white/[0.04] border border-white/10 text-zinc-300\">60t Capacidad</span>\n                      <span class=\"px-3 py-1 rounded-full bg-white/[0.04] border border-white/10 text-zinc-300\">20m Extensi\303\263n</span>\n                      <span class=\"px-3 py-1 rounded-full bg-red-600/10 text-red-400 border border-red-500/20\">Monitoreo 24/7</span>\n                    </div>\n                  </div>\n                  <p class=\"text-zinc-400 text-sm md:text-base font-light leading-relaxed\">\n                    Tractocamiones de alta potencia acoplados a plataformas tipo lowboy, camabaja y extensibles. Ideales para el traslado de taladros petroleros, generadores de gran escala, palas mec\303\241nicas y estructuras sobredimensionadas.\n                  </p>\n                </div>\n              </div>\n            </div>\n\n            <!-- Item 2: Contenedores (Forma Diamante) -->\n            <div class=\"fleet-item reveal\" data-delay=\"200\">\n              <div class=\"grid grid-cols-1 md:grid-cols-12 gap-8 items-center\">\n                <!-- Visual: Forma Diamante que rota 90\302\260 al hover -->\n                <div class=\"md:col-span-3 flex justify-center md:justify-start\">\n                  <div class=\"fleet-shape fleet-shape-diamond flex items-center justify-center\">\n                    <svg class=\"w-10 h-10 text-red-500 opacity-90 -rotate-45\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n                      <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.8\" d=\"M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4\"></path>\n                    </svg>\n                  </div>\n                </div>\n\n                <!-- Info: H3, P\303\241rrafo y Specs en Pills -->\n                <div class=\"md:col-span-9 flex flex-col gap-4\">\n                  <div class=\"flex flex-wrap items-center justify-between gap-3\">\n                    <h3 class=\"font-display font-bold text-2xl md:text-3xl text-white\">\n                      Portacontenedores Secos & Refrigerados\n                    </h3>\n                    <div class=\"flex flex-wrap gap-2 font-mono text-xs\">\n                      <span class=\"px-3 py-1 rounded-full bg-white/[0.04] border border-white/10 text-zinc-300\">40\' Dry / Reefer</span>\n                      <span class=\"px-3 py-1 rounded-full bg-white/[0.04] border border-white/10 text-zinc-300\">30t Carga \303\232til</span>\n                      <span class=\"px-3 py-1 rounded-full bg-red-600/10 text-red-400 border border-red-500/20\">GPS Satelital</span>\n                    </div>\n                  </div>\n                  <p class=\"text-zinc-400 text-sm md:text-base font-light leading-relaxed\">\n                    Chasis portacontenedores con sistemas de traba twist-lock y conexiones genset para carga refrigerada. Coordinamos la recepci\303\263n en puertos de Guayaquil y Manta hacia plantas de producci\303\263n en la Sierra y Oriente.\n                  </p>\n                </div>\n              </div>\n            </div>\n\n            <!-- Item 3: Tanques Vacuum (Forma Hexagonal) -->\n            <div class=\"fleet-item reveal\" data-delay=\"300\">\n              <div class=\"grid grid-cols-1 md:grid-cols-12 gap-8 items-center\">\n                <!-- Visual: Forma Hexagonal que rota 90\302\260 al hover -->\n                <div class=\"md:col-span-3 flex justify-center md:justify-start\">\n                  <div class=\"fleet-shape fleet-shape-hexagon flex items-center justify-center\">\n                    <svg class=\"w-10 h-10 text-red-500 opacity-90\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n                      <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"1.8\" d=\"M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z\"></path>\n                    </svg>\n                  </div>\n                </div>\n\n                <!-- Info: H3, P\303\241rrafo y Specs en Pills -->\n                <div class=\"md:col-span-9 flex flex-col gap-4\">\n                  <div class=\"flex flex-wrap items-center justify-between gap-3\">\n                    <h3 class=\"font-display font-bold text-2xl md:text-3xl text-white\">\n                      Tanques Vacuum para Fluidos & Residuos\n                    </h3>\n                    <div class=\"flex flex-wrap gap-2 font-mono text-xs\">\n                      <span class=\"px-3 py-1 rounded-full bg-white/[0.04] border border-white/10 text-zinc-300\">25 kL / 200 bbl</span>\n                      <span class=\"px-3 py-1 rounded-full bg-white/[0.04] border border-white/10 text-zinc-300\">Normas HAZMAT</span>\n                      <span class=\"px-3 py-1 rounded-full bg-red-600/10 text-red-400 border border-red-500/20\">Certificaci\303\263n ISO</span>\n                    </div>\n                  </div>\n                  <p class=\"text-zinc-400 text-sm md:text-base font-light leading-relaxed\">\n                    Equipos de succi\303\263n y transporte herm\303\251tico para hidrocarburos, aguas industriales tratadas y fluidos residuales. Dise\303\261ados bajo directrices de integridad ambiental y operados por personal t\303\251cnico certificado.\n                  </p>\n                </div>\n              </div>\n            </div>\n\n          </div>\n\n        </div>\n      </section>\n\n      <!-- =====================================================================\n           6. ESTAD\303\215STICAS BANNER (4 Columnas con Borde Arriba/Abajo)\n           ===================================================================== -->\n      <section id=\"estadisticas\" class=\"py-24 px-6 md:px-12 border-y border-white/[0.08] bg-white/[0.01] relative\">\n        <div class=\"max-w-7xl mx-auto\">\n          \n          <div class=\"grid grid-cols-2 lg:grid-cols-4 gap-10 md:gap-14 text-center\">\n            \n            <div class=\"reveal flex flex-col items-center\" data-delay=\"100\">\n              <span class=\"font-display font-extrabold text-4xl sm:text-5xl lg:text-6xl text-white tracking-tight mb-2\" data-target=\"15000\" data-suffix=\"+\">\n                0\n              </span>\n              <span class=\"text-xs uppercase tracking-[0.2em] text-zinc-400 font-medium\">\n                Km / mes recorridos\n              </span>\n            </div>\n\n            <div class=\"reveal flex flex-col items-center\" data-delay=\"200\">\n              <span class=\"font-display font-extrabold text-4xl sm:text-5xl lg:text-6xl text-white tracking-tight mb-2\" data-target=\"45\" data-suffix=\"+\">\n                0\n              </span>\n              <span class=\"text-xs uppercase tracking-[0.2em] text-zinc-400 font-medium\">\n                Unidades en flota activa\n              </span>\n            </div>\n\n            <div class=\"reveal flex flex-col items-center\" data-delay=\"300\">\n              <span class=\"font-display font-extrabold text-4xl sm:text-5xl lg:text-6xl text-white tracking-tight mb-2\" data-target=\"24\" data-suffix=\"\">\n                0\n              </span>\n              <span class=\"text-xs uppercase tracking-[0.2em] text-zinc-400 font-medium\">\n                Provincias cubiertas\n              </span>\n            </div>\n\n            <div class=\"reveal flex flex-col items-center\" data-delay=\"400\">\n              <span class=\"font-display font-extrabold text-4xl sm:text-5xl lg:text-6xl text-white tracking-tight mb-2\" data-target=\"500\" data-suffix=\"+\">\n                0\n              </span>\n              <span class=\"text-xs uppercase tracking-[0.2em] text-zinc-400 font-medium\">\n                Empresas que conf\303\255an\n              </span>\n            </div>\n\n          </div>\n\n        </div>\n      </section>\n\n      <!-- =====================================================================\n           7. SECCI\303\223N CONTACTO & COTIZACI\303\223N (Grid 2 Columnas)\n           ===================================================================== -->\n      <section id=\"contacto\" class=\"py-32 px-6 md:px-12 relative border-t border-white/[0.06]\">\n        <div class=\"max-w-7xl mx-auto\">\n          \n          <div class=\"grid grid-cols-1 lg:grid-cols-12 gap-16 lg:gap-20 items-start\">\n            \n            <!-- Columna Izquierda: Informaci\303\263n Directa e Iconos SVG Rojos -->\n            <div class=\"lg:col-span-5 reveal\">\n              <span class=\"text-xs uppercase tracking-[0.25em] text-red-500 font-semibold font-display block mb-3\">\n                05 / INICIEMOS CONVERSACI\303\223N\n              </span>\n              <h2 class=\"font-display font-extrabold text-3xl sm:text-4xl md:text-5xl text-white tracking-tight mb-6\">\n                Coordinemos su pr\303\263ximo flete seguro.\n              </h2>\n              <p class=\"text-zinc-400 text-base font-light leading-relaxed mb-10\">\n                Nuestro equipo de operaciones eval\303\272a rutas, peso y requerimientos especiales en tiempo r\303\251cord para enviarle una propuesta comercial transparente.\n              </p>\n\n              <!-- Lista de Contacto -->\n              <div class=\"flex flex-col gap-6 text-sm\">\n                \n                <!-- Tel\303\251fono -->\n                <div class=\"flex items-start gap-4\">\n                  <div class=\"w-10 h-10 rounded-xl bg-red-600/10 border border-red-500/20 flex items-center justify-center text-red-500 shrink-0\">\n                    <svg class=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n                      <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z\"></path>\n                    </svg>\n                  </div>\n                  <div>\n                    <span class=\"text-xs uppercase tracking-wider text-zinc-400 block font-mono\">Central Telef\303\263nica</span>\n                    <a href=\"tel:+59323956540\" class=\"text-white hover:text-red-400 font-medium transition-colors text-base\">\n                      +593 (02) 3956540\n                    </a>\n                  </div>\n                </div>\n\n                <!-- Correo Electr\303\263nico -->\n                <div class=\"flex items-start gap-4\">\n                  <div class=\"w-10 h-10 rounded-xl bg-red-600/10 border border-red-500/20 flex items-center justify-center text-red-500 shrink-0\">\n                    <svg class=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n                      <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z\"></path>\n                    </svg>\n                  </div>\n                  <div>\n                    <span class=\"text-xs uppercase tracking-wider text-zinc-400 block font-mono\">Correo Corporativo</span>\n                    <a href=\"mailto:conexpet@conexpet.com\" class=\"text-white hover:text-red-400 font-medium transition-colors text-base\">\n                      conexpet@conexpet.com\n                    </a>\n                  </div>\n                </div>\n\n                <!-- Ubicaci\303\263n HQ -->\n                <div class=\"flex items-start gap-4\">\n                  <div class=\"w-10 h-10 rounded-xl bg-red-600/10 border border-red-500/20 flex items-center justify-center text-red-500 shrink-0\">\n                    <svg class=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n                      <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z\"></path>\n                      <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M15 11a3 3 0 11-6 0 3 3 0 016 0z\"></path>\n                    </svg>\n                  </div>\n                  <div>\n                    <span class=\"text-xs uppercase tracking-wider text-zinc-400 block font-mono\">Oficina Principal & Talleres</span>\n                    <p class=\"text-white font-medium text-base\">\n                      V\303\255a Tarapoa Lote 5 S/N y Km 11 \302\275\n                    </p>\n                    <span class=\"text-zinc-400 text-xs\">Lago Agrio, Sucumb\303\255os &mdash; Ecuador</span>\n                  </div>\n                </div>\n\n                <!-- Horario de Operaci\303\263n -->\n                <div class=\"flex items-start gap-4\">\n                  <div class=\"w-10 h-10 rounded-xl bg-red-600/10 border border-red-500/20 flex items-center justify-center text-red-500 shrink-0\">\n                    <svg class=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n                      <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z\"></path>\n                    </svg>\n                  </div>\n                  <div>\n                    <span class=\"text-xs uppercase tracking-wider text-zinc-400 block font-mono\">Disponibilidad de Despacho</span>\n                    <p class=\"text-white font-medium text-base\">\n                      Operaciones 24/7 &mdash; Lunes a Domingo\n                    </p>\n                    <span class=\"text-zinc-400 text-xs\">Monitoreo y torre de control activa todo el a\303\261o</span>\n                  </div>\n                </div>\n\n              </div>\n            </div>\n\n            <!-- Columna Derecha: Formulario de Cotizaci\303\263n -->\n            <div class=\"lg:col-span-7 reveal\">\n              <div class=\"bg-white/[0.02] border border-white/[0.08] rounded-3xl p-8 sm:p-12 relative overflow-hidden\">\n                \n                <!-- Feedback Toast al Enviar -->\n                <div id=\"quote-feedback\" class=\"hidden mb-8 p-4 rounded-2xl bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-sm flex items-center gap-3\">\n                  <svg class=\"w-5 h-5 shrink-0\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n                    <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M5 13l4 4L19 7\"></path>\n                  </svg>\n                  <span>\302\241Solicitud enviada con \303\251xito! Nuestro centro log\303\255stico se contactar\303\241 con usted en breve.</span>\n                </div>\n\n                <form id=\"quote-form\" class=\"space-y-6\">\n                  \n                  <!-- Nombre -->\n                  <div>\n                    <label for=\"form-name\" class=\"block text-xs uppercase tracking-wider text-zinc-400 mb-2 font-mono\">\n                      Nombre completo o Raz\303\263n Social *\n                    </label>\n                    <input \n                      type=\"text\" \n                      id=\"form-name\" \n                      required \n                      placeholder=\"Ej. Ing. Carlos Andrade / PetroServicios S.A.\" \n                      class=\"w-full px-5 py-3.5 rounded-xl bg-white/[0.03] border border-white/10 text-white placeholder-zinc-600 focus:outline-none focus:border-red-500 focus:ring-1 focus:ring-red-500 transition-colors text-sm\"\n                    />\n                  </div>\n\n                  <!-- Email y Tel\303\251fono en Grid -->\n                  <div class=\"grid grid-cols-1 sm:grid-cols-2 gap-6\">\n                    <div>\n                      <label for=\"form-email\" class=\"block text-xs uppercase tracking-wider text-zinc-400 mb-2 font-mono\">\n                        Correo Corporativo *\n                      </label>\n                      <input \n                        type=\"email\" \n                        id=\"form-email\" \n                        required \n                        placeholder=\"contacto@empresa.com\" \n                        class=\"w-full px-5 py-3.5 rounded-xl bg-white/[0.03] border border-white/10 text-white placeholder-zinc-600 focus:outline-none focus:border-red-500 focus:ring-1 focus:ring-red-500 transition-colors text-sm\"\n                      />\n                    </div>\n                    <div>\n                      <label for=\"form-phone\" class=\"block text-xs uppercase tracking-wider text-zinc-400 mb-2 font-mono\">\n                        Tel\303\251fono / WhatsApp *\n                      </label>\n                      <input \n                        type=\"tel\" \n                        id=\"form-phone\" \n                        required \n                        placeholder=\"+593 99 123 4567\" \n                        class=\"w-full px-5 py-3.5 rounded-xl bg-white/[0.03] border border-white/10 text-white placeholder-zinc-600 focus:outline-none focus:border-red-500 focus:ring-1 focus:ring-red-500 transition-colors text-sm\"\n                      />\n                    </div>\n                  </div>\n\n                  <!-- Selector de Servicio -->\n                  <div>\n                    <label for=\"form-service\" class=\"block text-xs uppercase tracking-wider text-zinc-400 mb-2 font-mono\">\n                      Tipo de Servicio Requerido *\n                    </label>\n                    <select \n                      id=\"form-service\" \n                      required \n                      class=\"w-full px-5 py-3.5 rounded-xl bg-[#141414] border border-white/10 text-white focus:outline-none focus:border-red-500 focus:ring-1 focus:ring-red-500 transition-colors text-sm\"\n                    >\n                      <option value=\"\" disabled selected>Seleccione una categor\303\255a</option>\n                      <option value=\"carga-pesada\">Transporte de Carga Pesada & Extrapesada (Hasta 60t)</option>\n                      <option value=\"vacuum\">Transporte de Fluidos Vacuum (Hasta 200 bbl)</option>\n                      <option value=\"izaje\">Gr\303\272as Industriales & Maniobras de Izaje (Hasta 120t)</option>\n                      <option value=\"contenedores\">Movilizaci\303\263n y Almacenamiento de Contenedores</option>\n                      <option value=\"rutas\">Consultor\303\255a en Rutas & Log\303\255stica Integral</option>\n                    </select>\n                  </div>\n\n                  <!-- Ruta Estimada -->\n                  <div class=\"grid grid-cols-1 sm:grid-cols-2 gap-6\">\n                    <div>\n                      <label for=\"form-origin\" class=\"block text-xs uppercase tracking-wider text-zinc-400 mb-2 font-mono\">\n                        Origen\n                      </label>\n                      <input \n                        type=\"text\" \n                        id=\"form-origin\" \n                        placeholder=\"Ej. Guayaquil / Puerto\" \n                        class=\"w-full px-5 py-3.5 rounded-xl bg-white/[0.03] border border-white/10 text-white placeholder-zinc-600 focus:outline-none focus:border-red-500 focus:ring-1 focus:ring-red-500 transition-colors text-sm\"\n                      />\n                    </div>\n                    <div>\n                      <label for=\"form-destination\" class=\"block text-xs uppercase tracking-wider text-zinc-400 mb-2 font-mono\">\n                        Destino\n                      </label>\n                      <input \n                        type=\"text\" \n                        id=\"form-destination\" \n                        placeholder=\"Ej. Bloque 57 / Lago Agrio\" \n                        class=\"w-full px-5 py-3.5 rounded-xl bg-white/[0.03] border border-white/10 text-white placeholder-zinc-600 focus:outline-none focus:border-red-500 focus:ring-1 focus:ring-red-500 transition-colors text-sm\"\n                      />\n                    </div>\n                  </div>\n\n                  <!-- Mensaje / Detalles de Carga -->\n                  <div>\n                    <label for=\"form-details\" class=\"block text-xs uppercase tracking-wider text-zinc-400 mb-2 font-mono\">\n                      Detalles de la Carga (Dimensiones, Peso, Fechas)\n                    </label>\n                    <textarea \n                      id=\"form-details\" \n                      rows=\"4\" \n                      placeholder=\"Describa el tonelaje aproximado, tipo de equipo, fechas estimadas de despacho o requerimientos especiales...\"\n                      class=\"w-full px-5 py-3.5 rounded-xl bg-white/[0.03] border border-white/10 text-white placeholder-zinc-600 focus:outline-none focus:border-red-500 focus:ring-1 focus:ring-red-500 transition-colors text-sm resize-none\"\n                    ></textarea>\n                  </div>\n\n                  <!-- Bot\303\263n Submit Rojo Full-Width con Flecha -->\n                  <button \n                    type=\"submit\" \n                    id=\"form-submit-btn\"\n                    class=\"magnetic-btn w-full py-4 px-8 rounded-full bg-[#DC2626] hover:bg-[#EF4444] text-white font-semibold text-sm md:text-base tracking-wide flex items-center justify-center gap-3 transition-all duration-300 shadow-xl shadow-red-600/30\"\n                  >\n                    <span>Solicitar cotizaci\303\263n inmediata</span>\n                    <svg class=\"w-4 h-4\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n                      <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M14 5l7 7m0 0l-7 7m7-7H3\"></path>\n                    </svg>\n                  </button>\n\n                  <p class=\"text-center text-xs text-zinc-500\">\n                    Sus datos son tratados con confidencialidad profesional bajo normas de seguridad industrial.\n                  </p>\n\n                </form>\n\n              </div>\n            </div>\n\n          </div>\n\n        </div>\n      </section>\n    </main>\n\n    <!-- =====================================================================\n         FOOTER (Grid 4 Columnas: Marca, Navegaci\303\263n, Servicios, Intranet)\n         ===================================================================== -->\n    <footer id=\"footer\" class=\"border-t border-white/[0.08] bg-[#050505] text-zinc-400 pt-20 pb-12 px-6 md:px-12 relative z-10\">\n      <div class=\"max-w-7xl mx-auto\">\n        \n        <div class=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-12 lg:gap-16 pb-16 border-b border-white/[0.06]\">\n          \n          <!-- Columna 1: Marca + Descripci\303\263n + Redes -->\n          <div class=\"flex flex-col gap-6\">\n            <a href=\"#hero\" class=\"flex items-center gap-3 focus:outline-none\">\n              <img src=\"img/logo.png\" alt=\"CONEXPET\" class=\"h-9 w-auto object-contain logo-filter\" />\n            </a>\n            <p class=\"text-xs sm:text-sm font-light leading-relaxed text-zinc-400\">\n              CONEXPET TRANSPORTE S.A. &mdash; Especialistas en log\303\255stica integral, carga extrapesada, fluidos vacuum y maniobras de izaje en las 24 provincias del Ecuador.\n            </p>\n            <div class=\"flex items-center gap-3 pt-2\">\n              <!-- LinkedIn -->\n              <a href=\"https://www.linkedin.com/company/conexpet/\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"w-9 h-9 rounded-full bg-white/[0.04] hover:bg-white/[0.1] border border-white/10 flex items-center justify-center text-white hover:text-red-400 transition-colors\" aria-label=\"LinkedIn CONEXPET\">\n                <svg class=\"w-4 h-4\" fill=\"currentColor\" viewBox=\"0 0 24 24\">\n                  <path d=\"M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.2V10.9H6.46M7.83 6.45c-.9 0-1.63.73-1.63 1.64s.73 1.63 1.63 1.63 1.63-.72 1.63-1.63-.73-1.64-1.63-1.64Z\"></path>\n                </svg>\n              </a>\n              <!-- Facebook -->\n              <a href=\"https://www.facebook.com/triboilgas\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"w-9 h-9 rounded-full bg-white/[0.04] hover:bg-white/[0.1] border border-white/10 flex items-center justify-center text-white hover:text-red-400 transition-colors\" aria-label=\"Facebook CONEXPET\">\n                <svg class=\"w-4 h-4\" fill=\"currentColor\" viewBox=\"0 0 24 24\">\n                  <path d=\"M22 12c0-5.52-4.48-10-10-10S2 6.48 2 12c0 4.84 3.44 8.87 8 9.8V15H8v-3h2V9.5C10 7.57 11.57 6 13.5 6H16v3h-2c-.55 0-1 .45-1 1v2h3v3h-3v6.95c5.05-.5 9-4.76 9-9.95z\"></path>\n                </svg>\n              </a>\n            </div>\n          </div>\n\n          <!-- Columna 2: Navegaci\303\263n -->\n          <div>\n            <h4 class=\"font-display font-semibold text-sm text-white tracking-wider uppercase mb-5\">\n              Navegaci\303\263n\n            </h4>\n            <ul class=\"flex flex-col gap-3 text-xs sm:text-sm font-light\">\n              <li><a href=\"#hero\" class=\"hover:text-white transition-colors\">Inicio</a></li>\n              <li><a href=\"#nosotros\" class=\"hover:text-white transition-colors\">Qui\303\251nes Somos</a></li>\n              <li><a href=\"#servicios\" class=\"hover:text-white transition-colors\">Servicios Integrales</a></li>\n              <li><a href=\"#cobertura\" class=\"hover:text-white transition-colors\">Cobertura Nacional</a></li>\n              <li><a href=\"#flota\" class=\"hover:text-white transition-colors\">Flota de Veh\303\255culos</a></li>\n              <li><a href=\"#contacto\" class=\"hover:text-white transition-colors\">Cotizaci\303\263n & Contacto</a></li>\n            </ul>\n          </div>\n\n          <!-- Columna 3: Servicios -->\n          <div>\n            <h4 class=\"font-display font-semibold text-sm text-white tracking-wider uppercase mb-5\">\n              Servicios\n            </h4>\n            <ul class=\"flex flex-col gap-3 text-xs sm:text-sm font-light\">\n              <li><a href=\"#servicios\" class=\"hover:text-white transition-colors\">Carga Pesada & RIGs</a></li>\n              <li><a href=\"#servicios\" class=\"hover:text-white transition-colors\">Fluidos Vacuum hasta 200 bbl</a></li>\n              <li><a href=\"#servicios\" class=\"hover:text-white transition-colors\">Izaje con Gr\303\272as de 120t</a></li>\n              <li><a href=\"#servicios\" class=\"hover:text-white transition-colors\">Contenedores Secos & Reefer</a></li>\n              <li><a href=\"#servicios\" class=\"hover:text-white transition-colors\">Talleres Propios & Mantenimiento</a></li>\n              <li><a href=\"#cobertura\" class=\"hover:text-white transition-colors\">Monitoreo GPS 24/7</a></li>\n            </ul>\n          </div>\n\n          <!-- Columna 4: Intranet & Corporativo -->\n          <div>\n            <h4 class=\"font-display font-semibold text-sm text-white tracking-wider uppercase mb-5\">\n              Intranet & Accesos\n            </h4>\n            <ul class=\"flex flex-col gap-3 text-xs sm:text-sm font-light\">\n              <li>\n                <a href=\"https://forms.office.com/pages/responsepage.aspx?id=oneFCI-_SEekK--m01noBwxpJwflPrlFkQlnaS6QOqRUN0JNTk1XMUwzVEswT0NLM0xaUkI5M1BUVi4u\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"hover:text-white transition-colors flex items-center gap-1.5\">\n                  <span>Tarjeta Cero</span>\n                  <svg class=\"w-3 h-3 text-red-500\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path d=\"M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg>\n                </a>\n              </li>\n              <li>\n                <a href=\"https://compers.online/\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"hover:text-white transition-colors flex items-center gap-1.5\">\n                  <span>Compers TTHH</span>\n                  <svg class=\"w-3 h-3 text-red-500\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path d=\"M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg>\n                </a>\n              </li>\n              <li>\n                <a href=\"http://64.190.27.46:8040/jde/E1Menu.maf?\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"hover:text-white transition-colors flex items-center gap-1.5\">\n                  <span>JD Edwards (ERP)</span>\n                  <svg class=\"w-3 h-3 text-red-500\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path d=\"M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg>\n                </a>\n              </li>\n              <li>\n                <a href=\"https://www.triboilgas.com/hesk/\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"hover:text-white transition-colors flex items-center gap-1.5\">\n                  <span>Ticket de Soporte</span>\n                  <svg class=\"w-3 h-3 text-red-500\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path d=\"M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg>\n                </a>\n              </li>\n              <li>\n                <a href=\"https://proveedores.triboil.com/\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"hover:text-white transition-colors flex items-center gap-1.5\">\n                  <span>Portal Proveedores SYSFIN</span>\n                  <svg class=\"w-3 h-3 text-red-500\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\"><path d=\"M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-