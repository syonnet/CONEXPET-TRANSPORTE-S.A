        }
        lines {
          text: "          <div class=\"inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-red-100 text-red-700 dark:bg-red-950 dark:text-red-300 text-xs font-bold uppercase tracking-wider mb-3\">"
