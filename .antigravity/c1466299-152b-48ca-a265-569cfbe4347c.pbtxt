      replacement_content: "    <!-- Hoja de Estilos de Alto Impacto (Ruta Relativa para Funcionamiento Local y Servidor) -->\n    <link rel=\"stylesheet\" href=\"./style.css\" />\n\n    <!-- Script de L\303\263gica e Interactividad (Ruta Relativa para Funcionamiento Local y Servidor) -->\n    <script defer src=\"./script.js\"></script>\n\n    <!-- Fallback de seguridad: garantiza despliegue de contenido si el entorno local bloquea scripts -->\n    <script>\n      window.addEventListener(\'load\', function() {\n        setTimeout(function() {\n          var p = document.getElementById(\'preloader\');\n          if (p && !p.classList.contains(\'fade-out\')) {\n            p.classList.add(\'fade-out\');\n          }\n          var revs = document.querySelectorAll(\'.reveal\');\n          revs.forEach(function(el) {\n            el.classList.add(\'active\');\n          });\n        }, 2200);\n      });\n    </script>\n  </head>"
