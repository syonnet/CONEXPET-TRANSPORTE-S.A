          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        mainNav.classList.remove(\'py-6\', \'border-transparent\');"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      } else {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        mainNav.classList.remove(\'bg-[#0A0A0A]/85\', \'backdrop-blur-xl\', \'border-b\', \'border-white/[0.06]\', \'py-4\');"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        mainNav.classList.add(\'py-6\', \'border-transparent\');"
