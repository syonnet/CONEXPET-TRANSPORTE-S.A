        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  const counterObserver = new IntersectionObserver((entries, obs) => {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    entries.forEach(entry => {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
