    replacement_chunks {
      replacement_content: "@import url(\'https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Inter+Tight:wght@600;700;800;900&display=swap\');\n\n/* ==========================================================================\n   CONEXPET TRANSPORTE S.A. - SISTEMA DE DISE\303\221O DE ALTO IMPACTO (AWWARDS STYLE)\n   Soporte nativo para MODO CLARO (Default) y MODO OSCURO con cambio instant\303\241neo\n   ========================================================================== */\n\n:root,\n[data-theme=\"light\"] {\n  --bg-main: #FFFFFF;\n  --bg-secondary: #F8FAFC;\n  --bg-tertiary: #F1F5F9;\n  --bg-surface: #FFFFFF;\n  --bg-card: #FFFFFF;\n  --bg-card-hover: #F8FAFC;\n  --bg-modal: #FFFFFF;\n  --bg-preloader: #FFFFFF;\n  --border-main: #E2E8F0;\n  --border-subtle: #F1F5F9;\n  --border-hover: rgba(220, 38, 38, 0.45);\n  --text-primary: #0F172A;\n  --text-secondary: #334155;\n  --text-muted: #64748B;\n  --text-inverse: #FFFFFF;\n  --color-red: #DC2626;\n  --color-red-light: #EF4444;\n  --color-red-dark: #B91C1C;\n  --color-red-glow: rgba(220, 38, 38, 0.15);\n  --color-badge-bg: #FEF2F2;\n  --color-badge-border: #FCA5A5;\n  --nav-bg: rgba(255, 255, 255, 0.88);\n  --nav-border: rgba(15, 23, 42, 0.08);\n  --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.05);\n  --shadow-card: 0 4px 20px -2px rgba(15, 23, 42, 0.05), 0 2px 6px -1px rgba(15, 23, 42, 0.02);\n  --shadow-hover: 0 20px 30px -4px rgba(15, 23, 42, 0.08), 0 8px 12px -2px rgba(220, 38, 38, 0.08);\n  --logo-filter: none;\n  --geo-opacity-mult: 1;\n  --geo-bg: rgba(220, 38, 38, 0.06);\n  --font-display: \'Inter Tight\', -apple-system, BlinkMacSystemFont, sans-serif;\n  --font-body: \'Inter\', -apple-system, BlinkMacSystemFont, sans-serif;\n  --ease-apple: cubic-bezier(0.16, 1, 0.3, 1);\n}\n\n[data-theme=\"dark\"] {\n  --bg-main: #09090B;\n  --bg-secondary: #101014;\n  --bg-tertiary: #181820;\n  --bg-surface: #121217;\n  --bg-card: rgba(255, 255, 255, 0.025);\n  --bg-card-hover: rgba(255, 255, 255, 0.05);\n  --bg-modal: #121217;\n  --bg-preloader: #09090B;\n  --border-main: rgba(255, 255, 255, 0.08);\n  --border-subtle: rgba(255, 255, 255, 0.04);\n  --border-hover: rgba(239, 68, 68, 0.5);\n  --text-primary: #FFFFFF;\n  --text-secondary: #A1A1AA;\n  --text-muted: #71717A;\n  --text-inverse: #09090B;\n  --color-red: #EF4444;\n  --color-red-light: #F87171;\n  --color-red-dark: #DC2626;\n  --color-red-glow: rgba(239, 68, 68, 0.35);\n  --color-badge-bg: rgba(220, 38, 38, 0.15);\n  --color-badge-border: rgba(220, 38, 38, 0.35);\n  --nav-bg: rgba(9, 9, 11, 0.88);\n  --nav-border: rgba(255, 255, 255, 0.06);\n  --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.4);\n  --shadow-card: 0 4px 20px -2px rgba(0, 0, 0, 0.4);\n  --shadow-hover: 0 20px 30px -4px rgba(0, 0, 0, 0.6), 0 8px 12px -2px rgba(239, 68, 68, 0.2);\n  --logo-filter: brightness(0) invert(1);\n  --geo-opacity-mult: 0.8;\n  --geo-bg: rgba(220, 38, 38, 0.08);\n}\n\n/* Reset y base */\n*, *::before, *::after {\n  box-sizing: border-box;\n  margin: 0;\n  padding: 0;\n}\n\nhtml {\n  scroll-behavior: smooth;\n  background-color: var(--bg-main);\n  color: var(--text-primary);\n  font-family: var(--font-body);\n  font-size: 16px;\n  line-height: 1.6;\n  text-rendering: optimizeLegibility;\n  -webkit-font-smoothing: antialiased;\n  -moz-osx-font-smoothing: grayscale;\n  transition: background-color 0.3s ease, color 0.3s ease;\n}\n\nbody {\n  background-color: var(--bg-main);\n  color: var(--text-primary);\n  min-height: 100vh;\n  position: relative;\n  overflow-x: hidden;\n  transition: background-color 0.3s ease, color 0.3s ease;\n}\n\n/* Selecci\303\263n de texto */\n::selection {\n  background-color: var(--color-red);\n  color: #FFFFFF;\n}\n\n::-moz-selection {\n  background-color: var(--color-red);\n  color: #FFFFFF;\n}\n\n/* Scrollbar Personalizada */\n::-webkit-scrollbar {\n  width: 6px;\n}\n\n::-webkit-scrollbar-track {\n  background: var(--bg-main);\n}\n\n::-webkit-scrollbar-thumb {\n  background: var(--color-red);\n  border-radius: 3px;\n}\n\n::-webkit-scrollbar-thumb:hover {\n  background: var(--color-red-light);\n}\n\n/* Tipograf\303\255a de Encabezados */\nh1, h2, h3, h4, h5, h6, .font-display {\n  font-family: var(--font-display);\n  letter-spacing: -0.025em;\n  font-feature-settings: \"cv02\", \"cv03\", \"cv04\", \"cv11\";\n}\n\n/* Gradiente rojo din\303\241mico animado */\n.text-gradient-red {\n  background: linear-gradient(90deg, #DC2626 0%, #EF4444 25%, #B91C1C 50%, #EF4444 75%, #DC2626 100%);\n  background-size: 200% auto;\n  -webkit-background-clip: text;\n  background-clip: text;\n  -webkit-text-fill-color: transparent;\n  animation: redGradientShift 6s linear infinite;\n}\n\n@keyframes redGradientShift {\n  0% { background-position: 0% 50%; }\n  50% { background-position: 100% 50%; }\n  100% { background-position: 0% 50%; }\n}\n\n/* Filtro adaptativo del logo */\n.brand-logo-img {\n  filter: var(--logo-filter);\n  transition: filter 0.3s ease, transform 0.3s ease;\n}\n\n/* ==========================================================================\n   NOISE & GRAIN TEXTURE\n   ========================================================================== */\n.noise-overlay {\n  position: fixed;\n  inset: 0;\n  width: 100%;\n  height: 100%;\n  pointer-events: none;\n  z-index: 1;\n  opacity: 0.025;\n  background-image: url(\"data:image/svg+xml,%3Csvg viewBox=\'0 0 200 200\' xmlns=\'http://www.w3.org/2000/svg\'%3E%3Cfilter id=\'noiseFilter\'%3E%3CfeTurbulence type=\'fractalNoise\' baseFrequency=\'0.8\' numOctaves=\'3\' stitchTiles=\'stitch\'/%3E%3C/filter%3E%3Crect width=\'100%25\' height=\'100%25\' filter=\'url(%23noiseFilter)\'/%3E%3C/svg%3E\");\n}\n\n/* ==========================================================================\n   L\303\215NEA DE PROGRESO DE SCROLL (Borde derecho)\n   ========================================================================== */\n.scroll-progress-container {\n  position: fixed;\n  top: 0;\n  right: 0;\n  bottom: 0;\n  width: 3px;\n  background: var(--border-subtle);\n  z-index: 60;\n  pointer-events: none;\n}\n\n.scroll-progress-bar {\n  width: 100%;\n  height: 0%;\n  background: var(--color-red);\n  box-shadow: 0 0 10px var(--color-red-glow);\n  transition: height 0.08s linear;\n}\n\n/* ==========================================================================\n   CUSTOM CURSOR (Desktop)\n   ========================================================================== */\n.cursor-dot {\n  position: fixed;\n  top: 0;\n  left: 0;\n  width: 8px;\n  height: 8px;\n  background-color: var(--color-red);\n  border-radius: 50%;\n  pointer-events: none;\n  z-index: 9999;\n  transform: translate(-50%, -50%);\n  box-shadow: 0 0 8px var(--color-red);\n  opacity: 0;\n  transition: opacity 0.3s ease, transform 0.1s ease;\n}\n\n.cursor-ring {\n  position: fixed;\n  top: 0;\n  left: 0;\n  width: 32px;\n  height: 32px;\n  border: 1.5px solid var(--color-red);\n  border-radius: 50%;\n  pointer-events: none;\n  z-index: 9998;\n  transform: translate(-50%, -50%);\n  opacity: 0;\n  transition: opacity 0.3s ease, width 0.25s var(--ease-apple), height 0.25s var(--ease-apple), border-color 0.25s ease, background-color 0.25s ease;\n}\n\n.cursor-ring.cursor-hover {\n  width: 48px;\n  height: 48px;\n  border-color: var(--color-red-light);\n  background-color: var(--color-red-glow);\n}\n\n@media (pointer: coarse) or (hover: none) {\n  .cursor-dot, .cursor-ring {\n    display: none !important;\n  }\n}\n\n/* ==========================================================================\n   PRELOADER ELEGANTE Y R\303\201PIDO\n   ========================================================================== */\n.preloader {\n  position: fixed;\n  inset: 0;\n  background-color: var(--bg-preloader);\n  z-index: 99999;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  transition: opacity 0.6s var(--ease-apple), visibility 0.6s var(--ease-apple);\n}\n\n.preloader.fade-out {\n  opacity: 0;\n  visibility: hidden;\n  pointer-events: none;\n}\n\n.preloader-progress-track {\n  width: 220px;\n  height: 2px;\n  background: var(--border-main);\n  position: relative;\n  overflow: hidden;\n  margin-top: 28px;\n  border-radius: 2px;\n}\n\n.preloader-progress-bar {\n  position: absolute;\n  top: 0;\n  left: 0;\n  height: 100%;\n  width: 0%;\n  background: var(--color-red);\n  box-shadow: 0 0 8px var(--color-red);\n  transition: width 0.05s linear;\n}\n\n.preloader-counter {\n  margin-top: 14px;\n  font-family: var(--font-display);\n  font-size: 0.875rem;\n  font-weight: 700;\n  letter-spacing: 0.05em;\n  color: var(--text-muted);\n}\n\n/* ==========================================================================\n   FIGURAS GEOM\303\211TRICAS DE FONDO (MORPHING SUAVE)\n   ========================================================================== */\n.bg-geometric-container {\n  position: fixed;\n  inset: 0;\n  width: 100%;\n  height: 100%;\n  pointer-events: none;\n  z-index: 0;\n  overflow: hidden;\n}\n\n.geo-shape {\n  position: absolute;\n  transition: transform 1.2s var(--ease-apple),\n              clip-path 1.2s var(--ease-apple),\n              opacity 1s ease,\n              border-radius 1.2s var(--ease-apple);\n  will-change: transform, clip-path, opacity;\n  background: var(--geo-bg);\n  border: 1px solid rgba(220, 38, 38, 0.12);\n}\n\n.shape-circle-1 {\n  width: 500px;\n  height: 500px;\n  top: -100px;\n  right: -100px;\n  border-radius: 50%;\n  opacity: 0.08;\n}\n\n.shape-circle-2 {\n  width: 420px;\n  height: 420px;\n  bottom: -100px;\n  left: -80px;\n  border-radius: 50%;\n  opacity: 0.06;\n}\n\n.shape-diamond-1 {\n  width: 320px;\n  height: 320px;\n  top: 45%;\n  left: 50%;\n  transform: translate(-50%, -50%) rotate(45deg);\n  opacity: 0.04;\n}\n\n.shape-hex-1 {\n  width: 280px;\n  height: 280px;\n  top: 25%;\n  right: 15%;\n  clip-path: polygon(25% 0%, 75% 0%, 100% 50%, 75% 100%, 25% 100%, 0% 50%);\n  opacity: 0.04;\n}\n\n.shape-tri-1 {\n  width: 300px;\n  height: 300px;\n  bottom: 20%;\n  left: 20%;\n  clip-path: polygon(50% 0%, 0% 100%, 100% 100%);\n  opacity: 0.04;\n}\n\n/* ==========================================================================\n   SCROLL REVEAL & ANIMACIONES\n   ========================================================================== */\n.reveal {\n  opacity: 0;\n  transform: translateY(30px);\n  transition: opacity 0.8s var(--ease-apple), transform 0.8s var(--ease-apple);\n  will-change: opacity, transform;\n}\n\n.reveal.active {\n  opacity: 1;\n  transform: translateY(0);\n}\n\n/* Typewriter blinking cursor */\n.typewriter-cursor {\n  display: inline-block;\n  width: 2px;\n  height: 1.1em;\n  background-color: var(--color-red);\n  margin-left: 4px;\n  vertical-align: -2px;\n  animation: blinkCursor 0.8s infinite;\n}\n\n@keyframes blinkCursor {\n  0%, 100% { opacity: 1; }\n  50% { opacity: 0; }\n}\n\n/* ==========================================================================\n   TARJETAS Y CONTENEDORES ESTILO APPLE / AWARDS\n   ========================================================================== */\n.app-card {\n  background: var(--bg-card);\n  border: 1px solid var(--border-main);\n  border-radius: 1rem;\n  box-shadow: var(--shadow-card);\n  transition: transform 0.35s var(--ease-apple), border-color 0.35s ease, box-shadow 0.35s ease, background-color 0.3s ease;\n}\n\n.app-card:hover {\n  transform: translateY(-4px);\n  border-color: var(--border-hover);\n  box-shadow: var(--shadow-hover);\n}\n\n/* Tarjetas de servicios */\n.service-card {\n  position: relative;\n  background: var(--bg-card);\n  border: 1px solid var(--border-main);\n  border-radius: 1.25rem;\n  box-shadow: var(--shadow-card);\n  overflow: hidden;\n  transition: transform 0.4s var(--ease-apple), border-color 0.4s ease, box-shadow 0.4s ease, background-color 0.3s ease;\n}\n\n.service-card:hover {\n  transform: translateY(-5px);\n  border-color: var(--border-hover);\n  box-shadow: var(--shadow-hover);\n}\n\n.service-card::before {\n  content: \'\';\n  position: absolute;\n  top: 0;\n  left: 0;\n  right: 0;\n  height: 2px;\n  background: linear-gradient(90deg, transparent, var(--color-red), transparent);\n  opacity: 0;\n  transition: opacity 0.4s ease;\n}\n\n.service-card:hover::before {\n  opacity: 1;\n}\n\n/* ==========================================================================\n   RADAR DE COBERTURA Y ANILLOS PULSANTES\n   ========================================================================== */\n.radar-ring {\n  position: absolute;\n  top: 50%;\n  left: 50%;\n  transform: translate(-50%, -50%);\n  border-radius: 50%;\n  pointer-events: none;\n}\n\n.radar-ring-1 {\n  width: 480px;\n  height: 480px;\n  border: 1px solid rgba(220, 38, 38, 0.25);\n}\n\n.radar-ring-2 {\n  width: 320px;\n  height: 320px;\n  border: 1px solid rgba(220, 38, 38, 0.18);\n}\n\n.radar-ring-3 {\n  width: 170px;\n  height: 170px;\n  border: 1px solid rgba(220, 38, 38, 0.12);\n}\n\n.radar-point {\n  position: absolute;\n  width: 14px;\n  height: 14px;\n  border-radius: 50%;\n  background-color: var(--color-red);\n  box-shadow: 0 0 14px var(--color-red);\n  cursor: pointer;\n  z-index: 10;\n  transition: transform 0.25s ease;\n}\n\n.radar-point:hover {\n  transform: scale(1.3);\n}\n\n.radar-point::after {\n  content: \'\';\n  position: absolute;\n  inset: -6px;\n  border-radius: 50%;\n  border: 1px solid var(--color-red);\n  animation: ringPulse 2s cubic-bezier(0.16, 1, 0.3, 1) infinite;\n}\n\n@keyframes ringPulse {\n  0% { transform: scale(0.6); opacity: 1; }\n  100% { transform: scale(2.6); opacity: 0; }\n}\n\n/* ==========================================================================\n   TABS INTERACTIVAS (INTRANET & SERVICIOS)\n   ========================================================================== */\n.tab-btn {\n  position: relative;\n  padding: 0.75rem 1.5rem;\n  font-family: var(--font-display);\n  font-size: 0.875rem;\n  font-weight: 600;\n  color: var(--text-muted);\n  border-radius: 0.75rem;\n  transition: all 0.25s ease;\n  cursor: pointer;\n}\n\n.tab-btn:hover {\n  color: var(--text-primary);\n  background-color: var(--bg-tertiary);\n}\n\n.tab-btn.active {\n  color: #FFFFFF;\n  background-color: var(--color-red);\n  box-shadow: 0 4px 12px var(--color-red-glow);\n}\n\n.tab-pane {\n  display: none;\n  animation: fadeInPane 0.35s var(--ease-apple);\n}\n\n.tab-pane.active {\n  display: block;\n}\n\n@keyframes fadeInPane {\n  from { opacity: 0; transform: translateY(8px); }\n  to { opacity: 1; transform: translateY(0); }\n}\n\n/* ==========================================================================\n   ACCORDION (FAQ)\n   ========================================================================== */\n.faq-item {\n  border: 1px solid var(--border-main);\n  border-radius: 0.75rem;\n  background: var(--bg-card);\n  transition: all 0.3s ease;\n  overflow: hidden;\n}\n\n.faq-item.open {\n  border-color: var(--border-hover);\n  box-shadow: var(--shadow-card);\n}\n\n.faq-header {\n  width: 100%;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  padding: 1.25rem 1.5rem;\n  cursor: pointer;\n  font-family: var(--font-display);\n  font-weight: 600;\n  color: var(--text-primary);\n  text-align: left;\n}\n\n.faq-icon {\n  transition: transform 0.3s ease;\n}\n\n.faq-item.open .faq-icon {\n  transform: rotate(180deg);\n  color: var(--color-red);\n}\n\n.faq-body {\n  max-height: 0;\n  overflow: hidden;\n  transition: max-height 0.35s var(--ease-apple), padding 0.35s ease;\n  padding: 0 1.5rem;\n  color: var(--text-secondary);\n  font-size: 0.95rem;\n  line-height: 1.65;\n}\n\n.faq-item.open .faq-body {\n  max-height: 400px;\n  padding: 0 1.5rem 1.25rem 1.5rem;\n}\n\n/* ==========================================================================\n   MODAL DE FICHA T\303\211CNICA & COTIZACI\303\223N\n   ========================================================================== */\n.modal-overlay {\n  position: fixed;\n  inset: 0;\n  background: rgba(0, 0, 0, 0.65);\n  backdrop-filter: blur(8px);\n  -webkit-backdrop-filter: blur(8px);\n  z-index: 9999;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  padding: 1.5rem;\n  opacity: 0;\n  visibility: hidden;\n  transition: opacity 0.3s var(--ease-apple), visibility 0.3s ease;\n}\n\n.modal-overlay.active {\n  opacity: 1;\n  visibility: visible;\n}\n\n.modal-container {\n  background: var(--bg-modal);\n  border: 1px solid var(--border-main);\n  border-radius: 1.25rem;\n  box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);\n  width: 100%;\n  max-width: 680px;\n  max-height: 90vh;\n  overflow-y: auto;\n  transform: scale(0.95) translateY(10px);\n  transition: transform 0.3s var(--ease-apple);\n  color: var(--text-primary);\n}\n\n.modal-overlay.active .modal-container {\n  transform: scale(1) translateY(0);\n}\n\n/* ==========================================================================\n   BOT\303\223N FLOTANTE DE WHATSAPP\n   ========================================================================== */\n.whatsapp-btn {\n  position: fixed;\n  bottom: 28px;\n  right: 28px;\n  width: 58px;\n  height: 58px;\n  background-color: #25D366;\n  border-radius: 50%;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  color: #FFFFFF;\n  box-shadow: 0 8px 24px rgba(37, 211, 102, 0.4);\n  z-index: 70;\n  transform: scale(0);\n  transition: transform 0.4s var(--ease-apple), box-shadow 0.3s ease;\n  text-decoration: none;\n}\n\n.whatsapp-btn.visible {\n  transform: scale(1);\n}\n\n.whatsapp-btn:hover {\n  transform: scale(1.1);\n  box-shadow: 0 12px 30px rgba(37, 211, 102, 0.55);\n}\n\n/* Badge de estado 24/7 */\n.status-indicator {\n  display: inline-flex;\n  align-items: center;\n  gap: 0.5rem;\n  padding: 0.35rem 0.85rem;\n  border-radius: 9999px;\n  background-color: var(--color-badge-bg);\n  border: 1px solid var(--color-badge-border);\n  color: var(--color-red);\n  font-family: var(--font-display);\n  font-size: 0.75rem;\n  font-weight: 700;\n  letter-spacing: 0.05em;\n  text-transform: uppercase;\n}\n\n.status-dot {\n  width: 8px;\n  height: 8px;\n  border-radius: 50%;\n  background-color: var(--color-red);\n  box-shadow: 0 0 8px var(--color-red);\n  animation: statusPulse 1.8s infinite;\n}\n\n@keyframes statusPulse {\n  0%, 100% { opacity: 1; transform: scale(1); }\n  50% { opacity: 0.4; transform: scale(0.85); }\n}\n\n/* ==========================================================================\n   MAGNETIC EFFECT (Clase para JS)\n   ========================================================================== */\n.magnetic-btn {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  transition: transform 0.2s var(--ease-apple), background-color 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;\n  will-change: transform;\n}\n"
    }
