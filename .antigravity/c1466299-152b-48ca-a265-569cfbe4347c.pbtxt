          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  // 3. FIGURAS GEOM\303\211TRICAS DE FONDO & MORPHING POR SECCI\303\223N"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  // ========================================================================="
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const bgContainer = document.getElementById(\'bg-geometric-container\');"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const sectionFlash = document.getElementById(\'section-flash\');"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const sections = ["
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    { id: \'hero\', index: 0 },"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    { id: \'nosotros\', index: 1 },"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    { id: \'servicios\', index: 2 },"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    { id: \'cobertura\', index: 3 },"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    { id: \'flota\', index: 4 },"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    { id: \'estadisticas\', index: 5 },"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    { id: \'contacto\', index: 6 },"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    { id: \'footer\', index: 6 }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  ];"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  let currentSectionIdx = -1;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  function triggerSectionFlash() {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    if (!sectionFlash) return;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    sectionFlash.classList.add(\'active\');"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    setTimeout(() => {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      sectionFlash.classList.remove(\'active\');"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    }, 300);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  function setupSectionObserver() {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const observerOptions = {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      root: null,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      rootMargin: \'-30% 0px -30% 0px\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      threshold: 0"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    };"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const sectionObserver = new IntersectionObserver((entries) => {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      entries.forEach(entry => {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        if (entry.isIntersecting) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          const targetId = entry.target.id;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          const match = sections.find(s => s.id === targetId);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          if (match && match.index !== currentSectionIdx) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            currentSectionIdx = match.index;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            if (bgContainer) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "              bgContainer.setAttribute(\'data-section\', currentSectionIdx.toString());"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            triggerSectionFlash();"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      });"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    }, observerOptions);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    sections.forEach(s => {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      const el = document.getElementById(s.id);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      if (el) sectionObserver.observe(el);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    });"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  setupSectionObserver();"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  // Parallax suave en cada forma usando custom property CSS"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const shape1 = document.querySelector(\'.shape-circle-1\');"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const shape2 = document.querySelector(\'.shape-circle-2\');"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const shape3 = document.querySelector(\'.shape-diamond-1\');"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const shape4 = document.querySelector(\'.shape-hex-1\');"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const shape5 = document.querySelector(\'.shape-tri-1\');"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  function updateParallax(scrollY) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    if (window.innerWidth < 768) return; // Desactivar en mobile para rendimiento"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    if (shape1) shape1.style.marginTop = `${scrollY * 0.04}px`;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    if (shape2) shape2.style.marginBottom = `${scrollY * 0.03}px`;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    if (shape3) shape3.style.marginTop = `${scrollY * 0.02}px`;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    if (shape4) shape4.style.marginTop = `${scrollY * -0.025}px`;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    if (shape5) shape5.style.marginBottom = `${scrollY * -0.03}px`;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  // ========================================================================="
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  // 4. SCROLL REVEAL (IntersectionObserver)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  // ========================================================================="
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const revealElements = document.querySelectorAll(\'.reveal\');"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const revealObserver = new IntersectionObserver((entries, obs) => {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    entries.forEach(entry => {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      if (entry.isIntersecting) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        const el = entry.target;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        // Si pertenece al hero, lo maneja triggerHeroReveal al inicio"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        if (el.closest(\'#hero\')) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          obs.unobserve(el);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          return;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        const delay = parseInt(el.getAttribute(\'data-delay\') || \'0\', 10);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        setTimeout(() => {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          el.classList.add(\'active\');"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        }, delay);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        obs.unobserve(el);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    });"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  }, {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    threshold: 0.15,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    rootMargin: \'0px 0px -50px 0px\'"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  });"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  revealElements.forEach(el => {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    if (!el.closest(\'#hero\')) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      revealObserver.observe(el);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  });"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  // ========================================================================="
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  // 5. CONTADORES NUM\303\211RICOS ANIMADOS (Ease-Out C\303\272bico 2s)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  // ========================================================================="
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const counterElements = document.querySelectorAll(\'[data-target]\');"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  function animateCounter(el) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const target = parseFloat(el.getAttribute(\'data-target\') || \'0\');"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const prefix = el.getAttribute(\'data-prefix\') || \'\';"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const suffix = el.getAttribute(\'data-suffix\') || \'\';"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const duration = 2000; // 2 segundos"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const startTime = performance.now();"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    function step(now) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      const elapsed = now - startTime;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      const progress = Math.min(elapsed / duration, 1);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      // Ease-out c\303\272bico: 1 - Math.pow(1 - progress, 3)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      const easeVal = 1 - Math.pow(1 - progress, 3);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      const currentVal = Math.floor(easeVal * target);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      el.textContent = `${prefix}${currentVal.toLocaleString(\'es-EC\')}${suffix}`;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      if (progress < 1) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        requestAnimationFrame(step);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      } else {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        el.textContent = `${prefix}${target.toLocaleString(\'es-EC\')}${suffix}`;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    requestAnimationFrame(step);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
