    generator_model: MODEL_GOOGLE_GEMINI_INTERNAL_BYOM
    execution_id: "c1466299-152b-48ca-a265-569cfbe4347c"
    source_trajectory_step_info {
      trajectory_id: "c1466299-152b-48ca-a265-569cfbe4347c"
