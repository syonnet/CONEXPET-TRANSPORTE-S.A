          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            <button type=\"button\" class=\"faq-header focus:outline-none\">"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "              <span>\302\277Qu\303\251 p\303\263lizas de seguro respaldan las operaciones y la carga transportada?</span>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "              <svg class=\"w-5 h-5 faq-icon flex-shrink-0 ml-3\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M19 9l-7 7-7-7\"></path>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
