        replacement_content: "    <!-- Script inmediato para evitar FOUC de tema (Default: Light) -->\n    <script>\n      (function() {\n        try {\n          const savedTheme = localStorage.getItem(\'conexpet_theme\') || \'light\';\n          document.documentElement.setAttribute(\'data-theme\', savedTheme);\n        } catch (e) {\n          document.documentElement.setAttribute(\'data-theme\', \'light\');\n        }\n      })();\n    </script>"
      }
