    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "<!doctype html>\n<html lang=\"es\" class=\"scroll-smooth\" data-theme=\"light\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    \n    <!-- Script inmediato para evitar FOUC de tema (Default: Light) -->\n    <script>\n      (function() {\n        const savedTheme = localStorage.getItem(\'conexpet_theme\') || \'light\';\n        document.documentElement.setAttribute(\'data-theme\', savedTheme);\n      })();\n    </script>\n\n    <title>CONEXPET TRANSPORTE S.A. | Potencia Log\303\255stica que Mueve al Ecuador</title>\n    <meta name=\"description\" content=\"CONEXPET TRANSPORTE S.A. - Operador log\303\255stico l\303\255der en el Ecuador para transporte de carga pesada, fluidos vacuum hasta 200 bbl, izaje con gr\303\272as de 120t, movilizaci\303\263n de RIGs y talleres propios.\" />\n    <meta name=\"keywords\" content=\"CONEXPET, transporte carga pesada ecuador, logistica ecuador, transporte de fluidos vacuum, gruas izaje ecuador, transporte petrolero ecuador, lago agrio transporte, quito guayaquil carga, movilizacion rigs ecuador\" />\n    \n    <!-- Open Graph / Redes Sociales -->\n    <meta property=\"og:title\" content=\"CONEXPET TRANSPORTE S.A. | Potencia Log\303\255stica que Mueve al Ecuador\" />\n    <meta property=\"og:description\" content=\"Operador log\303\255stico l\303\255der en el Ecuador para transporte de carga pesada, fluidos vacuum hasta 200 bbl, izaje con gr\303\272as de 120t e infraestructura propia en Lago Agrio.\" />\n    <meta property=\"og:type\" content=\"website\" />\n    <meta property=\"og:url\" content=\"https://conexpet.com\" />\n    <meta property=\"og:image\" content=\"img/logo.png\" />\n    <meta name=\"twitter:card\" content=\"summary_large_image\" />\n    <meta name=\"twitter:title\" content=\"CONEXPET TRANSPORTE S.A. | Potencia Log\303\255stica\" />\n    <meta name=\"twitter:description\" content=\"Transporte de carga pesada, fluidos vacuum e izaje industrial en 24 provincias del Ecuador.\" />\n    <meta name=\"twitter:image\" content=\"img/logo.png\" />\n\n    <!-- Favicon -->\n    <link rel=\"icon\" type=\"image/png\" href=\"img/isotipo.png\" />\n\n    <!-- Google Fonts: Inter Tight & Inter -->\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\" />\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin />\n    <link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Inter+Tight:wght@600;700;800;900&display=swap\" rel=\"stylesheet\" />\n\n    <!-- Tailwind CSS CDN -->\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <script>\n      tailwind.config = {\n        darkMode: [\'selector\', \'[data-theme=\"dark\"]\'],\n        theme: {\n          extend: {\n            colors: {\n              brand: {\n                red: \'#DC2626\',\n                \'red-light\': \'#EF4444\',\n                \'red-dark\': \'#B91C1C\',\n                \'red-glow\': \'rgba(220, 38, 38, 0.25)\'\n              }\n            },\n            fontFamily: {\n              display: [\'\"Inter Tight\"\', \'-apple-system\', \'BlinkMacSystemFont\', \'sans-serif\'],\n              body: [\'Inter\', \'-apple-system\', \'BlinkMacSystemFont\', \'sans-serif\']\n            }\n          }\n        }\n      };\n    </script>\n\n    <!-- Hoja de Estilos de Alto Impacto -->\n    <link rel=\"stylesheet\" href=\"/style.css\" />\n\n    <!-- Script de L\303\263gica e Interactividad -->\n    <script defer src=\"/script.js\"></script>\n  </head>\n  <body class=\"bg-[var(--bg-main)] text-[var(--text-primary)] selection:bg-[#DC2626] selection:text-white relative font-body antialiased transition-colors duration-300\">\n    \n    <!-- =====================================================================\n         PRELOADER CINEMATOGR\303\201FICO\n         ===================================================================== -->\n    <div id=\"preloader\" class=\"preloader\" aria-label=\"Cargando plataforma CONEXPET\">\n      <div class=\"flex flex-col items-center justify-center\">\n        <div class=\"h-12 w-auto flex items-center justify-center mb-3\">\n          <img src=\"img/logo.png\" alt=\"CONEXPET TRANSPORTE S.A.\" class=\"h-10 w-auto object-contain brand-logo-img\" />\n        </div>\n        <div class=\"preloader-progress-track\">\n          <div id=\"preloader-progress-bar\" class=\"preloader-progress-bar\"></div>\n        </div>\n        <div class=\"preloader-counter\">\n          <span id=\"preloader-counter\">0</span><span class=\"text-red-600 font-bold ml-0.5\">%</span>\n        </div>\n      </div>\n    </div>\n\n    <!-- Microtextura y L\303\255nea de Progreso -->\n    <div class=\"noise-overlay\" aria-hidden=\"true\"></div>\n    <div class=\"scroll-progress-container\" aria-hidden=\"true\">\n      <div id=\"scroll-progress-bar\" class=\"scroll-progress-bar\"></div>\n    </div>\n\n    <!-- Custom Cursor en Desktop -->\n    <div class=\"cursor-dot\" aria-hidden=\"true\"></div>\n    <div class=\"cursor-ring\" aria-hidden=\"true\"></div>\n\n    <!-- Formas Geom\303\251tricas Arquitect\303\263nicas de Fondo -->\n    <div class=\"bg-geometric-container\" aria-hidden=\"true\">\n      <div class=\"geo-shape shape-circle-1\"></div>\n      <div class=\"geo-shape shape-circle-2\"></div>\n      <div class=\"geo-shape shape-diamond-1\"></div>\n      <div class=\"geo-shape shape-hex-1\"></div>\n      <div class=\"geo-shape shape-tri-1\"></div>\n    </div>\n\n    <!-- =====================================================================\n         TICKER SUPERIOR DE ESTADO OPERACIONAL EN VIVO\n         ===================================================================== -->\n    <div class=\"bg-slate-900 text-slate-300 text-xs py-2 px-6 border-b border-slate-800 z-50 relative hidden md:block\">\n      <div class=\"max-w-7xl mx-auto flex items-center justify-between\">\n        <div class=\"flex items-center gap-4\">\n          <span class=\"inline-flex items-center gap-2 font-semibold text-emerald-400\">\n            <span class=\"w-2 h-2 rounded-full bg-emerald-400 animate-pulse\"></span>\n            OPERACIONES EN TIEMPO REAL\n          </span>\n          <span class=\"text-slate-500\">|</span>\n          <span>Base Central: Lago Agrio (Sucumb\303\255os)</span>\n          <span class=\"text-slate-500\">|</span>\n          <span>24 Provincias \302\267 Monitoreo Satelital GPS Dual</span>\n        </div>\n        <div class=\"flex items-center gap-6 text-slate-300\">\n          <a href=\"tel:+593999008114\" class=\"hover:text-white transition-colors flex items-center gap-1.5 font-medium\">\n            <svg class=\"w-3.5 h-3.5 text-red-500\" fill=\"currentColor\" viewBox=\"0 0 20 20\">\n              <path d=\"M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 4V3z\"></path>\n            </svg>\n            Despacho 24/7: +593 99 900 8114\n          </a>\n          <a href=\"#intranet\" class=\"text-red-400 hover:text-red-300 font-semibold transition-colors flex items-center gap-1\">\n            Portal Intranet &rarr;\n          </a>\n        </div>\n      </div>\n    </div>\n\n    <!-- =====================================================================\n         BARRA DE NAVEGACI\303\223N PRINCIPAL\n         Fixed top, soporte de fondo din\303\241mico con blur\n         ===================================================================== -->\n    <header id=\"main-nav\" class=\"fixed top-0 md:top-auto left-0 w-full z-50 py-5 transition-all duration-300 bg-[var(--nav-bg)] backdrop-blur-md border-b border-[var(--nav-border)]\">\n      <div class=\"max-w-7xl mx-auto px-6 md:px-12 flex items-center justify-between\">\n        \n        <!-- Logotipo Oficial CONEXPET -->\n        <a href=\"#hero\" id=\"nav-logo\" class=\"flex items-center gap-3 group focus:outline-none\" aria-label=\"CONEXPET Inicio\">\n          <img src=\"img/logo.png\" alt=\"CONEXPET TRANSPORTE S.A.\" class=\"h-9 md:h-11 w-auto object-contain brand-logo-img transition-transform duration-300 group-hover:scale-105\" />\n        </a>\n\n        <!-- Enlaces centrales en Desktop -->\n        <nav class=\"hidden lg:flex items-center gap-7 text-sm font-semibold tracking-tight text-[var(--text-secondary)]\">\n          <a href=\"#empresa\" class=\"hover:text-red-600 dark:hover:text-red-400 transition-colors\">La Empresa</a>\n          <a href=\"#servicios\" class=\"hover:text-red-600 dark:hover:text-red-400 transition-colors\">Servicios</a>\n          <a href=\"#flota\" class=\"hover:text-red-600 dark:hover:text-red-400 transition-colors\">Flota</a>\n          <a href=\"#cobertura\" class=\"hover:text-red-600 dark:hover:text-red-400 transition-colors\">Cobertura</a>\n          <a href=\"#intranet\" class=\"hover:text-red-600 dark:hover:text-red-400 transition-colors\">Intranet</a>\n          <a href=\"#faq\" class=\"hover:text-red-600 dark:hover:text-red-400 transition-colors\">Preguntas</a>\n          <a href=\"#contacto\" class=\"hover:text-red-600 dark:hover:text-red-400 transition-colors\">Contacto</a>\n        </nav>\n\n        <!-- Acciones: Switch Modo Claro/Oscuro + Bot\303\263n Cotizar -->\n        <div class=\"flex items-center gap-3 md:gap-4\">\n          \n          <!-- Bot\303\263n Switch Tema (Claro / Oscuro) -->\n          <button id=\"theme-toggle-btn\" type=\"button\" class=\"w-10 h-10 rounded-full border border-[var(--border-main)] bg-[var(--bg-surface)] text-[var(--text-primary)] hover:border-red-500 flex items-center justify-center transition-all duration-200 focus:outline-none shadow-sm\" aria-label=\"Cambiar modo de color\" title=\"Alternar Modo Claro / Oscuro\">\n            <!-- Icono Sol (se muestra en modo oscuro para pasar a claro) -->\n            <svg class=\"theme-icon-sun w-5 h-5 hidden text-amber-400\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n              <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z\"></path>\n            </svg>\n            <!-- Icono Luna (se muestra en modo claro para pasar a oscuro) -->\n            <svg class=\"theme-icon-moon w-5 h-5 text-slate-700\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n              <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z\"></path>\n            </svg>\n          </button>\n\n          <!-- Bot\303\263n Cotizar Destacado -->\n          <a href=\"#cotizador\" id=\"nav-btn-cotizar\" class=\"magnetic-btn hidden sm:inline-flex items-center justify-center px-5 py-2.5 rounded-full bg-red-600 hover:bg-red-700 text-white text-xs md:text-sm font-bold tracking-wide transition-all duration-300 shadow-md shadow-red-600/25 hover:shadow-red-600/40\">\n            Cotizar Carga\n          </a>\n\n          <!-- Hamburguesa Mobile -->\n          <button id=\"mobile-menu-toggle\" type=\"button\" class=\"lg:hidden flex items-center justify-center w-10 h-10 rounded-full border border-[var(--border-main)] bg-[var(--bg-surface)] text-[var(--text-primary)] focus:outline-none\" aria-label=\"Abrir men\303\272 de navegaci\303\263n\">\n            <svg id=\"hamburger-icon\" class=\"w-5 h-5\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n              <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M4 6h16M4 12h16m-7 6h7\"></path>\n            </svg>\n            <svg id=\"close-icon\" class=\"w-5 h-5 hidden\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n              <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M6 18L18 6M6 6l12 12\"></path>\n            </svg>\n          </button>\n        </div>\n      </div>\n    </header>\n\n    <!-- Men\303\272 Mobile Completo -->\n    <div id=\"mobile-menu\" class=\"fixed inset-0 bg-[var(--bg-main)] z-40 hidden flex flex-col justify-center px-8 lg:hidden\" aria-label=\"Men\303\272 m\303\263vil\">\n      <div class=\"flex flex-col gap-5 text-xl font-bold font-display\">\n        <a href=\"#empresa\" class=\"mobile-nav-link text-[var(--text-primary)] hover:text-red-600 transition-colors\">La Empresa</a>\n        <a href=\"#servicios\" class=\"mobile-nav-link text-[var(--text-primary)] hover:text-red-600 transition-colors\">Servicios Especializados</a>\n        <a href=\"#flota\" class=\"mobile-nav-link text-[var(--text-primary)] hover:text-red-600 transition-colors\">Flota de Veh\303\255culos</a>\n        <a href=\"#cobertura\" class=\"mobile-nav-link text-[var(--text-primary)] hover:text-red-600 transition-colors\">Cobertura Nacional</a>\n        <a href=\"#intranet\" class=\"mobile-nav-link text-[var(--text-primary)] hover:text-red-600 transition-colors\">Hub de Intranet</a>\n        <a href=\"#cotizador\" class=\"mobile-nav-link text-[var(--text-primary)] hover:text-red-600 transition-colors\">Cotizador en L\303\255nea</a>\n        <a href=\"#faq\" class=\"mobile-nav-link text-[var(--text-primary)] hover:text-red-600 transition-colors\">Preguntas Frecuentes</a>\n        <a href=\"#contacto\" class=\"mobile-nav-link text-[var(--text-primary)] hover:text-red-600 transition-colors\">Contacto & Bases</a>\n      </div>\n      \n      <div class=\"mt-8 pt-6 border-t border-[var(--border-main)] flex items-center justify-between\">\n        <button id=\"theme-toggle-mobile-btn\" type=\"button\" class=\"flex items-center gap-2 px-4 py-2 rounded-lg border border-[var(--border-main)] bg-[var(--bg-surface)] text-sm font-semibold\">\n          <span>Cambiar Modo Visual</span>\n        </button>\n        <a href=\"tel:+593999008114\" class=\"text-sm font-bold text-red-600\">\n          Tel: +593 99 900 8114\n        </a>\n      </div>\n    </div>\n\n    <!-- =====================================================================\n         HERO SECTION: FUERZA, AUTORIDAD & M\303\201XIMO IMPACTO VISUAL\n         ===================================================================== -->\n    <section id=\"hero\" class=\"relative pt-36 pb-20 md:pt-48 md:pb-28 overflow-hidden\">\n      <div class=\"max-w-7xl mx-auto px-6 md:px-12 relative z-10\">\n        \n        <!-- Status Indicator Pill -->\n        <div class=\"reveal mb-6 inline-block\">\n          <div class=\"status-indicator\">\n            <span class=\"status-dot\"></span>\n            <span>Sistema Log\303\255stico Activo \302\267 24 Provincias \302\267 Base Matriz Lago Agrio</span>\n          </div>\n        </div>\n\n        <!-- Headline Tit\303\241nico -->\n        <h1 class=\"reveal font-display text-4xl sm:text-6xl md:text-7xl lg:text-8xl font-black tracking-tight leading-[1.05] text-[var(--text-primary)] max-w-6xl mb-6\">\n          POTENCIA LOG\303\215STICA QUE MUEVE AL <span class=\"text-red-600\">ECUADOR</span>\n        </h1>\n\n        <!-- Kinetic Typewriter Service Line -->\n        <div class=\"reveal flex items-center text-lg sm:text-2xl md:text-3xl font-bold font-display text-slate-700 dark:text-zinc-300 mb-8 min-h-[44px]\">\n          <span class=\"text-red-600 mr-2 font-black\">&bull;</span>\n          <span id=\"hero-typewriter-text\" class=\"text-red-700 dark:text-red-400\">Transporte de Fluidos Vacuum hasta 200 bbl</span>\n          <span class=\"typewriter-cursor\"></span>\n        </div>\n\n        <!-- Subheadline de Autoridad Industrial -->\n        <p class=\"reveal text-base sm:text-lg md:text-xl text-[var(--text-secondary)] max-w-3xl leading-relaxed mb-10\">\n          L\303\255deres estrat\303\251gicos en transporte extrapesado, fluidos petroleros e izaje de alta precisi\303\263n para los sectores de hidrocarburos, miner\303\255a e industria pesada del Ecuador. Infraestructura propia en Lago Agrio y monitoreo satelital continuo 24/7.\n        </p>\n\n        <!-- CTA Dual Magnetic Buttons & Fast Response Badge -->\n        <div class=\"reveal flex flex-col sm:flex-row items-stretch sm:items-center gap-4 mb-14\">\n          <a href=\"#cotizador\" class=\"magnetic-btn px-8 py-4 rounded-full bg-red-600 hover:bg-red-700 text-white font-display font-bold text-base tracking-wide transition-all duration-300 shadow-xl shadow-red-600/30 hover:shadow-red-600/50 flex items-center justify-center gap-3\">\n            <span>Solicitar Cotizaci\303\263n de Operaci\303\263n</span>\n            <svg class=\"w-5 h-5 transition-transform duration-200 group-hover:translate-x-1\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n              <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2.5\" d=\"M14 5l7 7m0 0l-7 7m7-7H3\"></path>\n            </svg>\n          </a>\n\n          <a href=\"https://wa.me/593999008114?text=Hola%20CONEXPET,%20necesito%20atenci%C3%B3n%20inmediata%20para%20un%20servicio%20de%20transporte.\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"magnetic-btn px-7 py-4 rounded-full bg-[var(--bg-surface)] hover:bg-[var(--bg-tertiary)] border border-[var(--border-main)] hover:border-red-500 font-display font-bold text-base text-[var(--text-primary)] transition-all duration-300 flex items-center justify-center gap-2.5 shadow-sm\">\n            <span class=\"w-3 h-3 rounded-full bg-emerald-500 animate-pulse\"></span>\n            <span>L\303\255nea Operativa 24/7: +593 99 900 8114</span>\n          </a>\n        </div>\n\n        <!-- Matriz de las 4 Divisiones Centrales (Showcase Interactivo) -->\n        <div class=\"reveal grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-14\">\n          \n          <!-- Card 1: Fluidos Vacuum -->\n          <div class=\"app-card p-5 border-l-4 border-l-red-600 cursor-pointer open-spec-btn\" data-spec=\"vacuum\">\n            <div class=\"flex items-center justify-between mb-2\">\n              <span class=\"text-xs font-bold uppercase tracking-wider text-red-600\">Divisi\303\263n 01</span>\n              <span class=\"text-xs font-semibold px-2 py-0.5 rounded bg-red-100 text-red-700 dark:bg-red-950 dark:text-red-300\">Hasta 200 bbl</span>\n            </div>\n            <h3 class=\"font-display font-bold text-lg text-[var(--text-primary)] mb-1\">Fluidos Vacuum</h3>\n            <p class=\"text-xs text-[var(--text-secondary)]\">Crudo, aguas de formaci\303\263n, lodos de perforaci\303\263n y residuos con bombas de alto vac\303\255o.</p>\n          </div>\n\n          <!-- Card 2: Carga Pesada & RIGs -->\n          <div class=\"app-card p-5 border-l-4 border-l-red-600 cursor-pointer open-spec-btn\" data-spec=\"pesada\">\n            <div class=\"flex items-center justify-between mb-2\">\n              <span class=\"text-xs font-bold uppercase tracking-wider text-red-600\">Divisi\303\263n 02</span>\n              <span class=\"text-xs font-semibold px-2 py-0.5 rounded bg-red-100 text-red-700 dark:bg-red-950 dark:text-red-300\">Camas 80 Tn</span>\n            </div>\n            <h3 class=\"font-display font-bold text-lg text-[var(--text-primary)] mb-1\">Carga Pesada & RIGs</h3>\n            <p class=\"text-xs text-[var(--text-secondary)]\">Movilizaci\303\263n de taladros petroleros, plataformas cama baja, cama cunas y contenedores.</p>\n          </div>\n\n          <!-- Card 3: Izaje con Gr\303\272as -->\n          <div class=\"app-card p-5 border-l-4 border-l-red-600 cursor-pointer open-spec-btn\" data-spec=\"izaje\">\n            <div class=\"flex items-center justify-between mb-2\">\n              <span class=\"text-xs font-bold uppercase tracking-wider text-red-600\">Divisi\303\263n 03</span>\n              <span class=\"text-xs font-semibold px-2 py-0.5 rounded bg-red-100 text-red-700 dark:bg-red-950 dark:text-red-300\">Hasta 120 Tn</span>\n            </div>\n            <h3 class=\"font-display font-bold text-lg text-[var(--text-primary)] mb-1\">Izaje Industrial</h3>\n            <p class=\"text-xs text-[var(--text-secondary)]\">Gr\303\272as telesc\303\263picas y todoterreno con aparejadores certificados y planes de izaje cr\303\255tico.</p>\n          </div>\n\n          <!-- Card 4: Base Lago Agrio -->\n          <div class=\"app-card p-5 border-l-4 border-l-red-600 cursor-pointer open-spec-btn\" data-spec=\"talleres\">\n            <div class=\"flex items-center justify-between mb-2\">\n              <span class=\"text-xs font-bold uppercase tracking-wider text-red-600\">Divisi\303\263n 04</span>\n              <span class=\"text-xs font-semibold px-2 py-0.5 rounded bg-red-100 text-red-700 dark:bg-red-950 dark:text-red-300\">Talleres 24/7</span>\n            </div>\n            <h3 class=\"font-display font-bold text-lg text-[var(--text-primary)] mb-1\">Mantenimiento Propio</h3>\n            <p class=\"text-xs text-[var(--text-secondary)]\">Complejo industrial en Lago Agrio, auxilio mec\303\241nico en ruta y repuestos certificados.</p>\n          </div>\n\n        </div>\n\n        <!-- Barra de Estad\303\255sticas de Alto Impacto -->\n        <div class=\"reveal p-6 md:p-8 rounded-2xl bg-[var(--bg-secondary)] border border-[var(--border-main)] grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-6 text-center shadow-sm\">\n          <div>\n            <div class=\"font-display text-3xl sm:text-4xl lg:text-5xl font-black text-red-600 mb-1\" data-target=\"15\" data-prefix=\"+\">0</div>\n            <div class=\"text-xs sm:text-sm font-semibold text-[var(--text-muted)] uppercase tracking-wider\">A\303\261os de Liderazgo</div>\n          </div>\n          <div>\n            <div class=\"font-display text-3xl sm:text-4xl lg:text-5xl font-black text-[var(--text-primary)] mb-1\" data-target=\"24\">0</div>\n            <div class=\"text-xs sm:text-sm font-semibold text-[var(--text-muted)] uppercase tracking-wider\">Provincias Cobertura</div>\n          </div>\n          <div>\n            <div class=\"font-display text-3xl sm:text-4xl lg:text-5xl font-black text-red-600 mb-1\" data-target=\"120\" data-suffix=\" Tn\">0</div>\n            <div class=\"text-xs sm:text-sm font-semibold text-[var(--text-muted)] uppercase tracking-wider\">Capacidad de Izaje</div>\n          </div>\n          <div>\n            <div class=\"font-display text-3xl sm:text-4xl lg:text-5xl font-black text-[var(--text-primary)] mb-1\" data-target=\"99.8\" data-suffix=\"%\">0</div>\n            <div class=\"text-xs sm:text-sm font-semibold text-[var(--text-muted)] uppercase tracking-wider\">Cumplimiento Operativo</div>\n          </div>\n          <div class=\"col-span-2 sm:col-span-1\">\n            <div class=\"font-display text-3xl sm:text-4xl lg:text-5xl font-black text-emerald-600 mb-1\" data-target=\"0\" data-suffix=\" Inc.\">0</div>\n            <div class=\"text-xs sm:text-sm font-semibold text-[var(--text-muted)] uppercase tracking-wider\">Pol\303\255tica Cero Accidentes</div>\n          </div>\n        </div>\n\n      </div>\n    </section>\n\n    <!-- =====================================================================\n         SECCI\303\223N: LA EMPRESA & GOBERNANZA (SOBRE NOSOTROS)\n         ===================================================================== -->\n    <section id=\"empresa\" class=\"py-24 bg-[var(--bg-secondary)] border-y border-[var(--border-main)] relative\">\n      <div class=\"max-w-7xl mx-auto px-6 md:px-12\">\n        \n        <div class=\"grid grid-cols-1 lg:grid-cols-12 gap-12 items-center\">\n          \n          <div class=\"lg:col-span-5 reveal\">\n            <div class=\"inline-flex items-center gap-2 px-3 py-1 rounded-full bg-red-100 text-red-700 dark:bg-red-950 dark:text-red-300 text-xs font-bold uppercase tracking-wider mb-4\">\n              Trayectoria & Respaldo\n            </div>\n            <h2 class=\"font-display text-3xl sm:text-4xl md:text-5xl font-extrabold text-[var(--text-primary)] leading-tight mb-6\">\n              Nacidos en el Coraz\303\263n de la Amazon\303\255a Petrolera\n            </h2>\n            <p class=\"text-[var(--text-secondary)] leading-relaxed mb-6\">\n              CONEXPET TRANSPORTE S.A. naci\303\263 estrat\303\251gicamente en Lago Agrio (Sucumb\303\255os) con el objetivo de brindar soluciones log\303\255sticas de alta complejidad a las operadoras petroleras, mineras y constructoras m\303\241s exigentes del pa\303\255s.\n            </p>\n            <p class=\"text-[var(--text-secondary)] leading-relaxed mb-8\">\n              Pertenecientes al prestigioso ecosistema corporativo Triboilgas, operamos bajo los m\303\241s estrictos est\303\241ndares de Seguridad, Salud y Ambiente (HSE), garantizando una disponibilidad permanente de equipos y soporte t\303\251cnico las 24 horas del d\303\255a.\n            </p>\n\n            <!-- Sellos de Certificaci\303\263n ISO -->\n            <div class=\"grid grid-cols-3 gap-3 pt-2\">\n              <div class=\"p-3.5 rounded-xl bg-[var(--bg-surface)] border border-[var(--border-main)] text-center\">\n                <span class=\"block text-xs font-bold text-red-600\">ISO 9001</span>\n                <span class=\"text-[11px] text-[var(--text-muted)]\">Gesti\303\263n Calidad</span>\n              </div>\n              <div class=\"p-3.5 rounded-xl bg-[var(--bg-surface)] border border-[var(--border-main)] text-center\">\n                <span class=\"block text-xs font-bold text-emerald-600\">ISO 14001</span>\n                <span class=\"text-[11px] text-[var(--text-muted)]\">Medio Ambiente</span>\n              </div>\n              <div class=\"p-3.5 rounded-xl bg-[var(--bg-surface)] border border-[var(--border-main)] text-center\">\n                <span class=\"block text-xs font-bold text-blue-600\">ISO 45001</span>\n                <span class=\"text-[11px] text-[var(--text-muted)]\">Seguridad HSE</span>\n              </div>\n            </div>\n          </div>\n\n          <!-- Misi\303\263n, Visi\303\263n, Valores Cards -->\n          <div class=\"lg:col-span-7 grid grid-cols-1 sm:grid-cols-2 gap-5 reveal\">\n            \n            <div class=\"app-card p-6\">\n              <div class=\"w-10 h-10 rounded-lg bg-red-100 text-red-600 dark:bg-red-950 dark:text-red-400 flex items-center justify-center font-bold font-display text-lg mb-4\">\n                M\n              </div>\n              <h3 class=\"font-display font-bold text-xl text-[var(--text-primary)] mb-2\">Misi\303\263n</h3>\n              <p class=\"text-sm text-[var(--text-secondary)] leading-relaxed\">\n                Brindar soluciones integrales y seguras de transporte de fluidos, carga extrapesada e izaje industrial, superando las expectativas operacionales de nuestros clientes con tecnolog\303\255a de vanguardia y personal altamente capacitado.\n              </p>\n            </div>\n\n            <div class=\"app-card p-6\">\n              <div class=\"w-10 h-10 rounded-lg bg-red-100 text-red-600 dark:bg-red-950 dark:text-red-400 flex items-center justify-center font-bold font-display text-lg mb-4\">\n                V\n              </div>\n              <h3 class=\"font-display font-bold text-xl text-[var(--text-primary)] mb-2\">Visi\303\263n</h3>\n              <p class=\"text-sm text-[var(--text-secondary)] leading-relaxed\">\n                Consolidarnos como el referente n\303\272mero uno de transporte especializado y log\303\255stica de hidrocarburos en el Ecuador, reconocidos internacionalmente por nuestra pol\303\255tica de cero incidentes y confiabilidad operativa.\n              </p>\n            </div>\n\n            <div class=\"app-card p-6 sm:col-span-2\">\n              <h3 class=\"font-display font-bold text-lg text-[var(--text-primary)] mb-3\">Nuestros Pilares de Valor Corporativo:</h3>\n              <div class=\"grid grid-cols-1 sm:grid-cols-3 gap-4 text-sm text-[var(--text-secondary)]\">\n                <div class=\"flex items-start gap-2.5\">\n                  <span class=\"text-red-600 font-bold text-base\">&check;</span>\n                  <div>\n                    <span class=\"font-bold text-[var(--text-primary)] block\">Seguridad HSE First</span>\n                    <span>Protecci\303\263n intransigente de la vida y el entorno.</span>\n                  </div>\n                </div>\n                <div class=\"flex items-start gap-2.5\">\n                  <span class=\"text-red-600 font-bold text-base\">&check;</span>\n                  <div>\n                    <span class=\"font-bold text-[var(--text-primary)] block\">Puntualidad Cr\303\255tica</span>\n                    <span>Cumplimiento riguroso de itinerarios en pozo.</span>\n                  </div>\n                </div>\n                <div class=\"flex items-start gap-2.5\">\n                  <span class=\"text-red-600 font-bold text-base\">&check;</span>\n                  <div>\n                    <span class=\"font-bold text-[var(--text-primary)] block\">\303\211tica & Transparencia</span>\n                    <span>Tolerancia cero a conductas contrarias a la ley.</span>\n                  </div>\n                </div>\n              </div>\n            </div>\n\n          </div>\n\n        </div>\n\n      </div>\n    </section>\n\n    <!-- =====================================================================\n         SECCI\303\223N: SERVICIOS ESPECIALIZADOS (LOS 4 PILARES)\n         ===================================================================== -->\n    <section id=\"servicios\" class=\"py-24 bg-[var(--bg-main)]\">\n      <div class=\"max-w-7xl mx-auto px-6 md:px-12\">\n        \n        <div class=\"text-center max-w-3xl mx-auto mb-16 reveal\">\n          <div class=\"inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-red-100 text-red-700 dark:bg-red-950 dark:text-red-300 text-xs font-bold uppercase tracking-wider mb-3\">\n            Matriz Operacional Especializada\n          </div>\n          <h2 class=\"font-display text-3xl sm:text-4xl md:text-5xl font-extrabold text-[var(--text-primary)] mb-4\">\n            Servicios Dise\303\261ados para Condiciones Extremas\n          </h2>\n          <p class=\"text-[var(--text-secondary)] text-base md:text-lg\">\n            Equipamiento con especificaci\303\263n petrolera internacional, mantenido en talleres propios y operado por conductores profesionales con certificaciones HazMat y manejo defensivo.\n          </p>\n        </div>\n\n        <div class=\"grid grid-cols-1 md:grid-cols-2 gap-8\">\n          \n          <!-- Servicio 1: Fluidos Vacuum -->\n          <div class=\"service-card p-8 reveal\">\n            <div class=\"flex items-center justify-between mb-4\">\n              <span class=\"px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-red-100 text-red-700 dark:bg-red-950 dark:text-red-300\">\n                Especialidad Hidrocarburos\n              </span>\n              <span class=\"text-sm font-bold text-[var(--text-muted)] font-display\">01</span>\n            </div>\n            <h3 class=\"font-display font-bold text-2xl text-[var(--text-primary)] mb-3\">\n              Transporte de Fluidos Vacuum (Hasta 200 BBL)\n            </h3>\n            <p class=\"text-[var(--text-secondary)] text-sm leading-relaxed mb-5\">\n              Transporte seguro de crudo pesado, aguas de formaci\303\263n, lodos de perforaci\303\263n y aguas residuales industriales en tanqueros de alto vac\303\255o de 150 a 200 barriles equipados con bombas de succi\303\263n certificadas.\n            </p>\n            <ul class=\"space-y-2.5 text-sm text-[var(--text-secondary)] mb-6\">\n              <li class=\"flex items-center gap-2\">\n                <span class=\"w-1.5 h-1.5 rounded-full bg-red-600\"></span>\n                <span>Tolerancia de presi\303\263n negativa y positiva regulada.</span>\n              </li>\n              <li class=\"flex items-center gap-2\">\n                <span class=\"w-1.5 h-1.5 rounded-full bg-red-600\"></span>\n                <span>Kit ambiental antiderrames y mangueras acoplables camlock.</span>\n              </li>\n              <li class=\"flex items-center gap-2\">\n                <span class=\"w-1.5 h-1.5 rounded-full bg-red-600\"></span>\n                <span>Autorizaciones ministeriales y licencias ambientales vigentes.</span>\n              </li>\n            </ul>\n            <div class=\"pt-4 border-t border-[var(--border-main)] flex items-center justify-between\">\n              <button type=\"button\" class=\"open-spec-btn text-sm font-bold text-red-600 hover:text-red-700 flex items-center gap-1.5 transition-colors focus:outline-none\" data-spec=\"vacuum\">\n                <span>Ver Ficha T\303\251cnica Completa</span>\n                <span class=\"text-base\">&rarr;</span>\n              </button>\n              <a href=\"#cotizador\" class=\"text-xs font-semibold px-3 py-1.5 rounded-md bg-[var(--bg-tertiary)] hover:bg-red-600 hover:text-white transition-colors\">\n                Cotizar\n              </a>\n            </div>\n          </div>\n\n          <!-- Servicio 2: Carga Pesada & RIGs -->\n          <div class=\"service-card p-8 reveal\" data-delay=\"100\">\n            <div class=\"flex items-center justify-between mb-4\">\n              <span class=\"px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-red-100 text-red-700 dark:bg-red-950 dark:text-red-300\">\n                Log\303\255stica Extrapesada\n              </span>\n              <span class=\"text-sm font-bold text-[var(--text-muted)] font-display\">02</span>\n            </div>\n            <h3 class=\"font-display font-bold text-2xl text-[var(--text-primary)] mb-3\">\n              Carga Pesada & Movilizaci\303\263n de RIGs\n            </h3>\n            <p class=\"text-[var(--text-secondary)] text-sm leading-relaxed mb-5\">\n              Desmovilizaci\303\263n y movilizaci\303\263n completa de taladros petroleros (Drilling y Workover), tuber\303\255a de producci\303\263n (Casing/Tubing), bombas y maquinaria con camas bajas de 40t a 80t y cama cunas.\n            </p>\n            <ul class=\"space-y-2.5 text-sm text-[var(--text-secondary)] mb-6\">\n              <li class=\"flex items-center gap-2\">\n                <span class=\"w-1.5 h-1.5 rounded-full bg-red-600\"></span>\n                <span>Plataformas Lowboy cuello de ganso hidr\303\241ulico desmontable.</span>\n              </li>\n              <li class=\"flex items-center gap-2\">\n                <span class=\"w-1.5 h-1.5 rounded-full bg-red-600\"></span>\n                <span>Gesti\303\263n integral de permisos de sobrepeso/sobredimensi\303\263n MTOP.</span>\n              </li>\n              <li class=\"flex items-center gap-2\">\n                <span class=\"w-1.5 h-1.5 rounded-full bg-red-600\"></span>\n                <span>Transporte de contenedores secos (Dry) y refrigerados (Reefer).</span>\n              </li>\n            </ul>\n            <div class=\"pt-4 border-t border-[var(--border-main)] flex items-center justify-between\">\n              <button type=\"button\" class=\"open-spec-btn text-sm font-bold text-red-600 hover:text-red-700 flex items-center gap-1.5 transition-colors focus:outline-none\" data-spec=\"pesada\">\n                <span>Ver Ficha T\303\251cnica Completa</span>\n                <span class=\"text-base\">&rarr;</span>\n              </button>\n              <a href=\"#cotizador\" class=\"text-xs font-semibold px-3 py-1.5 rounded-md bg-[var(--bg-tertiary)] hover:bg-red-600 hover:text-white transition-colors\">\n                Cotizar\n              </a>\n            </div>\n          </div>\n\n          <!-- Servicio 3: Izaje con Gr\303\272as -->\n          <div class=\"service-card p-8 reveal\">\n            <div class=\"flex items-center justify-between mb-4\">\n              <span class=\"px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-red-100 text-red-700 dark:bg-red-950 dark:text-red-300\">\n                Maniobras Cr\303\255ticas\n              </span>\n              <span class=\"text-sm font-bold text-[var(--text-muted)] font-display\">03</span>\n            </div>\n            <h3 class=\"font-display font-bold text-2xl text-[var(--text-primary)] mb-3\">\n              Izaje y Montaje Industrial (Hasta 120 Tn)\n            </h3>\n            <p class=\"text-[var(--text-secondary)] text-sm leading-relaxed mb-5\">\n              Flota de gr\303\272as telesc\303\263picas y todo terreno para maniobras de alta complejidad en plantas de procesamiento, locaciones petroleras, puentes y subestaciones el\303\251ctricas.\n            </p>\n            <ul class=\"space-y-2.5 text-sm text-[var(--text-secondary)] mb-6\">\n              <li class=\"flex items-center gap-2\">\n                <span class=\"w-1.5 h-1.5 rounded-full bg-red-600\"></span>\n                <span>Planes de Izaje Cr\303\255tico (Rigging Plans) con c\303\241lculo de radio de carga.</span>\n              </li>\n              <li class=\"flex items-center gap-2\">\n                <span class=\"w-1.5 h-1.5 rounded-full bg-red-600\"></span>\n                <span>Aparejos y eslingas con certificaci\303\263n de prueba de carga vigente.</span>\n              </li>\n              <li class=\"flex items-center gap-2\">\n                <span class=\"w-1.5 h-1.5 rounded-full bg-red-600\"></span>\n                <span>Operadores y riggers con credenciales t\303\251cnicas avaladas.</span>\n              </li>\n            </ul>\n            <div class=\"pt-4 border-t border-[var(--border-main)] flex items-center justify-between\">\n              <button type=\"button\" class=\"open-spec-btn text-sm font-bold text-red-600 hover:text-red-700 flex items-center gap-1.5 transition-colors focus:outline-none\" data-spec=\"izaje\">\n                <span>Ver Ficha T\303\251cnica Completa</span>\n                <span class=\"text-base\">&rarr;</span>\n              </button>\n              <a href=\"#cotizador\" class=\"text-xs font-semibold px-3 py-1.5 rounded-md bg-[var(--bg-tertiary)] hover:bg-red-600 hover:text-white transition-colors\">\n                Cotizar\n              </a>\n            </div>\n          </div>\n\n          <!-- Servicio 4: Talleres y Mantenimiento -->\n          <div class=\"service-card p-8 reveal\" data-delay=\"100\">\n            <div class=\"flex items-center justify-between mb-4\">\n              <span class=\"px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-red-100 text-red-700 dark:bg-red-950 dark:text-red-300\">\n                Soporte de Flota 24/7\n              </span>\n              <span class=\"text-sm font-bold text-[var(--text-muted)] font-display\">04</span>\n            </div>\n            <h3 class=\"font-display font-bold text-2xl text-[var(--text-primary)] mb-3\">\n              Talleres Propios & Mantenimiento Especializado\n            </h3>\n            <p class=\"text-[var(--text-secondary)] text-sm leading-relaxed mb-5\">\n              Infraestructura industrial propia en Lago Agrio para mantenimiento preventivo, correctivo mayor y overhaul de maquinaria pesada, asegurando disponibilidad total de la flota.\n            </p>\n            <ul class=\"space-y-2.5 text-sm text-[var(--text-secondary)] mb-6\">\n              <li class=\"flex items-center gap-2\">\n                <span class=\"w-1.5 h-1.5 rounded-full bg-red-600\"></span>\n                <span>Diagn\303\263stico computarizado de motores diesel pesados (Cummins/Detroit).</span>\n              </li>\n              <li class=\"flex items-center gap-2\">\n                <span class=\"w-1.5 h-1.5 rounded-full bg-red-600\"></span>\n                <span>Stock permanente de repuestos originales certificados.</span>\n              </li>\n              <li class=\"flex items-center gap-2\">\n                <span class=\"w-1.5 h-1.5 rounded-full bg-red-600\"></span>\n                <span>Unidades de rescate mec\303\241nico y auxilio en ruta 24 horas.</span>\n              </li>\n            </ul>\n            <div class=\"pt-4 border-t border-[var(--border-main)] flex items-center justify-between\">\n              <button type=\"button\" class=\"open-spec-btn text-sm font-bold text-red-600 hover:text-red-700 flex items-center gap-1.5 transition-colors focus:outline-none\" data-spec=\"talleres\">\n                <span>Ver Ficha T\303\251cnica Completa</span>\n                <span class=\"text-base\">&rarr;</span>\n              </button>\n              <a href=\"#contacto\" class=\"text-xs font-semibold px-3 py-1.5 rounded-md bg-[var(--bg-tertiary)] hover:bg-red-600 hover:text-white transition-colors\">\n                Asistencia\n              </a>\n            </div>\n          </div>\n\n        </div>\n\n      </div>\n    </section>\n\n    <!-- =====================================================================\n         SECCI\303\223N: FLOTA DE VEH\303\215CULOS (CAT\303\201LOGO INTERACTIVO CON SPECS)\n         ===================================================================== -->\n    <section id=\"flota\" class=\"py-24 bg-[var(--bg-secondary)] border-t border-[var(--border-main)]\">\n      <div class=\"max-w-7xl mx-auto px-6 md:px-12\">\n        \n        <div class=\"flex flex-col md:flex-row md:items-end justify-between mb-12 reveal\">\n          <div>\n            <div class=\"inline-flex items-center gap-2 px-3 py-1 rounded-full bg-red-100 text-red-700 dark:bg-red-950 dark:text-red-300 text-xs font-bold uppercase tracking-wider mb-3\">\n              Ingenier\303\255a Vehicular\n            </div>\n            <h2 class=\"font-display text-3xl sm:text-4xl md:text-5xl font-extrabold text-[var(--text-primary)]\">\n              Flota Pesada & Equipamiento Especializado\n            </h2>\n          </div>\n\n          <!-- Filtros de Flota -->\n          <div class=\"flex items-center gap-2 overflow-x-auto pb-2 mt-6 md:mt-0\">\n            <button type=\"button\" class=\"fleet-filter-btn tab-btn active\" data-filter=\"all\">Todos</button>\n            <button type=\"button\" class=\"fleet-filter-btn tab-btn\" data-filter=\"vacuum\">Tanqueros Vacuum</button>\n            <button type=\"button\" class=\"fleet-filter-btn tab-btn\" data-filter=\"cabezales\">Cabezales 6x4</button>\n            <button type=\"button\" class=\"fleet-filter-btn tab-btn\" data-filter=\"gruas\">Gr\303\272as 120t</button>\n            <button type=\"button\" class=\"fleet-filter-btn tab-btn\" data-filter=\"plataformas\">Camas Bajas</button>\n          </div>\n        </div>\n\n        <!-- Grid de Tarjetas de Flota -->\n        <div id=\"fleet-grid\" class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6\">\n          \n          <!-- Equipo 1: Tanquero Vacuum 200 bbl -->\n          <div class=\"app-card p-6 fleet-card-item reveal\" data-category=\"vacuum\">\n            <div class=\"flex items-center justify-between mb-4\">\n              <span class=\"text-xs font-bold px-2.5 py-1 rounded bg-red-100 text-red-700 dark:bg-red-950 dark:text-red-300\">Vacuum 200 bbl</span>\n              <span class=\"text-xs font-semibold text-emerald-600 flex items-center gap-1\">\n                <span class=\"w-2 h-2 rounded-full bg-emerald-500\"></span> Disponible\n              </span>\n            </div>\n            <h3 class=\"font-display font-bold text-xl text-[var(--text-primary)] mb-1\">Tanquero Vacuum Acero Carbono</h3>\n            <p class=\"text-xs text-[var(--text-muted)] mb-4\">Unidad certificada para fluidos de formaci\303\263n y crudo pesado.</p>\n            \n            <div class=\"space-y-2 text-xs text-[var(--text-secondary)] border-y border-[var(--border-main)] py-3 my-3\">\n              <div class=\"flex justify-between\"><span>Capacidad \303\232til:</span><span class=\"font-bold text-[var(--text-primary)]\">200 Barriles (8.400 Gal)</span></div>\n              <div class=\"flex justify-between\"><span>Bomba de Succi\303\263n:</span><span class=\"font-bold text-[var(--text-primary)]\">Alto Vac\303\255o Presi\303\263n Negativa</span></div>\n              <div class=\"flex justify-between\"><span>Monitoreo:</span><span class=\"font-bold text-[var(--text-primary)]\">GPS Satelital Dual + Sensores</span></div>\n            </div>\n\n            <button type=\"button\" class=\"open-spec-btn w-full mt-2 py-2 rounded-lg bg-[var(--bg-tertiary)] hover:bg-red-600 hover:text-white text-xs font-bold transition-colors\" data-spec=\"vacuum\">\n              Ver Especificaciones T\303\251cnicas\n            </button>\n          </div>\n\n          <!-- Equipo 2: Cabezal Kenworth T800 -->\n          <div class=\"app-card p-6 fleet-card-item reveal\" data-category=\"cabezales\" data-delay=\"100\">\n            <div class=\"flex items-center justify-between mb-4\">\n              <span class=\"text-xs font-bold px-2.5 py-1 rounded bg-red-100 text-red-700 dark:bg-red-950 dark:text-red-300\">Cabezal 6x4</span>\n              <span class=\"text-xs font-semibold text-emerald-600 flex items-center gap-1\">\n                <span class=\"w-2 h-2 rounded-full bg-emerald-500\"></span> Disponible\n              </span>\n            </div>\n            <h3 class=\"font-display font-bold text-xl text-[var(--text-primary)] mb-1\">Kenworth T800 / Mack Granite</h3>\n            <p class=\"text-xs text-[var(--text-muted)] mb-4\">Tractomula de alta potencia configurada para terreno agreste y cordillera.</p>\n            \n            <div class=\"space-y-2 text-xs text-[var(--text-secondary)] border-y border-[var(--border-main)] py-3 my-3\">\n              <div class=\"flex justify-between\"><span>Potencia del Motor:</span><span class=\"font-bold text-[var(--text-primary)]\">500 HP - 550 HP</span></div>\n              <div class=\"flex justify-between\"><span>Configuraci\303\263n de Ejes:</span><span class=\"font-bold text-[var(--text-primary)]\">6x4 con Bloqueo Diferencial</span></div>\n              <div class=\"flex justify-between\"><span>Frenos Auxiliares:</span><span class=\"font-bold text-[var(--text-primary)]\">Jake Brake de 3 Tiempos</span></div>\n            </div>\n\n            <button type=\"button\" class=\"open-spec-btn w-full mt-2 py-2 rounded-lg bg-[var(--bg-tertiary)] hover:bg-red-600 hover:text-white text-xs font-bold transition-colors\" data-spec=\"pesada\">\n              Ver Especificaciones T\303\251cnicas\n            </button>\n          </div>\n\n          <!-- Equipo 3: Gr\303\272a Telesc\303\263pica 120 Tn -->\n          <div class=\"app-card p-6 fleet-card-item reveal\" data-category=\"gruas\" data-delay=\"200\">\n            <div class=\"flex items-center justify-between mb-4\">\n              <span class=\"text-xs font-bold px-2.5 py-1 rounded bg-red-100 text-red-700 dark:bg-red-950 dark:text-red-300\">Gr\303\272a 120 Ton</span>\n              <span class=\"text-xs font-semibold text-emerald-600 flex items-center gap-1\">\n                <span class=\"w-2 h-2 rounded-full bg-emerald-500\"></span> Disponible\n              </span>\n            </div>\n            <h3 class=\"font-display font-bold text-xl text-[var(--text-primary)] mb-1\">Liebherr / Grove Todoterreno</h3>\n            <p class=\"text-xs text-[var(--text-muted)] mb-4\">Gr\303\272a telesc\303\263pica de gran tonelaje para montajes industriales y maniobras cr\303\255ticas.</p>\n            \n            <div class=\"space-y-2 text-xs text-[var(--text-secondary)] border-y border-[var(--border-main)] py-3 my-3\">\n              <div class=\"flex justify-between\"><span>Capacidad Nominal:</span><span class=\"font-bold text-[var(--text-primary)]\">120 Toneladas</span></div>\n              <div class=\"flex justify-between\"><span>Longitud de Pluma:</span><span class=\"font-bold text-[var(--text-primary)]\">Hasta 60 Metros + Plum\303\255n</span></div>\n              <div class=\"flex justify-between\"><span>Certificaci\303\263n:</span><span class=\"font-bold text-[var(--text-primary)]\">Inspecci\303\263n Estructural Vigente</span></div>\n            </div>\n\n            <button type=\"button\" class=\"open-spec-btn w-full mt-2 py-2 rounded-lg bg-[var(--bg-tertiary)] hover:bg-red-600 hover:text-white text-xs font-bold transition-colors\" data-spec=\"izaje\">\n              Ver Especificaciones T\303\251cnicas\n            </button>\n          </div>\n\n          <!-- Equipo 4: Lowboy Cama Baja 80 Tn -->\n          <div class=\"app-card p-6 fleet-card-item reveal\" data-category=\"plataformas\">\n            <div class=\"flex items-center justify-between mb-4\">\n              <span class=\"text-xs font-bold px-2.5 py-1 rounded bg-red-100 text-red-700 dark:bg-red-950 dark:text-red-300\">Cama Baja 80 Tn</span>\n              <span class=\"text-xs font-semibold text-emerald-600 flex items-center gap-1\">\n                <span class=\"w-2 h-2 rounded-full bg-emerald-500\"></span> Disponible\n              </span>\n            </div>\n            <h3 class=\"font-display font-bold text-xl text-[var(--text-primary)] mb-1\">Lowboy Cuello de Ganso Desmontable</h3>\n            <p class=\"text-xs text-[var(--text-muted)] mb-4\">Plataforma deprimida para maquinaria extrapesada, excavadoras y taladros.</p>\n            \n            <div class=\"space-y-2 text-xs text-[var(--text-secondary)] border-y border-[var(--border-main)] py-3 my-3\">\n              <div class=\"flex justify-between\"><span>Capacidad de Carga:</span><span class=\"font-bold text-[var(--text-primary)]\">Hasta 80 Toneladas</span></div>\n              <div class=\"flex justify-between\"><span>Ejes / Suspensi\303\263n:</span><span class=\"font-bold text-[var(--text-primary)]\">3 Ejes Reforzados / Neum\303\241tica</span></div>\n              <div class=\"flex justify-between\"><span>Altura de Plataforma:</span><span class=\"font-bold text-[var(--text-primary)]\">0.65 m (Facilidad de Carga)</span></div>\n            </div>\n\n            <button type=\"button\" class=\"open-spec-btn w-full mt-2 py-2 rounded-lg bg-[var(--bg-tertiary)] hover:bg-red-600 hover:text-white text-xs font-bold transition-colors\" data-spec=\"pesada\">\n              Ver Especificaciones T\303\251cnicas\n            </button>\n          </div>\n\n          <!-- Equipo 5: Cama Cuna para Tuber\303\255as -->\n          <div class=\"app-card p-6 fleet-card-item reveal\" data-category=\"plataformas\" data-delay=\"100\">\n            <div class=\"flex items-center justify-between mb-4\">\n              <span class=\"text-xs font-bold px-2.5 py-1 rounded bg-red-100 text-red-700 dark:bg-red-950 dark:text-red-300\">Cama Cuna</span>\n              <span class=\"text-xs font-semibold text-emerald-600 flex items-center gap-1\">\n                <span class=\"w-2 h-2 rounded-full bg-emerald-500\"></span> Disponible\n              </span>\n            </div>\n            <h3 class=\"font-display font-bold text-xl text-[var(--text-primary)] mb-1\">Plataforma Cama Cuna para Tuber\303\255a</h3>\n            <p class=\"text-xs text-[var(--text-muted)] mb-4\">Especializada en traslado seguro de tuber\303\255a de perforaci\303\263n (Drill Pipe / Casing).</p>\n            \n            <div class=\"space-y-2 text-xs text-[var(--text-secondary)] border-y border-[var(--border-main)] py-3 my-3\">\n              <div class=\"flex justify-between\"><span>Capacidad:</span><span class=\"font-bold text-[var(--text-primary)]\">45 Toneladas</span></div>\n              <div class=\"flex justify-between\"><span>Dispositivos de Amarre:</span><span class=\"font-bold text-[var(--text-primary)]\">Fajas Tensoras y Candados Grado 80</span></div>\n              <div class=\"flex justify-between\"><span>Seguridad en Curvas:</span><span class=\"font-bold text-[var(--text-primary)]\">Puntales Laterales Antivuelco</span></div>\n            </div>\n\n            <button type=\"button\" class=\"open-spec-btn w-full mt-2 py-2 rounded-lg bg-[var(--bg-tertiary)] hover:bg-red-600 hover:text-white text-xs font-bold transition-colors\" data-spec=\"pesada\">\n              Ver Especificaciones T\303\251cnicas\n            </button>\n          </div>\n\n          <!-- Equipo 6: Tanquero Vacuum 150 bbl -->\n          <div class=\"app-card p-6 fleet-card-item reveal\" data-category=\"vacuum\" data-delay=\"200\">\n            <div class=\"flex items-center justify-between mb-4\">\n              <span class=\"text-xs font-bold px-2.5 py-1 rounded bg-red-100 text-red-700 dark:bg-red-950 dark:text-red-300\">Vacuum 150 bbl</span>\n              <span class=\"text-xs font-semibold text-emerald-600 flex items-center gap-1\">\n                <span class=\"w-2 h-2 rounded-full bg-emerald-500\"></span> Disponible\n              </span>\n            </div>\n            <h3 class=\"font-display font-bold text-xl text-[var(--text-primary)] mb-1\">Tanquero Vacuum Maniobra R\303\241pida</h3>\n            <p class=\"text-xs text-[var(--text-muted)] mb-4\">Dise\303\261ado para locaciones de dif\303\255cil acceso y caminos de tercer orden.</p>\n            \n            <div class=\"space-y-2 text-xs text-[var(--text-secondary)] border-y border-[var(--border-main)] py-3 my-3\">\n              <div class=\"flex justify-between\"><span>Capacidad \303\232til:</span><span class=\"font-bold text-[var(--text-primary)]\">150 Barriles (6.300 Gal)</span></div>\n              <div class=\"flex justify-between\"><span>Tracci\303\263n:</span><span class=\"font-bold text-[var(--text-primary)]\">Doble Corona con Bloqueo</span></div>\n              <div class=\"flex justify-between\"><span>Bomba Auxiliar:</span><span class=\"font-bold text-[var(--text-primary)]\">Descarga R\303\241pida por Gravedad/Presi\303\263n</span></div>\n            </div>\n\n            <button type=\"button\" class=\"open-spec-btn w-full mt-2 py-2 rounded-lg bg-[var(--bg-tertiary)] hover:bg-red-600 hover:text-white text-xs font-bold transition-colors\" data-spec=\"vacuum\">\n              Ver Especificaciones T\303\251cnicas\n            </button>\n          </div>\n\n        </div>\n\n      </div>\n    </section>\n\n    <!-- =====================================================================\n         SECCI\303\223N: RADAR LOG\303\215STICO & COBERTURA NACIONAL (MAPA INTERACTIVO)\n         ===================================================================== -->\n    <section id=\"cobertura\" class=\"py-24 bg-[var(--bg-main)] relative overflow-hidden\">\n      <div class=\"max-w-7xl mx-auto px-6 md:px-12\">\n        \n        <div class=\"text-center max-w-3xl mx-auto mb-16 reveal\">\n          <div class=\"inline-flex items-center gap-2 px-3 py-1 rounded-full bg-red-100 text-red-700 dark:bg-red-950 dark:text-red-300 text-xs font-bold uppercase tracking-wider mb-3\">\n            Presencia Estrat\303\251gica Nacional\n          </div>\n          <h2 class=\"font-display text-3xl sm:text-4xl md:text-5xl font-extrabold text-[var(--text-primary)] mb-4\">\n            Radar de Cobertura en las 24 Provincias\n          </h2>\n          <p class=\"text-[var(--text-secondary)] text-base md:text-lg\">\n            Conexi\303\263n directa entre los principales puertos del Pac\303\255fico, centros industriales de la Sierra y bloques petroleros de la Amazon\303\255a ecuatoriana.\n          </p>\n        </div>\n\n        <div class=\"grid grid-cols-1 lg:grid-cols-12 gap-8 items-center\">\n          \n          <!-- Radar Interactivo Visual -->\n          <div class=\"lg:col-span-7 app-card p-6 md:p-8 relative min-h-[480px] flex items-center justify-center overflow-hidden reveal\">\n            \n            <!-- Anillos Conc\303\251ntricos de Cobertura -->\n            <div class=\"radar-ring radar-ring-1\"></div>\n            <div class=\"radar-ring radar-ring-2\"></div>\n            <div class=\"radar-ring radar-ring-3\"></div>\n\n            <!-- Mapa Esquem\303\241tico de Ecuador (SVG) -->\n            <svg class=\"w-full max-w-[420px] h-auto opacity-75 drop-shadow\" viewBox=\"0 0 400 350\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n              <!-- Contorno simplificado de Ecuador -->\n              <path d=\"M70,80 Q120,40 190,40 Q260,30 330,80 Q350,150 320,240 Q250,310 180,330 Q120,320 80,260 Q50,180 70,80 Z\" fill=\"currentColor\" class=\"text-slate-200 dark:text-zinc-800\" stroke=\"currentColor\" stroke-width=\"2\" class=\"text-red-500/20\" />\n              <!-- L\303\255neas de Corredores Troncales -->\n              <line x1=\"285\" y1=\"85\" x2=\"190\" y2=\"105\" stroke=\"#DC2626\" stroke-width=\"2.5\" stroke-dasharray=\"4,4\" />\n              <line x1=\"190\" y1=\"105\" x2=\"135\" y2=\"230\" stroke=\"#DC2626\" stroke-width=\"2.5\" stroke-dasharray=\"4,4\" />\n              <line x1=\"135\" y1=\"230\" x2=\"175\" y2=\"275\" stroke=\"#DC2626\" stroke-width=\"2\" stroke-dasharray=\"3,3\" />\n              <line x1=\"285\" y1=\"85\" x2=\"310\" y2=\"120\" stroke=\"#DC2626\" stroke-width=\"2.5\" />\n            </svg>\n\n            <!-- Nodos Pulsantes de Ciudades Clave -->\n            <!-- 1. Lago Agrio (Base Matriz) -->\n            <div class=\"radar-point\" style=\"top: 24%; left: 72%;\" data-city=\"Lago Agrio (Sucumb\303\255os)\" data-city-key=\"lago-agrio\" data-info=\"Base Central de Operaciones & Talleres Propios 24/7.\"></div>\n            \n            <!-- 2. Coca (Orellana) -->\n            <div class=\"radar-point\" style=\"top: 34%; left: 78%;\" data-city=\"El Coca (Orellana)\" data-city-key=\"coca\" data-info=\"Eje log\303\255stico de bloques petroleros amaz\303\263nicos.\"></div>\n\n            <!-- 3. Shushufindi -->\n            <div class=\"radar-point\" style=\"top: 27%; left: 81%;\" data-city=\"Shushufindi\" data-city-key=\"shushufindi\" data-info=\"Cobertura directa a campos y bater\303\255as de crudo.\"></div>\n\n            <!-- 4. Quito (Sede Administrativa) -->\n            <div class=\"radar-point\" style=\"top: 30%; left: 48%;\" data-city=\"Quito (Pichincha)\" data-city-key=\"quito\" data-info=\"Oficinas Administrativas & Enlace Institucional.\"></div>\n\n            <!-- 5. Guayaquil (Hub Portuario) -->\n            <div class=\"radar-point\" style=\"top: 65%; left: 34%;\" data-city=\"Guayaquil (Guayas)\" data-city-key=\"guayaquil\" data-info=\"Hub de carga pesada, importaci\303\263n y contenedores portuarios.\"></div>\n\n            <!-- 6. Cuenca (Hub Austral) -->\n            <div class=\"radar-point\" style=\"top: 78%; left: 44%;\" data-city=\"Cuenca (Azuay)\" data-city-key=\"cuenca\" data-info=\"Conexi\303\263n industrial con el Austro y proyectos mineros.\"></div>\n\n            <!-- 7. Manta -->\n            <div class=\"radar-point\" style=\"top: 50%; left: 24%;\" data-city=\"Manta (Manab\303\255)\" data-city-key=\"manta\" data-info=\"Puerto de aguas profundas y log\303\255stica costera.\"></div>\n\n            <!-- Tooltip Flotante del Radar -->\n            <div id=\"radar-city-tooltip\" class=\"absolute bottom-4 left-4 right-4 py-2.5 px-4 rounded-lg bg-[var(--bg-surface)] border border-[var(--border-main)] text-xs text-[var(--text-secondary)] opacity-0 transition-opacity duration-200 pointer-events-none shadow-lg text-center font-medium\">\n              Haz clic sobre un nodo para calcular la ruta en el cotizador\n            </div>\n\n          </div>\n\n          <!-- Informaci\303\263n de Corredores Troncales -->\n          <div class=\"lg:col-span-5 space-y-4 reveal\" data-delay=\"100\">\n            <h3 class=\"font-display font-bold text-2xl text-[var(--text-primary)] mb-2\">\n              Corredores Troncales Monitoreados\n            </h3>\n            <p class=\"text-sm text-[var(--text-secondary)] mb-4\">\n              Cada convoy cuenta con seguimiento satelital dual en tiempo real, comunicaci\303\263n por radiofrecuencia, escoltas privadas en tramos cr\303\255ticos y botones de p\303\241nico conectados a centrales de seguridad.\n            </p>\n\n            <div class=\"p-4 rounded-xl bg-[var(--bg-surface)] border border-[var(--border-main)]\">\n              <span class=\"text-xs font-bold text-red-600 uppercase tracking-wider block mb-1\">Eje 1: Corredor Petrolero Amaz\303\263nico</span>\n              <p class=\"text-xs text-[var(--text-secondary)]\">Lago Agrio &harr; El Coca &harr; Shushufindi &harr; Sacha &harr; Bloques ITT / Tarapoa.</p>\n            </div>\n\n            <div class=\"p-4 rounded-xl bg-[var(--bg-surface)] border border-[var(--border-main)]\">\n              <span class=\"text-xs font-bold text-red-600 uppercase tracking-wider block mb-1\">Eje 2: Conexi\303\263n Costa - Sierra - Oriente</span>\n              <p class=\"text-xs text-[var(--text-secondary)]\">Guayaquil &harr; Santo Domingo &harr; Quito &harr; Papallacta &harr; Lago Agrio.</p>\n            </div>\n\n            <div class=\"p-4 rounded-xl bg-[var(--bg-surface)] border border-[var(--border-main)]\">\n              <span class=\"text-xs font-bold text-red-600 uppercase tracking-wider block mb-1\">Eje 3: Corredor Minero e Industrial Austral</span>\n              <p class=\"text-xs text-[var(--text-secondary)]\">Cuenca &harr; Machala &harr; Zamora &harr; Proyectos Fruta del Norte / Mirador.</p>\n            </div>\n\n            <div class=\"pt-2\">\n              <a href=\"#cotizador\" class=\"inline-flex items-center gap-2 text-sm font-bold text-red-600 hover:text-red-700\">\n                <span>Calcular distancia y tiempo entre ciudades</span>\n                <span>&darr;</span>\n              </a>\n            </div>\n          </div>\n\n        </div>\n\n      </div>\n    </section>\n\n    <!-- =====================================================================\n         SECCI\303\223N: HUB DE INTRANET & PORTALES CORPORATIVOS (SITEMAP OFICIAL)\n         ===================================================================== -->\n    <section id=\"intranet\" class=\"py-24 bg-[var(--bg-secondary)] border-y border-[var(--border-main)]\">\n      <div class=\"max-w-7xl mx-auto px-6 md:px-12\">\n        \n        <div class=\"text-center max-w-3xl mx-auto mb-12 reveal\">\n          <div class=\"inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-red-100 text-red-700 dark:bg-red-950 dark:text-red-300 text-xs font-bold uppercase tracking-wider mb-3\">\n            Accesos Corporativos Oficiales\n          </div>\n          <h2 class=\"font-display text-3xl sm:text-4xl md:text-5xl font-extrabold text-[var(--text-primary)] mb-4\">\n            Ecosistema de Intranet & Portales\n          </h2>\n          <p class=\"text-[var(--text-secondary)] text-base md:text-lg\">\n            Herramientas operativas, de recursos humanos y plataformas de gesti\303\263n para colaboradores, clientes y proveedores del grupo CONEXPET.\n          </p>\n        </div>\n\n        <!-- Selector de Pesta\303\261as: RRHH vs Operaciones -->\n        <div class=\"flex items-center justify-center gap-3 mb-10 reveal\">\n          <button type=\"button\" class=\"intranet-tab-btn tab-btn active\" data-tab=\"tab-rrhh\">\n            Talento Humano (RRHH & HSE)\n          </button>\n          <button type=\"button\" class=\"intranet-tab-btn tab-btn\" data-tab=\"tab-operaciones\">\n            Operaciones, TI & Proveedores\n          </button>\n        </div>\n\n        <!-- Contenido Pesta\303\261a 1: RRHH & HSE -->\n        <div id=\"tab-rrhh\" class=\"intranet-tab-pane tab-pane active\">\n          <div class=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6\">\n            \n            <!-- Tarjeta Cero (HSE) -->\n            <div class=\"app-card p-6 flex flex-col justify-between\">\n              <div>\n                <div class=\"w-10 h-10 rounded-lg bg-red-100 text-red-600 dark:bg-red-950 dark:text-red-400 flex items-center justify-center font-bold font-display text-lg mb-4\">\n                  0\n                </div>\n                <h4 class=\"font-display font-bold text-lg text-[var(--text-primary)] mb-2\">Tarjeta Cero (HSE)</h4>\n                <p class=\"text-xs text-[var(--text-secondary)] leading-relaxed mb-6\">\n                  Reporte preventivo obligatorio de actos y condiciones subest\303\241ndar para mantener la meta de cero accidentes laborales.\n                </p>\n              </div>\n              <a href=\"https://forms.office.com/pages/responsepage.aspx?id=DQSIkWdsW0yxEjajBLZtrQAAAAAAAAAAAANAAd1l-hVUMlZaNkpSMDVZNDg3Uk1FT1hZSkFNTTRXTi4u\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"w-full py-2.5 px-4 rounded-lg bg-red-600 hover:bg-red-700 text-white text-xs font-bold text-center transition-colors shadow-sm\">\n                Registrar Tarjeta Cero &rarr;\n              </a>\n            </div>\n\n            <!-- Compers TTHH -->\n            <div class=\"app-card p-6 flex flex-col justify-between\">\n              <div>\n                <div class=\"w-10 h-10 rounded-lg bg-slate-100 text-slate-800 dark:bg-zinc-800 dark:text-white flex items-center justify-center font-bold font-display text-lg mb-4\">\n                  C\n                </div>\n                <h4 class=\"font-display font-bold text-lg text-[var(--text-primary)] mb-2\">Compers TTHH</h4>\n                <p class=\"text-xs text-[var(--text-secondary)] leading-relaxed mb-6\">\n                  Portal corporativo de evaluaci\303\263n del desempe\303\261o, competencias laborales y planes de carrera para colaboradores.\n                </p>\n              </div>\n              <a href=\"https://compers.triboilgas.com\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"w-full py-2.5 px-4 rounded-lg bg-[var(--bg-tertiary)] hover:bg-[var(--border-main)] text-[var(--text-primary)] text-xs font-bold text-center transition-colors\">\n                Acceder a Compers &rarr;\n              </a>\n            </div>\n\n            <!-- Solicitudes TTHH -->\n            <div class=\"app-card p-6 flex flex-col justify-between\">\n              <div>\n                <div class=\"w-10 h-10 rounded-lg bg-slate-100 text-slate-800 dark:bg-zinc-800 dark:text-white flex items-center justify-center font-bold font-display text-lg mb-4\">\n                  S\n                </div>\n                <h4 class=\"font-display font-bold text-lg text-[var(--text-primary)] mb-2\">Solicitudes TTHH</h4>\n                <p class=\"text-xs text-[var(--text-secondary)] leading-relaxed mb-6\">\n                  Gesti\303\263n digital de permisos, solicitudes de vacaciones, certificados de trabajo y tr\303\241mites de talento humano.\n                </p>\n              </div>\n              <a href=\"https://triboilgas.com\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"w-full py-2.5 px-4 rounded-lg bg-[var(--bg-tertiary)] hover:bg-[var(--border-main)] text-[var(--text-primary)] text-xs font-bold text-center transition-colors\">\n                Portal de Solicitudes &rarr;\n              </a>\n            </div>\n\n            <!-- Encuesta M\303\251dica -->\n            <div class=\"app-card p-6 flex flex-col justify-between\">\n              <div>\n                <div class=\"w-10 h-10 rounded-lg bg-emerald-100 text-emerald-700 dark:bg-emerald-950 dark:text-emerald-300 flex items-center justify-center font-bold font-display text-lg mb-4\">\n                  +\n                </div>\n                <h4 class=\"font-display font-bold text-lg text-[var(--text-primary)] mb-2\">Encuesta M\303\251dica</h4>\n                <p class=\"text-xs text-[var(--text-secondary)] leading-relaxed mb-6\">\n                  Monitoreo de salud ocupacional, aptitud f\303\255sica de conductores y seguimiento del departamento m\303\251dico interno.\n                </p>\n              </div>\n              <a href=\"https://triboilgas.com\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"w-full py-2.5 px-4 rounded-lg bg-[var(--bg-tertiary)] hover:bg-[var(--border-main)] text-[var(--text-primary)] text-xs font-bold text-center transition-colors\">\n                Llenar Formulario &rarr;\n              </a>\n            </div>\n\n          </div>\n        </div>\n\n        <!-- Contenido Pesta\303\261a 2: Operaciones & Sistemas -->\n        <div id=\"tab-operaciones\" class=\"intranet-tab-pane tab-pane\">\n          <div class=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6\">\n            \n            <!-- JD Edwards ERP -->\n            <div class=\"app-card p-6 flex flex-col justify-between\">\n              <div>\n                <div class=\"w-10 h-10 rounded-lg bg-red-100 text-red-600 dark:bg-red-950 dark:text-red-400 flex items-center justify-center font-bold font-display text-lg mb-4\">\n                  JD\n                </div>\n                <h4 class=\"font-display font-bold text-lg text-[var(--text-primary)] mb-2\">ERP JD Edwards</h4>\n                <p class=\"text-xs text-[var(--text-secondary)] leading-relaxed mb-6\">\n                  Sistema central Oracle ERP para gesti\303\263n de despachos, \303\263rdenes de servicio, inventario de flota y facturaci\303\263n.\n                </p>\n              </div>\n              <a href=\"http://64.190.27.46:8040\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"w-full py-2.5 px-4 rounded-lg bg-red-600 hover:bg-red-700 text-white text-xs font-bold text-center transition-colors shadow-sm\">\n                Ingresar a JD Edwards &rarr;\n              </a>\n            </div>\n\n            <!-- Mesa de Ayuda Hesk -->\n            <div class=\"app-card p-6 flex flex-col justify-between\">\n              <div>\n                <div class=\"w-10 h-10 rounded-lg bg-slate-100 text-slate-800 dark:bg-zinc-800 dark:text-white flex items-center justify-center font-bold font-display text-lg mb-4\">\n                  TI\n                </div>\n                <h4 class=\"font-display font-bold text-lg text-[var(--text-primary)] mb-2\">Soporte T\303\251cnico Hesk</h4>\n                <p class=\"text-xs text-[var(--text-secondary)] leading-relaxed mb-6\">\n                  Sistema de tickets de ayuda t\303\251cnica, soporte para hardware, software de rastreo GPS y telecomunicaciones.\n                </p>\n              </div>\n              <a href=\"https://soporte.triboilgas.com\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"w-full py-2.5 px-4 rounded-lg bg-[var(--bg-tertiary)] hover:bg-[var(--border-main)] text-[var(--text-primary)] text-xs font-bold text-center transition-colors\">\n                Crear Ticket Hesk &rarr;\n              </a>\n            </div>\n\n            <!-- SYSFIN Proveedores -->\n            <div class=\"app-card p-6 flex flex-col justify-between\">\n              <div>\n                <div class=\"w-10 h-10 rounded-lg bg-blue-100 text-blue-700 dark:bg-blue-950 dark:text-blue-300 flex items-center justify-center font-bold font-display text-lg mb-4\">\n                  $\n                </div>\n                <h4 class=\"font-display font-bold text-lg text-[var(--text-primary)] mb-2\">Portal SYSFIN</h4>\n                <p class=\"text-xs text-[var(--text-secondary)] leading-relaxed mb-6\">\n                  Portal para proveedores: carga de facturas electr\303\263nicas, consulta de retenciones y cronograma de pagos.\n                </p>\n              </div>\n              <a href=\"https://sysfin.triboilgas.com\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"w-full py-2.5 px-4 rounded-lg bg-[var(--bg-tertiary)] hover:bg-[var(--border-main)] text-[var(--text-primary)] text-xs font-bold text-center transition-colors\">\n                Portal Proveedores &rarr;\n              </a>\n            </div>\n\n            <!-- Canal de Denuncias / \303\211tico -->\n            <div class=\"app-card p-6 flex flex-col justify-between\">\n              <div>\n                <div class=\"w-10 h-10 rounded-lg bg-amber-100 text-amber-700 dark:bg-amber-950 dark:text-amber-300 flex items-center justify-center font-bold font-display text-lg mb-4\">\n                  !\n                </div>\n                <h4 class=\"font-display font-bold text-lg text-[var(--text-primary)] mb-2\">Canal de Denuncias</h4>\n                <p class=\"text-xs text-[var(--text-secondary)] leading-relaxed mb-6\">\n                  L\303\255nea confidencial e independiente para reportes de \303\251tica, cumplimiento legal y conductas inapropiadas.\n                </p>\n              </div>\n              <a href=\"https://triboilgas.typeform.com/to/W432lF\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"w-full py-2.5 px-4 rounded-lg bg-amber-600 hover:bg-amber-700 text-white text-xs font-bold text-center transition-colors\">\n                Reporte Confidencial &rarr;\n              </a>\n            </div>\n\n          </div>\n        </div>\n\n      </div>\n    </section>\n\n    <!-- =====================================================================\n         SECCI\303\223N: COTIZADOR INTELIGENTE EN VIVO (CALCULADORA DE FLETES)\n         ===================================================================== -->\n    <section id=\"cotizador\" class=\"py-24 bg-[var(--bg-main)]\">\n      <div class=\"max-w-7xl mx-auto px-6 md:px-12\">\n        \n        <div class=\"text-center max-w-3xl mx-auto mb-16 reveal\">\n          <div class=\"inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-red-100 text-red-700 dark:bg-red-950 dark:text-red-300 text-xs font-bold uppercase tracking-wider mb-3\">\n            Tarificaci\303\263n & Estimaci\303\263n\n          </div>\n          <h2 class=\"font-display text-3xl sm:text-4xl md:text-5xl font-extrabold text-[var(--text-primary)] mb-4\">\n            Cotizador Log\303\255stico en Tiempo Real\n          </h2>\n          <p class=\"text-[var(--text-secondary)] text-base md:text-lg\">\n            Selecciona tu ruta y requerimiento t\303\251cnico para obtener una estimaci\303\263n de kilometraje, configuraci\303\263n vehicular sugerida y enlace directo a despacho.\n          </p>\n        </div>\n\n        <div class=\"grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch\">\n          \n          <!-- Formulario de Selecci\303\263n del Cotizador -->\n          <div class=\"lg:col-span-7 app-card p-6 md:p-8 reveal\">\n            <h3 class=\"font-display font-bold text-xl text-[var(--text-primary)] mb-6\">\n              1. Par\303\241metros de la Operaci\303\263n\n            </h3>\n\n            <div class=\"grid grid-cols-1 sm:grid-cols-2 gap-5 mb-5\">\n              \n              <div>\n                <label for=\"calc-origin\" class=\"block text-xs font-bold uppercase tracking-wider text-[var(--text-muted)] mb-2\">\n                  Origen de la Carga:\n                </label>\n                <select id=\"calc-origin\" class=\"w-full px-4 py-3 rounded-xl border border-[var(--border-main)] bg-[var(--bg-surface)] text-[var(--text-primary)] text-sm font-medium focus:ring-2 focus:ring-red-500 focus:outline-none\">\n                  <option value=\"lago-agrio\" selected>Lago Agrio (Sucumb\303\255os - Base Matriz)</option>\n                  <option value=\"quito\">Quito (Pichincha)</option>\n                  <option value=\"guayaquil\">Guayaquil (Guayas - Puerto)</option>\n                  <option value=\"cuenca\">Cuenca (Azuay)</option>\n                  <option value=\"coca\">El Coca (Orellana)</option>\n                  <option value=\"shushufindi\">Shushufindi (Sucumb\303\255os)</option>\n                  <option value=\"manta\">Manta (Manab\303\255)</option>\n                </select>\n              </div>\n\n              <div>\n                <label for=\"calc-destination\" class=\"block text-xs font-bold uppercase tracking-wider text-[var(--text-muted)] mb-2\">\n                  Destino de la Carga:\n                </label>\n                <select id=\"calc-destination\" class=\"w-full px-4 py-3 rounded-xl border border-[var(--border-main)] bg-[var(--bg-surface)] text-[var(--text-primary)] text-sm font-medium focus:ring-2 focus:ring-red-500 focus:outline-none\">\n                  <option value=\"quito\" selected>Quito (Pichincha)</option>\n                  <option value=\"lago-agrio\">Lago Agrio (Sucumb\303\255os)</option>\n                  <option value=\"guayaquil\">Guayaquil (Guayas - Puerto)</option>\n                  <option value=\"coca\">El Coca (Orellana)</option>\n                  <option value=\"shushufindi\">Shushufindi (Sucumb\303\255os)</option>\n                  <option value=\"cuenca\">Cuenca (Azuay)</option>\n                  <option value=\"manta\">Manta (Manab\303\255)</option>\n                </select>\n              </div>\n\n            </div>\n\n            <div class=\"grid grid-cols-1 sm:grid-cols-2 gap-5 mb-6\">\n              \n              <div>\n                <label for=\"calc-service\" class=\"block text-xs font-bold uppercase tracking-wider text-[var(--text-muted)] mb-2\">\n                  Tipo de Servicio Especializado:\n                </label>\n                <select id=\"calc-service\" class=\"w-full px-4 py-3 rounded-xl border border-[var(--border-main)] bg-[var(--bg-surface)] text-[var(--text-primary)] text-sm font-medium focus:ring-2 focus:ring-red-500 focus:outline-none\">\n                  <option value=\"fluidos\" selected>Transporte de Fluidos Vacuum</option>\n                  <option value=\"pesada\">Carga Pesada / Movilizaci\303\263n de RIGs</option>\n                  <option value=\"izaje\">Izaje y Montaje Industrial con Gr\303\272a</option>\n                  <option value=\"contenedores\">Contenedores Secos / Refrigerados</option>\n                </select>\n              </div>\n\n              <div>\n                <label for=\"calc-weight\" class=\"block text-xs font-bold uppercase tracking-wider text-[var(--text-muted)] mb-2\">\n                  Peso o Volumen Estimado:\n                </label>\n                <input id=\"calc-weight\" type=\"number\" min=\"1\" max=\"500\" value=\"30\" class=\"w-full px-4 py-3 rounded-xl border border-[var(--border-main)] bg-[var(--bg-surface)] text-[var(--text-primary)] text-sm font-medium focus:ring-2 focus:ring-red-500 focus:outline-none\" placeholder=\"Ej. 30\" />\n                <span class=\"text-[11px] text-[var(--text-muted)] mt-1 block\">Especificar en Toneladas o Barriles (bbl).</span>\n              </div>\n\n            </div>\n\n            <div class=\"p-4 rounded-xl bg-[var(--bg-secondary)] border border-[var(--border-main)] text-xs text-[var(--text-secondary)]\">\n              <span class=\"font-bold text-[var(--text-primary)] block mb-1\">Nota Operativa:</span>\n              <span>Para cargas sobredimensionadas con ancho superior a 3.20m o peso mayor a 45 toneladas, coordinamos el tr\303\241mite de permisos MTOP y veh\303\255culos escolta.</span>\n            </div>\n\n          </div>\n\n          <!-- Panel de Resultados del Cotizador -->\n          <div class=\"lg:col-span-5 app-card p-6 md:p-8 flex flex-col justify-between border-2 border-red-500/30 reveal\" data-delay=\"100\">\n            <div>\n              <div class=\"flex items-center justify-between mb-4\">\n                <span class=\"text-xs font-bold text-red-600 uppercase tracking-wider\">2. Resumen T\303\251cnico Estimado</span>\n                <span class=\"text-xs px-2 py-0.5 rounded bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300 font-bold\">C\303\241lculo Inmediato</span>\n              </div>\n\n              <div class=\"grid grid-cols-2 gap-4 py-4 border-y border-[var(--border-main)] mb-5\">\n                <div>\n                  <span class=\"block text-xs text-[var(--text-muted)]\">Distancia Estimada:</span>\n                  <span id=\"calc-result-dist\" class=\"font-display font-black text-2xl text-[var(--text-primary)]\">278 km</span>\n                </div>\n                <div>\n                  <span class=\"block text-xs text-[var(--text-muted)]\">Tiempo en Ruta Aprox:</span>\n                  <span id=\"calc-result-time\" class=\"font-display font-black text-2xl text-[var(--text-primary)]\">6.5 h</span>\n                </div>\n              </div>\n\n              <div class=\"mb-5\">\n                <span class=\"block text-xs text-[var(--text-muted)] mb-1\">Equipo Sugerido:</span>\n                <div id=\"calc-result-unit\" class=\"font-display font-bold text-base text-red-600\">\n                  Tanquero Vacuum 150-200 bbl\n                </div>\n              </div>\n\n              <div class=\"mb-6\">\n                <span class=\"block text-xs text-[var(--text-muted)] mb-1\">Itinerario y V\303\255a Recomendada:</span>\n                <div id=\"calc-route-desc\" class=\"text-xs text-[var(--text-secondary)] leading-relaxed bg-[var(--bg-secondary)] p-3 rounded-lg border border-[var(--border-main)]\">\n                  Ruta Papallacta - Baeza - Lago Agrio (V\303\255a E20/E45)\n                </div>\n              </div>\n            </div>\n\n            <!-- Botones de Acci\303\263n de Cotizaci\303\263n -->\n            <div class=\"space-y-3 pt-2\">\n              <a id=\"calc-whatsapp-btn\" href=\"#\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"magnetic-btn w-full py-3.5 px-6 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-display font-bold text-sm text-center transition-all flex items-center justify-center gap-2 shadow-lg shadow-emerald-600/25\">\n                <svg class=\"w-5 h-5 fill-current\" viewBox=\"0 0 24 24\">\n                  <path d=\"M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.664-.698c.99.582 1.954.919 2.802.919h.005c3.18 0 5.767-2.587 5.768-5.766 0-3.18-2.586-5.766-5.779-5.766zm9.969 5.768c0 5.518-4.482 10-10 10-1.748 0-3.418-.46-4.887-1.309l-7.113 1.869 1.895-6.932c-.932-1.523-1.442-3.29-1.442-5.128 0-5.518 4.482-10 10-10s10 4.482 10 10z\"/>\n                </svg>\n                <span>Enviar Cotizaci\303\263n por WhatsApp</span>\n              </a>\n\n              <a href=\"#contacto\" class=\"w-full py-3 px-6 rounded-xl bg-[var(--bg-tertiary)] hover:bg-[var(--border-main)] text-[var(--text-primary)] font-display font-bold text-xs text-center transition-colors block\">\n                Solicitar Propuesta Formal por Correo\n              </a>\n            </div>\n\n          </div>\n\n        </div>\n\n      </div>\n    </section>\n\n    <!-- =====================================================================\n         SECCI\303\223N: PREGUNTAS FRECUENTES (FAQ INTERACTIVO)\n         ===================================================================== -->\n    <section id=\"faq\" class=\"py-24 bg-[var(--bg-secondary)] border-y border-[var(--border-main)]\">\n      <div class=\"max-w-4xl mx-auto px-6 md:px-12\">\n        \n        <div class=\"text-center mb-14 reveal\">\n          <div class=\"inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-red-100 text-red-700 dark:bg-red-950 dark:text-red-300 text-xs font-bold uppercase tracking-wider mb-3\">\n            Resoluci\303\263n de Dudas T\303\251cnicas\n          </div>\n          <h2 class=\"font-display text-3xl sm:text-4xl md:text-5xl font-extrabold text-[var(--text-primary)] mb-4\">\n            Preguntas Frecuentes de Clientes\n          </h2>\n          <p class=\"text-[var(--text-secondary)] text-base\">\n            Informaci\303\263n clave sobre protocolos de seguridad, seguros de carga y tiempos de respuesta.\n          </p>\n        </div>\n\n        <div class=\"space-y-4 reveal\">\n          \n          <!-- Pregunta 1 -->\n          <div class=\"faq-item open\">\n            <button type=\"button\" class=\"faq-header focus:outline-none\">\n              <span>\302\277Qu\303\251 permisos especiales gestiona CONEXPET para transporte extrapesado?</span>\n              <svg class=\"w-5 h-5 faq-icon flex-shrink-0 ml-3\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n                <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M19 9l-7 7-7-7\"></path>\n              </svg>\n            </button>\n            <div class=\"faq-body\">\n              Gestionamos de manera integral los salvoconductos y autorizaciones del Ministerio de Transporte y Obras P\303\272blicas (MTOP) para cargas que superan las dimensiones y pesos est\303\241ndar reglamentarios, incluyendo la coordinaci\303\263n de veh\303\255culos escolta privados y apoyo policial cuando la ruta lo requiera.\n            </div>\n          </div>\n\n          <!-- Pregunta 2 -->\n          <div class=\"faq-item\">\n            <button type=\"button\" class=\"faq-header focus:outline-none\">\n              <span>\302\277Qu\303\251 p\303\263lizas de seguro respaldan las operaciones y la carga transportada?</span>\n              <svg class=\"w-5 h-5 faq-icon flex-shrink-0 ml-3\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n                <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M19 9l-7 7-7-7\"></path>\n              </svg>\n            </button>\n            <div class=\"faq-body\">\n              Todas nuestras unidades operan bajo p\303\263lizas de responsabilidad civil extracontractual y seguros de transporte de carga con cobertura ante accidentes, volcamiento, robo o da\303\261o ambiental de hasta $500.000 USD por evento, ampliables seg\303\272n el valor comercial del equipo del cliente.\n            </div>\n          </div>\n\n          <!-- Pregunta 3 -->\n          <div class=\"faq-item\">\n            <button type=\"button\" class=\"faq-header focus:outline-none\">\n              <span>\302\277Cu\303\241l es el tiempo de respuesta ante una emergencia en pozo petrolero?</span>\n              <svg class=\"w-5 h-5 faq-icon flex-shrink-0 ml-3\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n                <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M19 9l-7 7-7-7\"></path>\n              </svg>\n            </button>\n            <div class=\"faq-body\">\n              Gracias a nuestra base operativa central y talleres ubicados en Lago Agrio (Km 4.5), mantenemos tanqueros vacuum y cabezales en guardia permanente con capacidad de despacho a locaci\303\263n en menos de 45 minutos para el distrito amaz\303\263nico.\n            </div>\n          </div>\n\n          <!-- Pregunta 4 -->\n          <div class=\"faq-item\">\n            <button type=\"button\" class=\"faq-header focus:outline-none\">\n              <span>\302\277Qu\303\251 certificaciones tienen sus operadores de gr\303\272a y conductores?</span>\n              <svg class=\"w-5 h-5 faq-icon flex-shrink-0 ml-3\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n                <path stroke-linecap=\"round\" stroke-linejoin=\"round\" stroke-width=\"2\" d=\"M19 9l-7 7-7-7\"></path>\n              </svg>\n            </button>\n            <div class=\"faq-body\">\n              Nuestros operadores de gr\303\272as e izaje cuentan con certificaciones vigentes emitidas bajo normas OSHA / ASME B30.5. Los conductores poseen licencias profesionales tipo E especiales con certificaci\303\263n HazMat para materiales peligrosos y cursos actualizados de manejo defensivo en carreteras de monta\303\261a.\n            </div>\n          </div>\n\n        </div>\n\n      </div>\n    </section>\n\n    <!-- =====================================================================\n         SECCI\303\223N: CANAL \303\211TICO & CUMPLIMIENTO CORPORATIVO\n         ===================================================================== -->\n    <section class=\"py-16 bg-[var(--bg-main)]\">\n      <div class=\"max-w-5xl mx-auto px-6 md:px-12\">\n        <div class=\"p-8 rounded-2xl bg-gradient-to-r from-red-600 to-red-800 text-white flex flex-col md:flex-row items-center justify-between gap-6 shadow-xl\">\n          <div>\n            <div class=\"inline-block px-3 py-1 rounded bg-white/20 text-white text-xs font-bold uppercase tracking-wider mb-2\">\n              L\303\255nea de Integridad\n            </div>\n            <h3 class=\"font-display font-extrabold text-2xl sm:text-3xl mb-2\">\n              Canal de Denuncias & \303\211tica Empresarial\n            </h3>\n            <p class=\"text-white/90 text-sm max-w-xl\">\n              Garantizamos confidencialidad absoluta y pol\303\255tica de cero represalias para colaboradores, clientes y proveedores que deseen reportar cualquier conducta irregular.\n            </p>\n          </div>\n          <a href=\"https://triboilgas.typeform.com/to/W432lF\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"magnetic-btn px-6 py-3.5 rounded-xl bg-white text-red-700 hover:bg-zinc-100 font-display font-bold text-sm whitespace-nowrap transition-all shadow-md\">\n            Hacer un Reporte Seguro &rarr;\n          </a>\n        </div>\n      </div>\n    </section>\n\n    <!-- =====================================================================\n         SECCI\303\223N: CONTACTO & BASES F\303\215SICAS\n         ===================================================================== -->\n    <section id=\"contacto\" class=\"py-24 bg-[var(--bg-secondary)] border-t border-[var(--border-main)]\">\n      <div class=\"max-w-7xl mx-auto px-6 md:px-12\">\n        \n        <div class=\"grid grid-cols-1 lg:grid-cols-12 gap-12\">\n          \n          <!-- Informaci\303\263n y Direcciones de Bases -->\n          <div class=\"lg:col-span-5 reveal\">\n            <div class=\"inline-flex items-center gap-2 px-3 py-1 rounded-full bg-red-100 text-red-700 dark:bg-red-950 dark:text-red-300 text-xs font-bold uppercase tracking-wider mb-3\">\n              Atenci\303\263n Inmediata\n            </div>\n            <h2 class=\"font-display text-3xl sm:text-4xl md:text-5xl font-extrabold text-[var(--text-primary)] leading-tight mb-6\">\n              Comun\303\255cate con Despacho de Operaciones\n            </h2>\n            <p class=\"text-[var(--text-secondary)] text-sm sm:text-base leading-relaxed mb-8\">\n              Nuestro equipo de ingenier\303\255a y log\303\255stica est\303\241 disponible los 365 d\303\255as del a\303\261o para estructurar tu plan de transporte o cotizar operaciones complejas en cualquier punto del Ecuador.\n            </p>\n\n            <!-- Base Lago Agrio -->\n            <div class=\"app-card p-5 mb-4 border-l-4 border-l-red-600\">\n              <span class=\"text-xs font-bold text-red-600 uppercase tracking-wider block mb-1\">Base Central & Talleres (Amazon\303\255a)</span>\n              <h4 class=\"font-display font-bold text-base text-[var(--text-primary)] mb-1\">Lago Agrio, Sucumb\303\255os</h4>\n              <p class=\"text-xs text-[var(--text-secondary)] mb-2\">V\303\255a Quito Km 4 1/2, margen izquierdo, Sector Industrial.</p>\n              <div class=\"text-xs text-[var(--text-muted)] font-medium\">Atenci\303\263n de patio: 24 Horas / 7 D\303\255as</div>\n            </div>\n\n            <!-- Oficinas Quito -->\n            <div class=\"app-card p-5 mb-6\">\n              <span class=\"text-xs font-bold text-red-600 uppercase tracking-wider block mb-1\">Oficina Administrativa & Comercial</span>\n              <h4 class=\"font-display font-bold text-base text-[var(--text-primary)] mb-1\">Quito, Pichincha</h4>\n              <p class=\"text-xs text-[var(--text-secondary)] mb-2\">Av. Rep\303\272blica de El Salvador y Mosc\303\272, Edificio Prisma Business.</p>\n              <div class=\"text-xs text-[var(--text-muted)] font-medium\">Horario de oficina: Lunes a Viernes 08:30 - 17:30</div>\n            </div>\n\n            <!-- Tel\303\251fonos Directos -->\n            <div class=\"space-y-2 text-sm text-[var(--text-secondary)]\">\n              <div class=\"flex items-center gap-3\">\n                <span class=\"font-bold text-[var(--text-primary)]\">Tel\303\251fono Directo:</span>\n                <a href=\"tel:+593999008114\" class=\"text-red-600 font-bold hover:underline\">+593 99 900 8114</a>\n              </div>\n              <div class=\"flex items-center gap-3\">\n                <span class=\"font-bold text-[var(--text-primary)]\">Correo Operativo:</span>\n                <a href=\"mailto:operaciones@conexpet.com\" class=\"text-red-600 font-bold hover:underline\">operaciones@conexpet.com</a>\n              </div>\n            </div>\n          </div>\n\n          <!-- Formulario de Contacto Directo -->\n          <div class=\"lg:col-span-7 app-card p-8 md:p-10 reveal\" data-delay=\"100\">\n            <h3 class=\"font-display font-bold text-2xl text-[var(--text-primary)] mb-2\">\n              Env\303\255anos un Requerimiento Formal\n            </h3>\n            <p class=\"text-xs text-[var(--text-muted)] mb-6\">\n              Completa los datos y un ingeniero de operaciones responder\303\241 en menos de 2 horas.\n            </p>\n\n            <form id=\"quote-form\" class=\"space-y-4\">\n              <div class=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n                <div>\n                  <label for=\"contact-name\" class=\"block text-xs font-bold uppercase tracking-wider text-[var(--text-muted)] mb-1.5\">Nombre Completo:</label>\n                  <input id=\"contact-name\" type=\"text\" required class=\"w-full px-4 py-3 rounded-xl border border-[var(--border-main)] bg-[var(--bg-surface)] text-[var(--text-primary)] text-sm focus:ring-2 focus:ring-red-500 focus:outline-none\" placeholder=\"Ing. Juan P\303\251rez\" />\n                </div>\n                <div>\n                  <label for=\"contact-company\" class=\"block text-xs font-bold uppercase tracking-wider text-[var(--text-muted)] mb-1.5\">Empresa u Operadora:</label>\n                  <input id=\"contact-company\" type=\"text\" required class=\"w-full px-4 py-3 rounded-xl border border-[var(--border-main)] bg-[var(--bg-surface)] text-[var(--text-primary)] text-sm focus:ring-2 focus:ring-red-500 focus:outline-none\" placeholder=\"Petroecuador / Operadora\" />\n                </div>\n              </div>\n\n              <div class=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n                <div>\n                  <label for=\"contact-email\" class=\"block text-xs font-bold uppercase tracking-wider text-[var(--text-muted)] mb-1.5\">Correo Corporativo:</label>\n                  <input id=\"contact-email\" type=\"email\" required class=\"w-full px-4 py-3 rounded-xl border border-[var(--border-main)] bg-[var(--bg-surface)] text-[var(--text-primary)] text-sm focus:ring-2 focus:ring-red-500 focus:outline-none\" placeholder=\"jperez@empresa.com\" />\n                </div>\n                <div>\n                  <label for=\"contact-phone\" class=\"block text-xs font-bold uppercase tracking-wider text-[var(--text-muted)] mb-1.5\">Tel\303\251fono / Celular:</label>\n                  <input id=\"contact-phone\" type=\"tel\" required class=\"w-full px-4 py-3 rounded-xl border border-[var(--border-main)] bg-[var(--bg-surface)] text-[var(--text-primary)] text-sm focus:ring-2 focus:ring-red-500 focus:outline-none\" placeholder=\"+593 99 999 9999\" />\n                </div>\n              </div>\n\n              <div>\n                <label for=\"contact-service\" class=\"block text-xs font-bold uppercase tracking-wider text-[var(--text-muted)] mb-1.5\">Servicio Requerido:</label>\n                <select id=\"contact-service\" class=\"w-full px-4 py-3 rounded-xl border border-[var(--border-main)] bg-[var(--bg-surface)] text-[var(--text-primary)] text-sm focus:ring-2 focus:ring-red-500 focus:outline-none\">\n                  <option value=\"fluidos\">Transporte de Fluidos Vacuum (150-200 bbl)</option>\n                  <option value=\"pesada\">Carga Pesada / Desmovilizaci\303\263n de Taladros (RIGs)</option>\n                  <option value=\"izaje\">Izaje y Montaje con Gr\303\272as (Hasta 120 Tn)</option>\n                  <option value=\"talleres\">Servicios de Taller y Mec\303\241nica Pesada</option>\n                  <option value=\"otro\">Otro Requerimiento Espec\303\255fico</option>\n                </select>\n              </div>\n\n              <div>\n                <label for=\"contact-message\" class=\"block text-xs font-bold uppercase tracking-wider text-[var(--text-muted)] mb-1.5\">Detalles de la Carga, Ruta y Fechas:</label>\n                <textarea id=\"contact-message\" rows=\"4\" required class=\"w-full px-4 py-3 rounded-xl border border-[var(--border-main)] bg-[var(--bg-surface)] text-[var(--text-primary)] text-sm focus:ring-2 focus:ring-red-500 focus:outline-none\" placeholder=\"Indicar origen, destino, volumen aproximado, requerimientos de izaje o particularidades...\"></textarea>\n              </div>\n\n              <button type=\"submit\" class=\"magnetic-btn w-full py-4 px-8 rounded-xl bg-red-600 hover:bg-red-700 text-white font-display font-bold text-sm tracking-wide transition-all shadow-lg shadow-red-600/25\">\n                Enviar Requerimiento Operativo\n              </button>\n            </form>\n\n            <div id=\"quote-feedback\" class=\"hidden mt-4 p-4 rounded-xl bg-emerald-50 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800 text-sm font-medium text-center\">\n              &check; Requerimiento recibido con \303\251xito. Un despachador de CONEXPET te contactar\303\241 a la brevedad.\n            </div>\n          </div>\n\n        </div>\n\n      </div>\n    </section>\n\n    <!-- =====================================================================\n         FOOTER CORPORATIVO OFICIAL\n         ===================================================================== -->\n    <footer class=\"py-16 bg-[var(--bg-main)] border-t border-[var(--border-main)] text-sm text-[var(--text-muted)]\">\n      <div class=\"max-w-7xl mx-auto px-6 md:px-12\">\n        \n        <div class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10 mb-12\">\n          \n          <!-- Identidad y RUC -->\n          <div class=\"lg:col-span-2\">\n            <img src=\"img/logo.png\" alt=\"CONEXPET TRANSPORTE S.A.\" class=\"h-10 w-auto mb-4 object-contain brand-logo-img\" />\n            <p class=\"text-xs text-[var(--text-secondary)] leading-relaxed mb-4 max-w-sm\">\n              CONEXPET TRANSPORTE S.A. es una empresa ecuatoriana constituida para el transporte de carga pesada, fluidos petroleros e izaje industrial con cobertura en las 24 provincias del Ecuador.\n            </p>\n            <div class=\"text-xs font-semibold text-[var(--text-primary)]\">\n              RUC: 2191717468001 \302\267 Certificaciones ISO 9001 / 14001 / 45001\n            </div>\n          </div>\n\n          <!-- Servicios -->\n          <div>\n            <h5 class=\"font-display font-bold text-sm text-[var(--text-primary)] mb-3\">Servicios</h5>\n            <ul class=\"space-y-2 text-xs\">\n              <li><a href=\"#servicios\" class=\"hover:text-red-600 transition-colors\">Fluidos Vacuum 200 bbl</a></li>\n              <li><a href=\"#servicios\" class=\"hover:text-red-600 transition-colors\">Movilizaci\303\263n de RIGs</a></li>\n              <li><a href=\"#servicios\" class=\"hover:text-red-600 transition-colors\">Izaje con Gr\303\272as 120 Tn</a></li>\n              <li><a href=\"#servicios\" class=\"hover:text-red-600 transition-colors\">Cama Bajas y Lowboys</a></li>\n              <li><a href=\"#servicios\" class=\"hover:text-red-600 transition-colors\">Talleres Especializados</a></li>\n            </ul>\n          </div>\n\n          <!-- Accesos Intranet -->\n          <div>\n            <h5 class=\"font-display font-bold text-sm text-[var(--text-primary)] mb-3\">Intranet & Portales</h5>\n            <ul class=\"space-y-2 text-xs\">\n              <li><a href=\"#intranet\" class=\"hover:text-red-600 transition-colors\">Tarjeta Cero (HSE)</a></li>\n              <li><a href=\"http://64.190.27.46:8040\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"hover:text-red-600 transition-colors\">ERP JD Edwards</a></li>\n              <li><a href=\"https://compers.triboilgas.com\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"hover:text-red-600 transition-colors\">Compers TTHH</a></li>\n              <li><a href=\"https://soporte.triboilgas.com\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"hover:text-red-600 transition-colors\">Mesa de Ayuda Hesk</a></li>\n              <li><a href=\"https://triboilgas.typeform.com/to/W432lF\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"hover:text-red-600 transition-colors\">Canal de Denuncias</a></li>\n            </ul>\n          </div>\n\n          <!-- Enlaces R\303\241pidos -->\n          <div>\n            <h5 class=\"font-display font-bold text-sm text-[var(--text-primary)] mb-3\">Contacto R\303\241pido</h5>\n            <ul class=\"space-y-2 text-xs\">\n              <li><span>Lago Agrio: Km 4.5 V\303\255a Quito</span></li>\n              <li><span>Quito: Av. Rep. de El Salvador</span></li>\n              <li><a href=\"tel:+593999008114\" class=\"text-red-600 font-bold hover:underline\">+593 99 900 8114</a></li>\n              <li><a href=\"mailto:operaciones@conexpet.com\" class=\"hover:text-red-600 transition-colors\">operaciones@conexpet.com</a></li>\n            </ul>\n          </div>\n\n        </div>\n\n        <div class=\"pt-8 border-t border-[var(--border-main)] flex flex-col sm:flex-row items-center justify-between text-xs text-[var(--text-muted)] gap-4\">\n          <div>\n            &copy; 2026 CONEXPET TRANSPORTE S.A. Todos los derechos reservados. Miembro del Grupo Triboilgas.\n          </div>\n          <div class=\"flex items-center gap-4\">\n            <a href=\"#empresa\" class=\"hover:text-red-600 transition-colors\">Pol\303\255tica de Privacidad</a>\n            <span>&bull;</span>\n            <a href=\"#empresa\" class=\"hover:text-red-600 transition-colors\">T\303\251rminos del Servicio</a>\n            <span>&bull;</span>\n            <a href=\"#hero\" class=\"text-red-600 font-bold hover:underline\">Volver Arriba &uarr;</a>\n          </div>\n        </div>\n\n      </div>\n    </footer>\n\n    <!-- =====================================================================\n         MODAL INTERACTIVO DE FICHA T\303\211CNICA\n         ===================================================================== -->\n    <div id=\"spec-modal\" class=\"modal-overlay\" aria-hidden=\"true\" role=\"dialog\" aria-modal=\"true\">\n      <div class=\"modal-container p-6 md:p-8 relative\">\n        <button id=\"spec-modal-close\" type=\"button\" class=\"absolute top-5 right-5 w-8 h-8 rounded-full border border-[var(--border-main)] bg-[var(--bg-tertiary)] text-[var(--text-primary)] flex items-center justify-center hover:border-red-500 transition-colors focus:outline-none\" aria-label=\"Cerrar ventana\">\n          &times;\n        </button>\n        \n        <div class=\"mb-4\">\n          <span id=\"spec-modal-badge\" class=\"inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-red-100 text-red-700 dark:bg-red-950 dark:text-red-300 mb-2\">\n            Especificaci\303\263n T\303\251cnica\n          </span>\n          <h3 id=\"spec-modal-title\" class=\"font-display font-extrabold text-2xl text-[var(--text-primary)]\">\n            T\303\255tulo del Servicio\n          </h3>\n        </div>\n\n        <div id=\"spec-modal-content\" class=\"py-2\">\n          <!-- Se inyecta din\303\241micamente v\303\255a script.js -->\n        </div>\n\n        <div class=\"mt-6 pt-4 border-t border-[var(--border-main)] flex items-center justify-between\">\n          <a href=\"#cotizador\" class=\"px-5 py-2.5 rounded-lg bg-red-600 hover:bg-red-700 text-white font-display font-bold text-xs transition-colors\">\n            Cotizar Este Servicio\n          </a>\n          <a href=\"https://wa.me/593999008114\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"text-xs font-semibold text-emerald-600 hover:underline\">\n            Consultar con Ingeniero por WhatsApp &rarr;\n          </a>\n        </div>\n      </div>\n    </div>\n\n    <!-- =====================================================================\n         BOT\303\223N FLOTANTE DE WHATSAPP CON BADGE 24/7\n         ===================================================================== -->\n    <a id=\"whatsapp-btn\" href=\"https://wa.me/593999008114?text=Hola%20CONEXPET,%20solicito%20atenci%C3%B3n%20para%20un%20servicio%20de%20transporte.\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"whatsapp-btn\" aria-label=\"Contactar por WhatsApp\">\n      <svg class=\"w-7 h-7 fill-current\" viewBox=\"0 0 24 24\">\n        <path d=\"M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.664-.698c.99.582 1.954.919 2.802.919h.005c3.18 0 5.767-2.587 5.768-5.766 0-3.18-2.586-5.766-5.779-5.766zm9.969 5.768c0 5.518-4.482 10-10 10-1.748 0-3.418-.46-4.887-1.309l-7.113 1.869 1.895-6.932c-.932-1.523-1.442-3.29-1.442-5.128 0-5.518 4.482-10 10-10s10 4.482 10 10z\"/>\n      </svg>\n    </a>\n\n  </body>\n</html>\n"
    }
