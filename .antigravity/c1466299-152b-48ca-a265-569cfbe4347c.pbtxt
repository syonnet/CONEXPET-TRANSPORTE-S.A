        }
        lines {
          text: "  window.addEventListener(\'scroll\', handleScroll, { passive: true });"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  handleScroll();"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
