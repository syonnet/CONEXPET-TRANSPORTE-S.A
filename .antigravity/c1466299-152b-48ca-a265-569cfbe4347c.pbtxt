  file_change {
    absolute_path_uri: "file:///script.js"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "/**\n * CONEXPET TRANSPORTE - SCRIPT PRINCIPAL\n * Experiencia cinematogr\303\241fica interactiva inspirada en Apple.com\n */\n\ndocument.addEventListener(\'DOMContentLoaded\', () => {\n  // =========================================================================\n  // 1. PRELOADER CON ANIMACI\303\223N NUM\303\211RICA Y REVEAL STAGGER\n  // =========================================================================\n  const preloader = document.getElementById(\'preloader\');\n  const preloaderBar = document.getElementById(\'preloader-progress-bar\');\n  const preloaderCounter = document.getElementById(\'preloader-counter\');\n\n  let loadProgress = 0;\n  const preloaderDuration = 2400; // ~2.4 segundos\n  const startTime = performance.now();\n\n  function updatePreloader(now) {\n    const elapsed = now - startTime;\n    const rawProgress = Math.min(elapsed / preloaderDuration, 1);\n    // Easing suave\n    loadProgress = Math.floor(rawProgress * 100);\n\n    if (preloaderBar) preloaderBar.style.width = `${loadProgress}%`;\n    if (preloaderCounter) preloaderCounter.textContent = `${loadProgress}`;\n\n    if (rawProgress < 1) {\n      requestAnimationFrame(updatePreloader);\n    } else {\n      setTimeout(() => {\n        if (preloader) {\n          preloader.classList.add(\'fade-out\');\n        }\n        // Iniciar animaciones de hero tras fade out\n        triggerHeroReveal();\n      }, 200);\n    }\n  }\n\n  requestAnimationFrame(updatePreloader);\n\n  // Revelar Hero con stagger al terminar preloader\n  function triggerHeroReveal() {\n    const heroReveals = document.querySelectorAll(\'#hero .reveal\');\n    heroReveals.forEach((el, index) => {\n      const delay = (index + 1) * 120;\n      setTimeout(() => {\n        el.classList.add(\'active\');\n      }, delay);\n    });\n    // Iniciar m\303\241quina de escribir\n    initTypewriter();\n  }\n\n  // =========================================================================\n  // 2. NAVEGACI\303\223N & SCROLL LISTENER (Fixed Blur & Scroll Progress)\n  // =========================================================================\n  const mainNav = document.getElementById(\'main-nav\');\n  const scrollProgressBar = document.getElementById(\'scroll-progress-bar\');\n  const mobileMenuToggle = document.getElementById(\'mobile-menu-toggle\');\n  const mobileMenuOverlay = document.getElementById(\'mobile-menu\');\n  const mobileLinks = document.querySelectorAll(\'.mobile-nav-link\');\n\n  let lastScrollY = window.scrollY;\n\n  function handleScroll() {\n    const scrollY = window.scrollY;\n    const docHeight = document.documentElement.scrollHeight - window.innerHeight;\n    const progress = docHeight > 0 ? (scrollY / docHeight) * 100 : 0;\n\n    // Barra de progreso vertical\n    if (scrollProgressBar) {\n      scrollProgressBar.style.height = `${Math.min(progress, 100)}%`;\n    }\n\n    // Nav background blur\n    if (mainNav) {\n      if (scrollY > 60) {\n        mainNav.classList.add(\'bg-[#0A0A0A]/85\', \'backdrop-blur-xl\', \'border-b\', \'border-white/[0.06]\', \'py-4\');\n        mainNav.classList.remove(\'py-6\', \'border-transparent\');\n      } else {\n        mainNav.classList.remove(\'bg-[#0A0A0A]/85\', \'backdrop-blur-xl\', \'border-b\', \'border-white/[0.06]\', \'py-4\');\n        mainNav.classList.add(\'py-6\', \'border-transparent\');\n      }\n    }\n\n    // Parallax sutil en formas geom\303\251tricas\n    updateParallax(scrollY);\n\n    lastScrollY = scrollY;\n  }\n\n  window.addEventListener(\'scroll\', handleScroll, { passive: true });\n  handleScroll();\n\n  // Men\303\272 Mobile\n  if (mobileMenuToggle && mobileMenuOverlay) {\n    const hamburgerIcon = document.getElementById(\'hamburger-icon\');\n    const closeIcon = document.getElementById(\'close-icon\');\n\n    mobileMenuToggle.addEventListener(\'click\', () => {\n      const isOpen = !mobileMenuOverlay.classList.contains(\'hidden\');\n      if (isOpen) {\n        mobileMenuOverlay.classList.add(\'hidden\');\n        document.body.style.overflow = \'\';\n        if (hamburgerIcon) hamburgerIcon.classList.remove(\'hidden\');\n        if (closeIcon) closeIcon.classList.add(\'hidden\');\n      } else {\n        mobileMenuOverlay.classList.remove(\'hidden\');\n        document.body.style.overflow = \'hidden\';\n        if (hamburgerIcon) hamburgerIcon.classList.add(\'hidden\');\n        if (closeIcon) closeIcon.classList.remove(\'hidden\');\n      }\n    });\n\n    mobileLinks.forEach(link => {\n      link.addEventListener(\'click\', () => {\n        mobileMenuOverlay.classList.add(\'hidden\');\n        document.body.style.overflow = \'\';\n        if (hamburgerIcon) hamburgerIcon.classList.remove(\'hidden\');\n        if (closeIcon) closeIcon.classList.add(\'hidden\');\n      });\n    });\n  }\n\n  // =========================================================================\n  // 3. FIGURAS GEOM\303\211TRICAS DE FONDO & MORPHING POR SECCI\303\223N\n  // =========================================================================\n  const bgContainer = document.getElementById(\'bg-geometric-container\');\n  const sectionFlash = document.getElementById(\'section-flash\');\n  const sections = [\n    { id: \'hero\', index: 0 },\n    { id: \'nosotros\', index: 1 },\n    { id: \'servicios\', index: 2 },\n    { id: \'cobertura\', index: 3 },\n    { id: \'flota\', index: 4 },\n    { id: \'estadisticas\', index: 5 },\n    { id: \'contacto\', index: 6 },\n    { id: \'footer\', index: 6 }\n  ];\n\n  let currentSectionIdx = -1;\n\n  function triggerSectionFlash() {\n    if (!sectionFlash) return;\n    sectionFlash.classList.add(\'active\');\n    setTimeout(() => {\n      sectionFlash.classList.remove(\'active\');\n    }, 300);\n  }\n\n  function setupSectionObserver() {\n    const observerOptions = {\n      root: null,\n      rootMargin: \'-30% 0px -30% 0px\',\n      threshold: 0\n    };\n\n    const sectionObserver = new IntersectionObserver((entries) => {\n      entries.forEach(entry => {\n        if (entry.isIntersecting) {\n          const targetId = entry.target.id;\n          const match = sections.find(s => s.id === targetId);\n          if (match && match.index !== currentSectionIdx) {\n            currentSectionIdx = match.index;\n            if (bgContainer) {\n              bgContainer.setAttribute(\'data-section\', currentSectionIdx.toString());\n            }\n            triggerSectionFlash();\n          }\n        }\n      });\n    }, observerOptions);\n\n    sections.forEach(s => {\n      const el = document.getElementById(s.id);\n      if (el) sectionObserver.observe(el);\n    });\n  }\n\n  setupSectionObserver();\n\n  // Parallax suave en cada forma usando custom property CSS\n  const shape1 = document.querySelector(\'.shape-circle-1\');\n  const shape2 = document.querySelector(\'.shape-circle-2\');\n  const shape3 = document.querySelector(\'.shape-diamond-1\');\n  const shape4 = document.querySelector(\'.shape-hex-1\');\n  const shape5 = document.querySelector(\'.shape-tri-1\');\n\n  function updateParallax(scrollY) {\n    if (window.innerWidth < 768) return; // Desactivar en mobile para rendimiento\n    if (shape1) shape1.style.marginTop = `${scrollY * 0.04}px`;\n    if (shape2) shape2.style.marginBottom = `${scrollY * 0.03}px`;\n    if (shape3) shape3.style.marginTop = `${scrollY * 0.02}px`;\n    if (shape4) shape4.style.marginTop = `${scrollY * -0.025}px`;\n    if (shape5) shape5.style.marginBottom = `${scrollY * -0.03}px`;\n  }\n\n  // =========================================================================\n  // 4. SCROLL REVEAL (IntersectionObserver)\n  // =========================================================================\n  const revealElements = document.querySelectorAll(\'.reveal\');\n\n  const revealObserver = new IntersectionObserver((entries, obs) => {\n    entries.forEach(entry => {\n      if (entry.isIntersecting) {\n        const el = entry.target;\n        // Si pertenece al hero, lo maneja triggerHeroReveal al inicio\n        if (el.closest(\'#hero\')) {\n          obs.unobserve(el);\n          return;\n        }\n\n        const delay = parseInt(el.getAttribute(\'data-delay\') || \'0\', 10);\n        setTimeout(() => {\n          el.classList.add(\'active\');\n        }, delay);\n\n        obs.unobserve(el);\n      }\n    });\n  }, {\n    threshold: 0.15,\n    rootMargin: \'0px 0px -50px 0px\'\n  });\n\n  revealElements.forEach(el => {\n    if (!el.closest(\'#hero\')) {\n      revealObserver.observe(el);\n    }\n  });\n\n  // =========================================================================\n  // 5. CONTADORES NUM\303\211RICOS ANIMADOS (Ease-Out C\303\272bico 2s)\n  // =========================================================================\n  const counterElements = document.querySelectorAll(\'[data-target]\');\n\n  function animateCounter(el) {\n    const target = parseFloat(el.getAttribute(\'data-target\') || \'0\');\n    const prefix = el.getAttribute(\'data-prefix\') || \'\';\n    const suffix = el.getAttribute(\'data-suffix\') || \'\';\n    const duration = 2000; // 2 segundos\n    const startTime = performance.now();\n\n    function step(now) {\n      const elapsed = now - startTime;\n      const progress = Math.min(elapsed / duration, 1);\n      // Ease-out c\303\272bico: 1 - Math.pow(1 - progress, 3)\n      const easeVal = 1 - Math.pow(1 - progress, 3);\n      const currentVal = Math.floor(easeVal * target);\n\n      el.textContent = `${prefix}${currentVal.toLocaleString(\'es-EC\')}${suffix}`;\n\n      if (progress < 1) {\n        requestAnimationFrame(step);\n      } else {\n        el.textContent = `${prefix}${target.toLocaleString(\'es-EC\')}${suffix}`;\n      }\n    }\n\n    requestAnimationFrame(step);\n  }\n\n  const counterObserver = new IntersectionObserver((entries, obs) => {\n    entries.forEach(entry => {\n      if (entry.isIntersecting) {\n        animateCounter(entry.target);\n        obs.unobserve(entry.target);\n      }\n    });\n  }, { threshold: 0.2 });\n\n  counterElements.forEach(el => counterObserver.observe(el));\n\n  // =========================================================================\n  // 6. TYPEWRITER EFFECT EN EL EYEBROW DEL HERO\n  // =========================================================================\n  function initTypewriter() {\n    const typewriterEl = document.getElementById(\'hero-typewriter-text\');\n    if (!typewriterEl) return;\n\n    const phrases = [\n      \'Confiabilidad en cada kil\303\263metro\',\n      \'Tecnolog\303\255a GPS en tiempo real\',\n      \'Cobertura en 24 provincias\'\n    ];\n\n    let phraseIndex = 0;\n    let charIndex = 0;\n    let isDeleting = false;\n    let typingSpeed = 50;\n\n    function typeLoop() {\n      const currentPhrase = phrases[phraseIndex];\n\n      if (isDeleting) {\n        typewriterEl.textContent = currentPhrase.substring(0, charIndex - 1);\n        charIndex--;\n        typingSpeed = 30;\n      } else {\n        typewriterEl.textContent = currentPhrase.substring(0, charIndex + 1);\n        charIndex++;\n        typingSpeed = 60;\n      }\n\n      if (!isDeleting && charIndex === currentPhrase.length) {\n        // Pausa al terminar la frase\n        typingSpeed = 2200;\n        isDeleting = true;\n      } else if (isDeleting && charIndex === 0) {\n        isDeleting = false;\n        phraseIndex = (phraseIndex + 1) % phrases.length;\n        typingSpeed = 400;\n      }\n\n      setTimeout(typeLoop, typingSpeed);\n    }\n\n    typeLoop();\n  }\n\n  // =========================================================================\n  // 7. CUSTOM CURSOR EN DESKTOP\n  // =========================================================================\n  const isFinePointer = window.matchMedia(\'(pointer: fine)\').matches;\n\n  if (isFinePointer) {\n    const dot = document.querySelector(\'.cursor-dot\');\n    const ring = document.querySelector(\'.cursor-ring\');\n\n    if (dot && ring) {\n      let mouseX = window.innerWidth / 2;\n      let mouseY = window.innerHeight / 2;\n      let dotX = mouseX;\n      let dotY = mouseY;\n      let ringX = mouseX;\n      let ringY = mouseY;\n      let isVisible = false;\n\n      window.addEventListener(\'mousemove\', (e) => {\n        mouseX = e.clientX;\n        mouseY = e.clientY;\n        if (!isVisible) {\n          dot.style.opacity = \'1\';\n          ring.style.opacity = \'1\';\n          isVisible = true;\n        }\n      });\n\n      window.addEventListener(\'mouseleave\', () => {\n        dot.style.opacity = \'0\';\n        ring.style.opacity = \'0\';\n        isVisible = false;\n      });\n\n      function renderCursor() {\n        // Lerp para suavizado\n        dotX += (mouseX - dotX) * 0.55;\n        dotY += (mouseY - dotY) * 0.55;\n        ringX += (mouseX - ringX) * 0.18;\n        ringY += (mouseY - ringY) * 0.18;\n\n        dot.style.transform = `translate(${dotX}px, ${dotY}px)`;\n        ring.style.transform = `translate(${ringX}px, ${ringY}px)`;\n\n        requestAnimationFrame(renderCursor);\n      }\n\n      requestAnimationFrame(renderCursor);\n\n      // Expandir cursor al pasar sobre interactivos\n      const interactiveElements = document.querySelectorAll(\'a, button, input, select, textarea, .service-card, .fleet-item, .radar-point\');\n      interactiveElements.forEach(el => {\n        el.addEventListener(\'mouseenter\', () => ring.classList.add(\'cursor-hover\'));\n        el.addEventListener(\'mouseleave\', () => ring.classList.remove(\'cursor-hover\'));\n      });\n    }\n  }\n\n  // =========================================================================\n  // 8. MAGNETIC EFFECT EN BOTONES PRINCIPALES\n  // =========================================================================\n  const magneticBtns = document.querySelectorAll(\'.magnetic-btn\');\n\n  if (isFinePointer) {\n    magneticBtns.forEach(btn => {\n      btn.addEventListener(\'mousemove\', (e) => {\n        const rect = btn.getBoundingClientRect();\n        const btnCenterX = rect.left + rect.width / 2;\n        const btnCenterY = rect.top + rect.height / 2;\n        const deltaX = (e.clientX - btnCenterX) * 0.28;\n        const deltaY = (e.clientY - btnCenterY) * 0.28;\n\n        btn.style.transform = `translate(${deltaX}px, ${deltaY}px)`;\n      });\n\n      btn.addEventListener(\'mouseleave\', () => {\n        btn.style.transform = \'translate(0px, 0px)\';\n      });\n    });\n  }\n\n  // =========================================================================\n  // 9. BOT\303\223N FLOTANTE DE WHATSAPP (Aparece a los 3 segundos)\n  // =========================================================================\n  const whatsappBtn = document.getElementById(\'whatsapp-btn\');\n  if (whatsappBtn) {\n    setTimeout(() => {\n      whatsappBtn.classList.add(\'visible\');\n    }, 3000);\n  }\n\n  // =========================================================================\n  // 10. FORMULARIO DE COTIZACI\303\223N INTERACTIVO\n  // =========================================================================\n  const quoteForm = document.getElementById(\'quote-form\');\n  const quoteFeedback = document.getElementById(\'quote-feedback\');\n\n  if (quoteForm) {\n    quoteForm.addEventListener(\'submit\', (e) => {\n      e.preventDefault();\n\n      const submitBtn = quoteForm.querySelector(\'button[type=\"submit\"]\');\n      const originalText = submitBtn ? submitBtn.innerHTML : \'\';\n\n      if (submitBtn) {\n        submitBtn.disabled = true;\n        submitBtn.innerHTML = `\n          <svg class=\"animate-spin -ml-1 mr-3 h-5 w-5 text-white inline-block\" xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\">\n            <circle class=\"opacity-25\" cx=\"12\" cy=\"12\" r=\"10\" stroke=\"currentColor\" stroke-width=\"4\"></circle>\n            <path class=\"opacity-75\" fill=\"currentColor\" d=\"M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z\"></path>\n          </svg>\n          Procesando solicitud...\n        `;\n      }\n\n      // Simulaci\303\263n de env\303\255o con confirmaci\303\263n profesional\n      setTimeout(() => {\n        if (submitBtn) {\n          submitBtn.disabled = false;\n          submitBtn.innerHTML = originalText;\n        }\n\n        quoteForm.reset();\n\n        if (quoteFeedback) {\n          quoteFeedback.classList.remove(\'hidden\');\n          quoteFeedback.scrollIntoView({ behavior: \'smooth\', block: \'nearest\' });\n\n          setTimeout(() => {\n            quoteFeedback.classList.add(\'hidden\');\n          }, 8000);\n        }\n      }, 1200);\n    });\n  }\n\n  // =========================================================================\n  // 11. TOOLTIPS DE CIUDADES EN EL RADAR DE COBERTURA\n  // =========================================================================\n  const radarPoints = document.querySelectorAll(\'.radar-point\');\n  radarPoints.forEach(point => {\n    point.addEventListener(\'mouseenter\', () => {\n      const city = point.getAttribute(\'data-city\');\n      const info = point.getAttribute(\'data-info\');\n      const tooltip = document.getElementById(\'radar-city-tooltip\');\n      if (tooltip) {\n        tooltip.innerHTML = `<span class=\"text-white font-semibold\">${city}:</span> <span class=\"text-zinc-400\">${info}</span>`;\n        tooltip.classList.remove(\'opacity-0\');\n        tooltip.classList.add(\'opacity-100\');\n      }\n    });\n\n    point.addEventListener(\'mouseleave\', () => {\n      const tooltip = document.getElementById(\'radar-city-tooltip\');\n      if (tooltip) {\n        tooltip.classList.remove(\'opacity-100\');\n        tooltip.classList.add(\'opacity-0\');\n      }\n    });\n  });\n});\n"
    }
