          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          <h2 class=\"font-display text-3xl sm:text-4xl md:text-5xl font-extrabold text-[var(--text-primary)] mb-4\">"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            Preguntas Frecuentes de Clientes"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          </h2>"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          <p class=\"text-[var(--text-secondary)] text-base\">"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            Informaci\303\263n clave sobre protocolos de seguridad, seguros de carga y tiempos de respuesta."
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          </p>"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        </div>"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
