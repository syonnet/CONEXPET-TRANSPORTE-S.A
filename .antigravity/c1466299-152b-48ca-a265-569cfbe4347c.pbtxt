        }
        lines {
          text: "    const progress = docHeight > 0 ? (scrollY / docHeight) * 100 : 0;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    // Barra de progreso vertical"
